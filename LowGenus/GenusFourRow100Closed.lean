module

public import LowGenus.GenusFourRow097Closed
public import LowGenus.GenusFiveConfigurations

@[expose] public section

/-!
# Closed-orthant existence on genus-four Core 100 (the triangular prism)

Row `100` of the genus-four cubic atlas is the triangular prism: two disjoint
triangles joined by a perfect matching.  This file proves `BNExists _ 1 3` by an
explicit pencil and three ramp scripts, run over `Utilities.Certificate.DegenerateSpec.DegSpec`, whose slot lengths may
vanish, so the conclusion covers the whole closed orthant: every subdivision of
the prism *and* every equal-genus contraction of one.

The headline `row100_closed` is the closed-orthant obligation of
`LowGenus.GenusFourRowsClosed` for this row, and is the proof
`AtanasovRanganathan.GenusFourRowsClosed.rowClosedCoverage` consumes.  The
generated certificate `LowGenus/Generated/G4Row100.lean` proves the same
statement (`AtanasovRanganathan.GenusFourGeneratedRows.row100_closed`) and is
kept as an independent check.

## The pencil

In the split core

```text
e0 0-3   e1 0-4   e2 0-5   e3 1-2   e4 1-4
e5 1-5   e6 2-3   e7 2-5   e8 3-4
```

the triangles are `{0, 3, 4}` and `{1, 2, 5}`, and the matching slots are
`m₀ = e2` (`0-5`), `m₁ = e6` (`3-2`) and `m₂ = e4` (`4-1`).  In the chamber
where `m₁` is a shortest matching slot, write `a = ℓ₂ - ℓ₆`.  The pencil is

```text
D = (the point at distance a from 0 along e2) + 3 + 4 ,
```

and it is moved onto the six core classes by three ramps:

* the **matching march** (`α`), across the cut `{e2, e4, e6}`, pushing the
  three chips into the second triangle; at full length `ℓ₆` it puts chips on
  `5` and `2`;
* the **star march at `0`** (`β`), pulling the three chips of `D` into `0`;
* the **star march at `1`** (`γ`), run after the full matching march, pulling
  its three chips into `1`.

The vertices `3` and `4` carry chips of `D` itself.

## What changes on the closed orthant

Nothing in the argument.  As in `LowGenus.GenusFourRow097Closed`, from which
the generic helpers are reused:

* every divisor identity is one instance of `DegSpec.prin_ramp_eq`, written as
  a sum of `one_chip (d.pathAt e k)` differences, with `pathAt` clamping `k` to
  the slot, so no position bound is ever carried;
* each ramp's class invariance is free from `RampData.of_reachIn`, because the
  representative map of `faceSpec` is generated by the vanishing slots;
* a zero-length window (`ℓ₆ = 0`, say) makes the corresponding march the zero
  script, and the identities still hold because `pathAt e 0` and
  `pathAt e (length e)` are then the same class.

The order-three rotation of the prism moves an arbitrary length vector into the
chamber `ℓ₆ ≤ ℓ₂, ℓ₆ ≤ ℓ₄`, transported by `ClosedCoreSymmetry.bnExists_iff`.

No Boolean check over lengths, no generated data, and no length chamber
decomposition beyond the symmetry orbit occurs anywhere below.
-/

namespace AtanasovRanganathan.GenusFourRow100Closed

open Utilities

open Utilities.Certificate.DegenerateSpec
open Utilities.Certificate
open Utilities.Certificate.ClosedFaceCensus
open Utilities.Certificate.ClosedCoreSymmetry
open Utilities.Certificate.ContractionForestCensusGeneral
open AtanasovRanganathan.Configurations
open LowGenus.GenusFourRow097Closed (sum_univ_nine forall_fin_nine forall_fin_six
  bnExists_of_reaches_coreVertices RepGen chip_three)

/-! ## The oriented prism core -/

/-- The orientation data of the row-100 split core, read on the core.  Slots
`0, 1, 2` leave the first triangle vertex `0`; slots `3, 4, 5` leave the second
triangle vertex `1`. -/
structure IsPrismCore (core : ExplicitPotential.Core 6 9) : Prop where
  t0 : core.tail 0 = 0
  t1 : core.tail 1 = 0
  t2 : core.tail 2 = 0
  t3 : core.tail 3 = 1
  t4 : core.tail 4 = 1
  t5 : core.tail 5 = 1
  t6 : core.tail 6 = 2
  t7 : core.tail 7 = 2
  t8 : core.tail 8 = 3
  h0 : core.head 0 = 3
  h1 : core.head 1 = 4
  h2 : core.head 2 = 5
  h3 : core.head 3 = 2
  h4 : core.head 4 = 4
  h5 : core.head 5 = 5
  h6 : core.head 6 = 3
  h7 : core.head 7 = 5
  h8 : core.head 8 = 4

/-! ## The pencil parameters

Every parameter is a function of the length vector alone. -/

section Parameters

variable (L : Fin 9 → ℕ)

/-- `μ₀ - μ₁`: the depth of the moving chip on the matching slot `e2`. -/
def aOff : ℕ := L 2 - L 6

/-- Length of the star march at `0`. -/
def dBeta : ℕ := min (L 0) (min (L 1) (aOff L))

/-- Length of the star march at `1`. -/
def dGamma : ℕ := min (L 3) (min (L 5) (L 4 - L 6))

end Parameters

/-! ## The three marches

Potentials, slopes and window starts are written as vector literals, so every
slot value is a `simp` evaluation. -/

section Marches

variable (L : Fin 9 → ℕ)

/-- Core potential of the matching march: `-t` on the second triangle. -/
def alphaPot (t : ℕ) : Fin 6 → ℤ := ![0, -(t : ℤ), -(t : ℤ), 0, 0, -(t : ℤ)]

/-- Slot signs of the matching march. -/
def alphaSgn : Fin 9 → ℤ := ![0, 0, -1, 0, 1, 0, 1, 0, 0]

/-- Window starts of the matching march. -/
def alphaLo (t : ℕ) : Fin 9 → ℕ := ![0, 0, aOff L, 0, L 4 - t, 0, L 6 - t, 0, 0]

/-- Core potential of the star march at `0`. -/
def betaPot (s : ℕ) : Fin 6 → ℤ := ![-(s : ℤ), 0, 0, 0, 0, 0]

/-- Slot signs of the star march at `0`. -/
def betaSgn : Fin 9 → ℤ := ![1, 1, 1, 0, 0, 0, 0, 0, 0]

/-- Window starts of the star march at `0`. -/
def betaLo (s : ℕ) : Fin 9 → ℕ := ![L 0 - s, L 1 - s, aOff L - s, 0, 0, 0, 0, 0, 0]

/-- Core potential of the star march at `1`. -/
def gammaPot (s : ℕ) : Fin 6 → ℤ := ![0, -(s : ℤ), 0, 0, 0, 0]

/-- Slot signs of the star march at `1`. -/
def gammaSgn : Fin 9 → ℤ := ![0, 0, 0, 1, 1, 1, 0, 0, 0]

/-- Window starts of the star march at `1`, run after the full matching
march, which has left the chip of `e4` at depth `ℓ₄ - ℓ₆`. -/
def gammaLo (s : ℕ) : Fin 9 → ℕ :=
  ![0, 0, 0, L 3 - s, L 4 - L 6 - s, L 5 - s, 0, 0, 0]

end Marches

/-! ## The ramps -/

section Ramps

variable {d : DegSpec 6 9}

theorem alphaRamp (hp : IsPrismCore d.core) (hrep : RepGen d) {t : ℕ}
    (hba : d.length 6 ≤ d.length 2) (ht4 : t ≤ d.length 4)
    (ht6 : t ≤ d.length 6) :
    DegSpec.RampData d (alphaPot t) alphaSgn (alphaLo d.length t) t := by
  refine DegSpec.RampData.of_reachIn ?_ ?_ hrep
  · refine forall_fin_nine ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ <;>
      simp [alphaPot, alphaSgn, hp.t0, hp.t1, hp.t2, hp.t3, hp.t4, hp.t5,
        hp.t6, hp.t7, hp.t8, hp.h0, hp.h1, hp.h2, hp.h3, hp.h4, hp.h5, hp.h6,
        hp.h7, hp.h8]
  · refine forall_fin_nine ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ <;>
      simp [alphaSgn, alphaLo, aOff] <;> omega

theorem betaRamp (hp : IsPrismCore d.core) (hrep : RepGen d) {s : ℕ}
    (hs0 : s ≤ d.length 0) (hs1 : s ≤ d.length 1) (hsa : s ≤ aOff d.length) :
    DegSpec.RampData d (betaPot s) betaSgn (betaLo d.length s) s := by
  refine DegSpec.RampData.of_reachIn ?_ ?_ hrep
  · refine forall_fin_nine ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ <;>
      simp [betaPot, betaSgn, hp.t0, hp.t1, hp.t2, hp.t3, hp.t4, hp.t5,
        hp.t6, hp.t7, hp.t8, hp.h0, hp.h1, hp.h2, hp.h3, hp.h4, hp.h5, hp.h6,
        hp.h7, hp.h8]
  · refine forall_fin_nine ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ <;>
      simp [betaSgn, betaLo] <;> simp only [aOff] at hsa ⊢ <;> omega

theorem gammaRamp (hp : IsPrismCore d.core) (hrep : RepGen d) {s : ℕ}
    (hs3 : s ≤ d.length 3) (hs4 : s ≤ d.length 4 - d.length 6)
    (hs5 : s ≤ d.length 5) :
    DegSpec.RampData d (gammaPot s) gammaSgn (gammaLo d.length s) s := by
  refine DegSpec.RampData.of_reachIn ?_ ?_ hrep
  · refine forall_fin_nine ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ <;>
      simp [gammaPot, gammaSgn, hp.t0, hp.t1, hp.t2, hp.t3, hp.t4, hp.t5,
        hp.t6, hp.t7, hp.t8, hp.h0, hp.h1, hp.h2, hp.h3, hp.h4, hp.h5, hp.h6,
        hp.h7, hp.h8]
  · refine forall_fin_nine ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ <;>
      simp [gammaSgn, gammaLo] <;> omega

/-- The matching march. -/
def alphaScript (d : DegSpec 6 9) (t : ℕ) : firing_script d.graph :=
  d.rampScript (alphaPot t) alphaSgn (alphaLo d.length t) t

/-- The star march at `0`. -/
def betaScript (d : DegSpec 6 9) (s : ℕ) : firing_script d.graph :=
  d.rampScript (betaPot s) betaSgn (betaLo d.length s) s

/-- The star march at `1`. -/
def gammaScript (d : DegSpec 6 9) (s : ℕ) : firing_script d.graph :=
  d.rampScript (gammaPot s) gammaSgn (gammaLo d.length s) s

end Ramps

/-! ## Divisor identities for the three marches

Each is one instantiation of the generic `DegSpec.prin_ramp_eq`, expanded over
the nine slots. -/

section RampEq

variable {d : DegSpec 6 9}

theorem prin_alpha_eq {t : ℕ}
    (h : DegSpec.RampData d (alphaPot t) alphaSgn (alphaLo d.length t) t)
    (ht4 : t ≤ d.length 4) (ht6 : t ≤ d.length 6) :
    prin d.graph (alphaScript d t) =
      (one_chip (G := d.graph) (d.pathAt 2 (aOff d.length + t)) -
          one_chip (d.pathAt 2 (aOff d.length))) +
        (one_chip (d.pathAt 4 (d.length 4 - t)) -
          one_chip (d.pathAt 4 (d.length 4))) +
        (one_chip (d.pathAt 6 (d.length 6 - t)) -
          one_chip (d.pathAt 6 (d.length 6))) := by
  have e4 : d.pathAt 4 (d.length 4 - t + t) = d.pathAt 4 (d.length 4) :=
    d.pathAt_of_eq 4 (by omega)
  have e6 : d.pathAt 6 (d.length 6 - t + t) = d.pathAt 6 (d.length 6) :=
    d.pathAt_of_eq 6 (by omega)
  rw [alphaScript, DegSpec.prin_ramp_eq h, sum_univ_nine]
  simp only [alphaSgn, alphaLo, Matrix.cons_val, e4, e6, zero_smul, one_smul,
    neg_smul]
  abel

theorem prin_beta_eq {s : ℕ}
    (h : DegSpec.RampData d (betaPot s) betaSgn (betaLo d.length s) s)
    (hs0 : s ≤ d.length 0) (hs1 : s ≤ d.length 1) (hsa : s ≤ aOff d.length) :
    prin d.graph (betaScript d s) =
      (one_chip (G := d.graph) (d.pathAt 0 (d.length 0 - s)) -
          one_chip (d.pathAt 0 (d.length 0))) +
        (one_chip (d.pathAt 1 (d.length 1 - s)) -
          one_chip (d.pathAt 1 (d.length 1))) +
        (one_chip (d.pathAt 2 (aOff d.length - s)) -
          one_chip (d.pathAt 2 (aOff d.length))) := by
  have e0 : d.pathAt 0 (d.length 0 - s + s) = d.pathAt 0 (d.length 0) :=
    d.pathAt_of_eq 0 (by omega)
  have e1 : d.pathAt 1 (d.length 1 - s + s) = d.pathAt 1 (d.length 1) :=
    d.pathAt_of_eq 1 (by omega)
  have e2 : d.pathAt 2 (aOff d.length - s + s) = d.pathAt 2 (aOff d.length) :=
    d.pathAt_of_eq 2 (by omega)
  rw [betaScript, DegSpec.prin_ramp_eq h, sum_univ_nine]
  simp only [betaSgn, betaLo, Matrix.cons_val, e0, e1, e2, zero_smul, one_smul]
  abel

theorem prin_gamma_eq {s : ℕ}
    (h : DegSpec.RampData d (gammaPot s) gammaSgn (gammaLo d.length s) s)
    (hs3 : s ≤ d.length 3) (hs4 : s ≤ d.length 4 - d.length 6)
    (hs5 : s ≤ d.length 5) :
    prin d.graph (gammaScript d s) =
      (one_chip (G := d.graph) (d.pathAt 3 (d.length 3 - s)) -
          one_chip (d.pathAt 3 (d.length 3))) +
        (one_chip (d.pathAt 4 (d.length 4 - d.length 6 - s)) -
          one_chip (d.pathAt 4 (d.length 4 - d.length 6))) +
        (one_chip (d.pathAt 5 (d.length 5 - s)) -
          one_chip (d.pathAt 5 (d.length 5))) := by
  have e3 : d.pathAt 3 (d.length 3 - s + s) = d.pathAt 3 (d.length 3) :=
    d.pathAt_of_eq 3 (by omega)
  have e4 : d.pathAt 4 (d.length 4 - d.length 6 - s + s) =
      d.pathAt 4 (d.length 4 - d.length 6) :=
    d.pathAt_of_eq 4 (by omega)
  have e5 : d.pathAt 5 (d.length 5 - s + s) = d.pathAt 5 (d.length 5) :=
    d.pathAt_of_eq 5 (by omega)
  rw [gammaScript, DegSpec.prin_ramp_eq h, sum_univ_nine]
  simp only [gammaSgn, gammaLo, Matrix.cons_val, e3, e4, e5, zero_smul,
    one_smul]
  abel

end RampEq

/-! ## Bridging core classes and path positions -/

section Bridge

variable {d : DegSpec 6 9}

theorem cvT (e : Fin 9) {v : Fin 6} (hv : d.core.tail e = v) :
    d.pathAt e 0 = d.coreVertex v := by
  rw [d.pathAt_zero, hv]

theorem cvH (e : Fin 9) {v : Fin 6} (hv : d.core.head e = v) :
    d.pathAt e (d.length e) = d.coreVertex v := by
  rw [d.pathAt_length (le_refl _), hv]

end Bridge

/-! ## The pencil and the states it passes through -/

section States

/-- The degree-three pencil of row 100. -/
def pen (d : DegSpec 6 9) : CFDiv d.graph :=
  one_chip (d.pathAt 2 (aOff d.length)) + one_chip (d.coreVertex 3) +
    one_chip (d.coreVertex 4)

variable {d : DegSpec 6 9}

theorem deg_pen : deg (pen d) = 3 := by
  unfold pen
  rw [deg.map_add, deg.map_add, deg_one_chip, deg_one_chip, deg_one_chip]
  norm_num

/-- After a matching march of length `t`, the three chips sit at depth `a + t`
on `e2`, `ℓ₄ - t` on `e4` and `ℓ₆ - t` on `e6`. -/
theorem state_alpha (hp : IsPrismCore d.core) (hrep : RepGen d) {t : ℕ}
    (hba : d.length 6 ≤ d.length 2) (ht4 : t ≤ d.length 4)
    (ht6 : t ≤ d.length 6) :
    pen d + prin d.graph (alphaScript d t) =
      one_chip (G := d.graph) (d.pathAt 2 (aOff d.length + t)) +
        one_chip (d.pathAt 4 (d.length 4 - t)) +
        one_chip (d.pathAt 6 (d.length 6 - t)) := by
  rw [pen, prin_alpha_eq (alphaRamp hp hrep hba ht4 ht6) ht4 ht6, cvH 4 hp.h4,
    cvH 6 hp.h6]
  abel

/-- After a star march of length `s` at `0`, the three chips sit at depth
`ℓ₀ - s`, `ℓ₁ - s` and `a - s` on the three slots at `0`. -/
theorem state_beta (hp : IsPrismCore d.core) (hrep : RepGen d) {s : ℕ}
    (hs0 : s ≤ d.length 0) (hs1 : s ≤ d.length 1) (hsa : s ≤ aOff d.length) :
    pen d + prin d.graph (betaScript d s) =
      one_chip (G := d.graph) (d.pathAt 0 (d.length 0 - s)) +
        one_chip (d.pathAt 1 (d.length 1 - s)) +
        one_chip (d.pathAt 2 (aOff d.length - s)) := by
  rw [pen, prin_beta_eq (betaRamp hp hrep hs0 hs1 hsa) hs0 hs1 hsa, cvH 0 hp.h0,
    cvH 1 hp.h1]
  abel

/-- After the full matching march and a star march of length `s` at `1`, the
three chips sit at depth `ℓ₃ - s`, `ℓ₄ - ℓ₆ - s` and `ℓ₅ - s` on the three
slots at `1`. -/
theorem state_gamma (hp : IsPrismCore d.core) (hrep : RepGen d)
    (hba : d.length 6 ≤ d.length 2) (hbc : d.length 6 ≤ d.length 4) {s : ℕ}
    (hs3 : s ≤ d.length 3) (hs4 : s ≤ d.length 4 - d.length 6)
    (hs5 : s ≤ d.length 5) :
    pen d + prin d.graph (alphaScript d (d.length 6) + gammaScript d s) =
      one_chip (G := d.graph) (d.pathAt 3 (d.length 3 - s)) +
        one_chip (d.pathAt 4 (d.length 4 - d.length 6 - s)) +
        one_chip (d.pathAt 5 (d.length 5 - s)) := by
  have hA : d.pathAt 2 (aOff d.length + d.length 6) = d.pathAt 5 (d.length 5) := by
    rw [d.pathAt_of_eq 2 (show aOff d.length + d.length 6 = d.length 2 by
      simp only [aOff]; omega), cvH 2 hp.h2, cvH 5 hp.h5]
  have hB : d.pathAt 6 (d.length 6 - d.length 6) = d.pathAt 3 (d.length 3) := by
    rw [d.pathAt_of_eq 6 (Nat.sub_self _), cvT 6 hp.t6, cvH 3 hp.h3]
  rw [map_add, ← add_assoc, state_alpha hp hrep hba hbc le_rfl,
    prin_gamma_eq (gammaRamp hp hrep hs3 hs4 hs5) hs3 hs4 hs5, hA, hB]
  abel

end States

/-! ## Reaching every core class -/

section Assembly

variable {d : DegSpec 6 9}

theorem reaches_three (script : firing_script d.graph) (A B C : d.graph.V)
    (hst : pen d + prin d.graph script = one_chip A + one_chip B + one_chip C)
    (q : d.graph.V) (hq : q = A ∨ q = B ∨ q = C) :
    StrongSeparator.Reaches d.graph (pen d) q := by
  refine d.reaches_of_script (pen d) script q ?_ ?_
  · rw [hst]
    exact threeChipDivisor_effective A B C
  · rw [hst]
    exact chip_three A B C q hq

/-- At the end of the star march at `0` there is a chip at `0`. -/
theorem hub_zero (hp : IsPrismCore d.core) :
    d.coreVertex 0 = d.pathAt 0 (d.length 0 - dBeta d.length) ∨
      d.coreVertex 0 = d.pathAt 1 (d.length 1 - dBeta d.length) ∨
      d.coreVertex 0 = d.pathAt 2 (aOff d.length - dBeta d.length) := by
  have hcase : d.length 0 - dBeta d.length = 0 ∨
      d.length 1 - dBeta d.length = 0 ∨ aOff d.length - dBeta d.length = 0 := by
    simp only [dBeta]
    omega
  rcases hcase with hc | hc | hc
  · exact Or.inl (by rw [d.pathAt_of_eq 0 hc, cvT 0 hp.t0])
  · exact Or.inr (Or.inl (by rw [d.pathAt_of_eq 1 hc, cvT 1 hp.t1]))
  · exact Or.inr (Or.inr (by rw [d.pathAt_of_eq 2 hc, cvT 2 hp.t2]))

/-- At the end of the star march at `1` there is a chip at `1`. -/
theorem hub_one (hp : IsPrismCore d.core) :
    d.coreVertex 1 = d.pathAt 3 (d.length 3 - dGamma d.length) ∨
      d.coreVertex 1 = d.pathAt 4 (d.length 4 - d.length 6 - dGamma d.length) ∨
      d.coreVertex 1 = d.pathAt 5 (d.length 5 - dGamma d.length) := by
  have hcase : d.length 3 - dGamma d.length = 0 ∨
      d.length 4 - d.length 6 - dGamma d.length = 0 ∨
      d.length 5 - dGamma d.length = 0 := by
    simp only [dGamma]
    omega
  rcases hcase with hc | hc | hc
  · exact Or.inl (by rw [d.pathAt_of_eq 3 hc, cvT 3 hp.t3])
  · exact Or.inr (Or.inl (by rw [d.pathAt_of_eq 4 hc, cvT 4 hp.t4]))
  · exact Or.inr (Or.inr (by rw [d.pathAt_of_eq 5 hc, cvT 5 hp.t5]))

/-- **Every core class is reached**, in the chamber where `e6` is a shortest
matching slot. -/
theorem reaches_core (hp : IsPrismCore d.core) (hrep : RepGen d)
    (hba : d.length 6 ≤ d.length 2) (hbc : d.length 6 ≤ d.length 4)
    (v : Fin 6) :
    StrongSeparator.Reaches d.graph (pen d) (d.coreVertex v) := by
  have hB0 : dBeta d.length ≤ d.length 0 := by simp only [dBeta]; omega
  have hB1 : dBeta d.length ≤ d.length 1 := by simp only [dBeta]; omega
  have hBa : dBeta d.length ≤ aOff d.length := by simp only [dBeta]; omega
  have hG3 : dGamma d.length ≤ d.length 3 := by simp only [dGamma]; omega
  have hG4 : dGamma d.length ≤ d.length 4 - d.length 6 := by
    simp only [dGamma]; omega
  have hG5 : dGamma d.length ≤ d.length 5 := by simp only [dGamma]; omega
  revert v
  refine forall_fin_six ?_ ?_ ?_ ?_ ?_ ?_
  · -- the first triangle vertex `0`, by the star march at `0`
    exact reaches_three _ _ _ _ (state_beta hp hrep hB0 hB1 hBa) _ (hub_zero hp)
  · -- the far second-triangle vertex `1`, by the star march at `1`
    exact reaches_three _ _ _ _ (state_gamma hp hrep hba hbc hG3 hG4 hG5) _
      (hub_one hp)
  · -- the matched vertex `2`, at the far end of `e6`
    refine reaches_three _ _ _ _ (state_alpha hp hrep hba hbc le_rfl) _
      (Or.inr (Or.inr ?_))
    rw [d.pathAt_of_eq 6 (Nat.sub_self _), cvT 6 hp.t6]
  · -- `3`, carried by the pencil itself
    refine reaches_three 0 (d.pathAt 2 (aOff d.length)) (d.coreVertex 3)
      (d.coreVertex 4) ?_ _ (Or.inr (Or.inl rfl))
    rw [map_zero, add_zero, pen]
  · -- `4`, carried by the pencil itself
    refine reaches_three 0 (d.pathAt 2 (aOff d.length)) (d.coreVertex 3)
      (d.coreVertex 4) ?_ _ (Or.inr (Or.inr rfl))
    rw [map_zero, add_zero, pen]
  · -- the matched vertex `5`, at the far end of `e2`
    refine reaches_three _ _ _ _ (state_alpha hp hrep hba hbc le_rfl) _
      (Or.inl ?_)
    rw [d.pathAt_of_eq 2 (show aOff d.length + d.length 6 = d.length 2 by
      simp only [aOff]; omega), cvH 2 hp.h2]

/-- **Row 100 on the closed orthant, in the chamber `ℓ₆ ≤ ℓ₂`, `ℓ₆ ≤ ℓ₄`.** -/
theorem bnExists_one_three (hp : IsPrismCore d.core) (hconn : d.core.Connected)
    (hrep : RepGen d) (hba : d.length 6 ≤ d.length 2)
    (hbc : d.length 6 ≤ d.length 4) :
    BNExists d.graph 1 3 :=
  bnExists_of_reaches_coreVertices d hconn (pen d) 3 deg_pen
    (fun v => reaches_core hp hrep hba hbc v)

end Assembly

/-! ## The catalog row, on the closed orthant

An arbitrary length vector is moved into the chamber `ℓ₆ ≤ ℓ₂ ∧ ℓ₆ ≤ ℓ₄` by
the order-three rotation of the prism, transported along the contracted graphs
with `ClosedCoreSymmetry.bnExists_iff`. -/

section Row

open Utilities.Certificate.CoreOrbitReduction
open AtanasovRanganathan.GenusFourCubicAtlas

theorem isPrismCore_row100 : IsPrismCore row100Core := by constructor <;> decide

/-- The order-three rotation of the prism, on core vertices. -/
def rotVertex : Equiv.Perm (Fin 6) where
  toFun := ![3, 5, 1, 4, 0, 2]
  invFun := ![4, 2, 5, 0, 3, 1]
  left_inv := by decide
  right_inv := by decide

/-- The order-three rotation of the prism, on edge slots; it cycles the
matching slots `e2 → e6 → e4 → e2`. -/
def rotSlot : Equiv.Perm (Fin 9) where
  toFun := ![8, 0, 6, 5, 2, 7, 4, 3, 1]
  invFun := ![1, 8, 4, 7, 6, 3, 2, 5, 0]
  left_inv := by decide
  right_inv := by decide

/-- Reading directions of the rotated slots. -/
def rotReversed : Fin 9 → Bool :=
  ![false, true, true, true, true, true, false, false, true]

/-- The rotation, as a core symmetry. -/
def rot : CoreSymmetry row100Core where
  vertexPerm := rotVertex
  slotPerm := rotSlot
  reversed := rotReversed
  tail_eq := by decide
  head_eq := by decide

/-- The representative map of `faceSpec` is a `compFold` of the vanishing set,
so `RepGen` is free. -/
theorem repGen_censusSpec (ℓ : Fin 9 → ℕ)
    (hForest : IsForest row100Core (zeroSet ℓ))
    (hNotLoopy : ¬ IsLoopy row100Core (zeroSet ℓ)) :
    RepGen (censusSpec row100Core (by norm_num) ℓ hForest hNotLoopy) :=
  fun u v h => (compFold_iff row100Core (zeroSet ℓ) u v).mp h

/-- **`BNExists … 1 3` for atlas row `100`, on the whole closed length
orthant.**  Quantified over every length vector whose vanishing set is a
non-loopy forest: every subdivision of the triangular prism *and* every
equal-genus contraction of one.

The statement is that of
`AtanasovRanganathan.GenusFourGeneratedRows.row100_closed`, verbatim.  The three cases are the orbit of one
chamber under the rotation of the prism. -/
theorem row100_closed (length : Fin 9 → ℕ)
    (hForest : IsForest row100Core (zeroSlots length))
    (hNotLoopy : ¬ IsLoopy row100Core (zeroSlots length)) :
    BNExists (faceSpec row100Core (by norm_num) length hForest hNotLoopy).graph 1 3 := by
  rw [faceSpec_eq_censusSpec]
  have hr2 : (rot.slotPerm.symm : Fin 9 → Fin 9) 2 = 4 := by decide
  have hr4 : (rot.slotPerm.symm : Fin 9 → Fin 9) 4 = 6 := by decide
  have hr6 : (rot.slotPerm.symm : Fin 9 → Fin 9) 6 = 2 := by decide
  by_cases h6 : length 6 ≤ length 2 ∧ length 6 ≤ length 4
  · exact bnExists_one_three isPrismCore_row100 row100.connected
      (repGen_censusSpec length hForest hNotLoopy) h6.1 h6.2
  · by_cases h2 : length 2 ≤ length 4 ∧ length 2 ≤ length 6
    · refine (ClosedCoreSymmetry.bnExists_iff rot length (by norm_num) hForest
        hNotLoopy 1 3).mp ?_
      refine bnExists_one_three isPrismCore_row100 row100.connected
        (repGen_censusSpec _ _ _) ?_ ?_
      · show length ((rot.slotPerm.symm : Fin 9 → Fin 9) 6) ≤
          length ((rot.slotPerm.symm : Fin 9 → Fin 9) 2)
        rw [hr6, hr2]; exact h2.1
      · show length ((rot.slotPerm.symm : Fin 9 → Fin 9) 6) ≤
          length ((rot.slotPerm.symm : Fin 9 → Fin 9) 4)
        rw [hr6, hr4]; exact h2.2
    · have h4 : length 4 ≤ length 6 ∧ length 4 ≤ length 2 := by
        simp only [not_and_or, not_le] at h6 h2
        omega
      refine (ClosedCoreSymmetry.bnExists_iff rot length (by norm_num) hForest
        hNotLoopy 1 3).mp ?_
      refine (ClosedCoreSymmetry.bnExists_iff rot
        (ClosedCoreSymmetry.targetLength rot length) (by norm_num) _ _ 1 3).mp ?_
      refine bnExists_one_three isPrismCore_row100 row100.connected
        (repGen_censusSpec _ _ _) ?_ ?_
      · show length ((rot.slotPerm.symm : Fin 9 → Fin 9)
            ((rot.slotPerm.symm : Fin 9 → Fin 9) 6)) ≤
          length ((rot.slotPerm.symm : Fin 9 → Fin 9)
            ((rot.slotPerm.symm : Fin 9 → Fin 9) 2))
        rw [hr6, hr2, hr4]; exact h4.1
      · show length ((rot.slotPerm.symm : Fin 9 → Fin 9)
            ((rot.slotPerm.symm : Fin 9 → Fin 9) 6)) ≤
          length ((rot.slotPerm.symm : Fin 9 → Fin 9)
            ((rot.slotPerm.symm : Fin 9 → Fin 9) 4))
        rw [hr6, hr2, hr4, hr6]; exact h4.2

end Row

end AtanasovRanganathan.GenusFourRow100Closed
