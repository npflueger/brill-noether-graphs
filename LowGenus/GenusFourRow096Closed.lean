module

public import LowGenus.GenusFourRow097Closed
public import LowGenus.GenusFiveConfigurations
public import LowGenus.GenusFourRow096Pencil

@[expose] public section

/-!
# Closed-orthant existence on genus-four Core 096 (the necklace of three bananas)

Row `096` of the genus-four cubic atlas is the **necklace of three bananas**:
bananas `β₀ = {v0,v5}` (arcs `e1, e2`), `β₁ = {v1,v4}` (arcs `e4, e5`) and
`β₂ = {v2,v3}` (arcs `e6, e7`), joined in a cycle by the three single slots
`e0 : v0–v4`, `e3 : v1–v3` and `e8 : v2–v5`.  Write `aᵢ` for the length of
slot `eᵢ`.

`LowGenus.GenusFourRow096Pencil.bnExists_all` proves
`BNExists _ 1 3` on every **positive** subdivision, by two regimes of cut
marches.  This file runs the same two pencils and the same marches over
`Utilities.Certificate.DegenerateSpec.DegSpec`, whose slot lengths may vanish,
so the conclusion covers the whole closed orthant: every subdivision of the
necklace *and* every equal-genus contraction of one.

The headline `row096_closed` is the closed-orthant obligation of
`LowGenus.GenusFourRowsClosed` for this row, and is the proof
`AtanasovRanganathan.GenusFourRowsClosed.rowClosedCoverage` consumes.  The
generated certificate `LowGenus/Generated/G4Row096.lean` proves the same
statement (`AtanasovRanganathan.GenusFourGeneratedRows.row096_closed`) and is
kept as an independent check.

## Cut marches

Every move below is a **cut march**: for a set `S` of core vertices, the ramp
with potential `t` on `S` and `0` off it, whose slope on a slot is the
coboundary `[head ∈ S] - [tail ∈ S]`.  Its divisor (`DegSpec.prin_ramp_eq`)
moves one chip by `t` along each slot crossing the cut: forwards along a slot
leaving `S`, backwards along a slot entering it.  Five cuts occur:

```text
sideA = {v0,v5}            cut {e0, e8}
sideB = {v0,v2,v3,v5}      cut {e0, e3}
sideC = {v0,v1,v4,v5}      cut {e3, e8}
sideR = {v0,v2,v5}         cut {e0, e6, e7}   (the relay across β₂)
sideD = {v0,v1,v2,v3,v5}   cut {e0, e4, e5}   (the star of v4)
```

## The two pencils

In the chart where `e0` is a longest single slot (`a₃ ≤ a₀`, `a₈ ≤ a₀`):

* **Regime 1**, `a₀ ≤ a₃ + a₈`: `D = v0 + v5 + (e3 at depth a₀ - a₈)`.  The
  family "one chip on each single slot, at depths `j, k, m` from `v0, v1, v2`"
  is preserved by the two-slot cuts `A`, `B`, `C`.  The pencil is
  `T(0, a₀ - a₈, a₈)`; march `A` then `B` reaches `T(a₀, 0, 0)` (covering `v4`,
  `v1`, `v2`), and march `C` reaches `T(0, a₃, a₀ - a₃)` (covering `v3`).
* **Regime 2**, `a₃ + a₈ ≤ a₀` and (after the `e6/e7` arc swap) `a₇ ≤ a₆`:
  with `s = min (a₀ - a₃ - a₈) a₇`, `D = v0 + v5 + (e6 at depth a₆ - s)`.  The
  chain `A`, relay, `B` covers `v2`, `v3`, `v1`; for `v4`, either the chip on
  `e0` has already arrived, or `s = a₇` and a second `B` march followed by the
  star march at `v4` delivers a chip there.

## What changes on the closed orthant

Nothing in the argument, and nothing is split into face cases:

* every divisor identity is one instance of `DegSpec.prin_ramp_eq`, written as
  a sum of `one_chip (d.pathAt e k)` differences.  `pathAt` clamps `k` to the
  slot, so no position bound is carried;
* each march's class invariance (`RampData.repInv`) is free from
  `RampData.of_reachIn`, because the representative map of `faceSpec` is
  generated by the vanishing slots;
* every hypothesis `0 < t` of the open proof is gone: a march of length `0` is
  the zero script and its identity still holds, so the degenerate cases the
  open proof treats separately (`a₈ = a₀`, the triangle boundary
  `a₀ = a₃ + a₈`, and the arrival of the `e0` chip at `v4` before the star
  march) need no special treatment.  The two case splits left inside
  regime 2, on whether the `e0` chip has reached `v4` after the first and
  after the second march `B`, are the open proof's own and are about the
  lengths, not about which of them vanish.

The order-three rotation of the necklace moves a longest single slot to `e0`,
and the `e6/e7` arc swap makes `e6` the longer arc of `β₂`; both are
transported along the contracted graphs by `ClosedCoreSymmetry.bnExists_iff`.
-/

namespace AtanasovRanganathan.GenusFourRow096Closed

open Utilities

open Utilities.Certificate.DegenerateSpec
open Utilities.Certificate
open Utilities.Certificate.ClosedFaceCensus
open Utilities.Certificate.ClosedCoreSymmetry
open Utilities.Certificate.ContractionForestCensusGeneral
open AtanasovRanganathan.Configurations
open LowGenus.GenusFourRow097Closed (sum_univ_nine forall_fin_nine forall_fin_six
  bnExists_of_reaches_coreVertices RepGen chip_three)

/-! ## The oriented necklace core -/

/-- The orientation data of the row-096 split core, read on the core: bananas
`β₀ = {v0,v5}` on `e1, e2`, `β₁ = {v1,v4}` on `e4, e5`, `β₂ = {v2,v3}` on
`e6, e7`, and singles `e0 : v0–v4`, `e3 : v1–v3`, `e8 : v2–v5`. -/
structure IsNecklaceCore (core : ExplicitPotential.Core 6 9) : Prop where
  t0 : core.tail 0 = 0
  t1 : core.tail 1 = 0
  t2 : core.tail 2 = 0
  t3 : core.tail 3 = 1
  t4 : core.tail 4 = 1
  t5 : core.tail 5 = 1
  t6 : core.tail 6 = 2
  t7 : core.tail 7 = 2
  t8 : core.tail 8 = 2
  h0 : core.head 0 = 4
  h1 : core.head 1 = 5
  h2 : core.head 2 = 5
  h3 : core.head 3 = 3
  h4 : core.head 4 = 4
  h5 : core.head 5 = 4
  h6 : core.head 6 = 3
  h7 : core.head 7 = 3
  h8 : core.head 8 = 5

/-! ## Cut marches -/

section Cut

/-- The potential of a cut march: height `t` on the side `S`, `0` off it. -/
def cutPot (S : Fin 6 → Bool) (t : ℕ) : Fin 6 → ℤ := fun v => if S v then (t : ℤ) else 0

/-- The slopes a cut potential forces: the coboundary of the side indicator. -/
def cutSgn (core : ExplicitPotential.Core 6 9) (S : Fin 6 → Bool) : Fin 9 → ℤ :=
  fun e => (if S (core.head e) then 1 else 0) - (if S (core.tail e) then 1 else 0)

/-- The cut march with side `S`, window starts `lo` and length `t`. -/
def cutScript (d : DegSpec 6 9) (S : Fin 6 → Bool) (lo : Fin 9 → ℕ) (t : ℕ) :
    firing_script d.graph :=
  d.rampScript (cutPot S t) (cutSgn d.core S) lo t

variable {d : DegSpec 6 9}

/-- **The divisor of a cut march**, on the closed orthant.  The potential
condition of `RampData` holds by construction of `cutSgn`, and `repInv` is
free from `RepGen`, so only the window remains to be checked. -/
theorem prin_cutScript (hrep : RepGen d) (S : Fin 6 → Bool) (lo : Fin 9 → ℕ) (t : ℕ)
    (hwin : ∀ e, lo e + t ≤ d.length e ∨ cutSgn d.core S e = 0) :
    prin d.graph (cutScript d S lo t) =
      ∑ e : Fin 9, cutSgn d.core S e •
        (one_chip (G := d.graph) (d.pathAt e (lo e)) -
          one_chip (G := d.graph) (d.pathAt e (lo e + t))) :=
  DegSpec.prin_ramp_eq (DegSpec.RampData.of_reachIn
    (fun e => by simp only [cutPot, cutSgn]; split_ifs <;> ring) hwin hrep)

/-- Side `{v0,v5}` of the cut `{e0,e8}`. -/
def sideA : Fin 6 → Bool := ![true, false, false, false, false, true]

/-- Side `{v0,v2,v3,v5}` of the cut `{e0,e3}`. -/
def sideB : Fin 6 → Bool := ![true, false, true, true, false, true]

/-- Side `{v0,v1,v4,v5}` of the cut `{e3,e8}`. -/
def sideC : Fin 6 → Bool := ![true, true, false, false, true, true]

/-- Side `{v0,v2,v5}` of the cut `{e0,e6,e7}`: the relay across `β₂`. -/
def sideR : Fin 6 → Bool := ![true, false, true, false, false, true]

/-- Side `{v0,v1,v2,v3,v5}` of the cut `{e0,e4,e5}`: the star of `v4`. -/
def sideD : Fin 6 → Bool := ![true, true, true, true, false, true]

variable {core : ExplicitPotential.Core 6 9}

theorem cutSgn_sideA (hn : IsNecklaceCore core) :
    cutSgn core sideA = ![-1, 0, 0, 0, 0, 0, 0, 0, 1] := by
  funext e
  revert e
  refine forall_fin_nine ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ <;>
    simp [cutSgn, sideA, hn.t0, hn.t1, hn.t2, hn.t3, hn.t4, hn.t5, hn.t6, hn.t7,
      hn.t8, hn.h0, hn.h1, hn.h2, hn.h3, hn.h4, hn.h5, hn.h6, hn.h7, hn.h8]

theorem cutSgn_sideB (hn : IsNecklaceCore core) :
    cutSgn core sideB = ![-1, 0, 0, 1, 0, 0, 0, 0, 0] := by
  funext e
  revert e
  refine forall_fin_nine ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ <;>
    simp [cutSgn, sideB, hn.t0, hn.t1, hn.t2, hn.t3, hn.t4, hn.t5, hn.t6, hn.t7,
      hn.t8, hn.h0, hn.h1, hn.h2, hn.h3, hn.h4, hn.h5, hn.h6, hn.h7, hn.h8]

theorem cutSgn_sideC (hn : IsNecklaceCore core) :
    cutSgn core sideC = ![0, 0, 0, -1, 0, 0, 0, 0, 1] := by
  funext e
  revert e
  refine forall_fin_nine ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ <;>
    simp [cutSgn, sideC, hn.t0, hn.t1, hn.t2, hn.t3, hn.t4, hn.t5, hn.t6, hn.t7,
      hn.t8, hn.h0, hn.h1, hn.h2, hn.h3, hn.h4, hn.h5, hn.h6, hn.h7, hn.h8]

theorem cutSgn_sideR (hn : IsNecklaceCore core) :
    cutSgn core sideR = ![-1, 0, 0, 0, 0, 0, -1, -1, 0] := by
  funext e
  revert e
  refine forall_fin_nine ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ <;>
    simp [cutSgn, sideR, hn.t0, hn.t1, hn.t2, hn.t3, hn.t4, hn.t5, hn.t6, hn.t7,
      hn.t8, hn.h0, hn.h1, hn.h2, hn.h3, hn.h4, hn.h5, hn.h6, hn.h7, hn.h8]

theorem cutSgn_sideD (hn : IsNecklaceCore core) :
    cutSgn core sideD = ![-1, 0, 0, 0, -1, -1, 0, 0, 0] := by
  funext e
  revert e
  refine forall_fin_nine ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ <;>
    simp [cutSgn, sideD, hn.t0, hn.t1, hn.t2, hn.t3, hn.t4, hn.t5, hn.t6, hn.t7,
      hn.t8, hn.h0, hn.h1, hn.h2, hn.h3, hn.h4, hn.h5, hn.h6, hn.h7, hn.h8]

end Cut

/-! ## The five marches

Each is one instantiation of `prin_cutScript`, expanded over the nine slots.
Window starts are vector literals, so every slot value is a `simp`
evaluation. -/

section Marches

variable {d : DegSpec 6 9}

/-- **March `A`** (cut `{e0,e8}`): a chip advances by `t` along `e0` while a
chip retreats by `t` along `e8`. -/
theorem prin_cutA (hn : IsNecklaceCore d.core) (hrep : RepGen d) (lo0 lo8 t : ℕ)
    (hw0 : lo0 + t ≤ d.length 0) (hw8 : lo8 + t ≤ d.length 8) :
    prin d.graph (cutScript d sideA ![lo0, 0, 0, 0, 0, 0, 0, 0, lo8] t) =
      (one_chip (G := d.graph) (d.pathAt 0 (lo0 + t)) - one_chip (d.pathAt 0 lo0)) +
        (one_chip (d.pathAt 8 lo8) - one_chip (d.pathAt 8 (lo8 + t))) := by
  rw [prin_cutScript hrep _ _ _ (by
      rw [cutSgn_sideA hn]
      refine forall_fin_nine ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ <;> simp <;> omega),
    sum_univ_nine, cutSgn_sideA hn]
  simp only [Matrix.cons_val, zero_smul, one_smul, neg_smul]
  abel

/-- **March `B`** (cut `{e0,e3}`): a chip advances by `t` along `e0` while a
chip retreats by `t` along `e3`. -/
theorem prin_cutB (hn : IsNecklaceCore d.core) (hrep : RepGen d) (lo0 lo3 t : ℕ)
    (hw0 : lo0 + t ≤ d.length 0) (hw3 : lo3 + t ≤ d.length 3) :
    prin d.graph (cutScript d sideB ![lo0, 0, 0, lo3, 0, 0, 0, 0, 0] t) =
      (one_chip (G := d.graph) (d.pathAt 0 (lo0 + t)) - one_chip (d.pathAt 0 lo0)) +
        (one_chip (d.pathAt 3 lo3) - one_chip (d.pathAt 3 (lo3 + t))) := by
  rw [prin_cutScript hrep _ _ _ (by
      rw [cutSgn_sideB hn]
      refine forall_fin_nine ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ <;> simp <;> omega),
    sum_univ_nine, cutSgn_sideB hn]
  simp only [Matrix.cons_val, zero_smul, one_smul, neg_smul]
  abel

/-- **March `C`** (cut `{e3,e8}`): a chip advances by `t` along `e3` while a
chip retreats by `t` along `e8`. -/
theorem prin_cutC (hn : IsNecklaceCore d.core) (hrep : RepGen d) (lo3 lo8 t : ℕ)
    (hw3 : lo3 + t ≤ d.length 3) (hw8 : lo8 + t ≤ d.length 8) :
    prin d.graph (cutScript d sideC ![0, 0, 0, lo3, 0, 0, 0, 0, lo8] t) =
      (one_chip (G := d.graph) (d.pathAt 3 (lo3 + t)) - one_chip (d.pathAt 3 lo3)) +
        (one_chip (d.pathAt 8 lo8) - one_chip (d.pathAt 8 (lo8 + t))) := by
  rw [prin_cutScript hrep _ _ _ (by
      rw [cutSgn_sideC hn]
      refine forall_fin_nine ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ <;> simp <;> omega),
    sum_univ_nine, cutSgn_sideC hn]
  simp only [Matrix.cons_val, zero_smul, one_smul, neg_smul]
  abel

/-- **The relay** (cut `{e0,e6,e7}`): one chip on each of `e0`, `e6`, `e7`
advances by `t`. -/
theorem prin_relay (hn : IsNecklaceCore d.core) (hrep : RepGen d) (lo0 lo6 lo7 t : ℕ)
    (hw0 : lo0 + t ≤ d.length 0) (hw6 : lo6 + t ≤ d.length 6)
    (hw7 : lo7 + t ≤ d.length 7) :
    prin d.graph (cutScript d sideR ![lo0, 0, 0, 0, 0, 0, lo6, lo7, 0] t) =
      (one_chip (G := d.graph) (d.pathAt 0 (lo0 + t)) - one_chip (d.pathAt 0 lo0)) +
        (one_chip (d.pathAt 6 (lo6 + t)) - one_chip (d.pathAt 6 lo6)) +
        (one_chip (d.pathAt 7 (lo7 + t)) - one_chip (d.pathAt 7 lo7)) := by
  rw [prin_cutScript hrep _ _ _ (by
      rw [cutSgn_sideR hn]
      refine forall_fin_nine ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ <;> simp <;> omega),
    sum_univ_nine, cutSgn_sideR hn]
  simp only [Matrix.cons_val, zero_smul, one_smul, neg_smul]
  abel

/-- **The star march at `v4`** (cut `{e0,e4,e5}`): one chip on each of `e0`,
`e4`, `e5` advances by `t`. -/
theorem prin_star (hn : IsNecklaceCore d.core) (hrep : RepGen d) (lo0 lo4 lo5 t : ℕ)
    (hw0 : lo0 + t ≤ d.length 0) (hw4 : lo4 + t ≤ d.length 4)
    (hw5 : lo5 + t ≤ d.length 5) :
    prin d.graph (cutScript d sideD ![lo0, 0, 0, 0, lo4, lo5, 0, 0, 0] t) =
      (one_chip (G := d.graph) (d.pathAt 0 (lo0 + t)) - one_chip (d.pathAt 0 lo0)) +
        (one_chip (d.pathAt 4 (lo4 + t)) - one_chip (d.pathAt 4 lo4)) +
        (one_chip (d.pathAt 5 (lo5 + t)) - one_chip (d.pathAt 5 lo5)) := by
  rw [prin_cutScript hrep _ _ _ (by
      rw [cutSgn_sideD hn]
      refine forall_fin_nine ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ <;> simp <;> omega),
    sum_univ_nine, cutSgn_sideD hn]
  simp only [Matrix.cons_val, zero_smul, one_smul, neg_smul]
  abel

end Marches

/-! ## Bridging core classes and path positions -/

section Bridge

variable {d : DegSpec 6 9}

theorem cvT (e : Fin 9) {v : Fin 6} (hv : d.core.tail e = v) :
    d.pathAt e 0 = d.coreVertex v := by
  rw [d.pathAt_zero, hv]

theorem cvH (e : Fin 9) {v : Fin 6} (hv : d.core.head e = v) :
    d.pathAt e (d.length e) = d.coreVertex v := by
  rw [d.pathAt_length (le_refl _), hv]

/-- An explicit script carrying `D` to three chips, one of which is at `q`,
shows that `D` reaches `q`. -/
theorem reaches_of_state (D : CFDiv d.graph) (script : firing_script d.graph)
    (A B C : d.graph.V)
    (hst : D + prin d.graph script = one_chip A + one_chip B + one_chip C)
    (q : d.graph.V) (hq : q = A ∨ q = B ∨ q = C) :
    StrongSeparator.Reaches d.graph D q := by
  refine d.reaches_of_script D script q ?_ ?_
  · rw [hst]
    exact threeChipDivisor_effective A B C
  · rw [hst]
    exact chip_three A B C q hq

end Bridge

/-! ## Regime 1: the triangle inequality holds

`a₃ ≤ a₀`, `a₈ ≤ a₀`, `a₀ ≤ a₃ + a₈`.  The pencil
`D = v0 + v5 + (e3 at depth a₀ - a₈)` is the member `T(0, a₀ - a₈, a₈)` of the
family `T(j, k, m)` = one chip on each single slot at depths `j, k, m`. -/

section RegimeOne

variable {d : DegSpec 6 9}

/-- The regime-1 pencil. -/
def pen1 (d : DegSpec 6 9) : CFDiv d.graph :=
  one_chip (G := d.graph) (d.coreVertex 0) + one_chip (d.coreVertex 5) +
    one_chip (d.pathAt 3 (d.length 0 - d.length 8))

theorem deg_pen1 : deg (pen1 d) = 3 := by
  unfold pen1
  rw [deg.map_add, deg.map_add, deg_one_chip, deg_one_chip, deg_one_chip]
  norm_num

/-- March `A` of length `a₈`: `T(0, a₀ - a₈, a₈) ~ T(a₈, a₀ - a₈, 0)`. -/
theorem state1_A (hn : IsNecklaceCore d.core) (hrep : RepGen d)
    (hmax₂ : d.length 8 ≤ d.length 0) :
    pen1 d + prin d.graph
        (cutScript d sideA ![0, 0, 0, 0, 0, 0, 0, 0, 0] (d.length 8)) =
      one_chip (G := d.graph) (d.pathAt 0 (d.length 8)) +
        one_chip (d.pathAt 3 (d.length 0 - d.length 8)) +
        one_chip (d.pathAt 8 0) := by
  rw [prin_cutA hn hrep 0 0 (d.length 8) (by omega) (by omega), zero_add, pen1,
    cvT 0 hn.t0, cvH 8 hn.h8]
  abel

/-- March `A`, then march `B` of length `a₀ - a₈`: `T(a₀, 0, 0)`. -/
theorem state1_AB (hn : IsNecklaceCore d.core) (hrep : RepGen d)
    (hmax₂ : d.length 8 ≤ d.length 0) (htri : d.length 0 ≤ d.length 3 + d.length 8) :
    pen1 d + prin d.graph
        (cutScript d sideA ![0, 0, 0, 0, 0, 0, 0, 0, 0] (d.length 8) +
          cutScript d sideB ![d.length 8, 0, 0, 0, 0, 0, 0, 0, 0]
            (d.length 0 - d.length 8)) =
      one_chip (G := d.graph) (d.pathAt 0 (d.length 0)) +
        one_chip (d.pathAt 3 0) + one_chip (d.pathAt 8 0) := by
  rw [map_add, ← add_assoc, state1_A hn hrep hmax₂,
    prin_cutB hn hrep (d.length 8) 0 (d.length 0 - d.length 8) (by omega) (by omega),
    zero_add, d.pathAt_of_eq 0 (show d.length 8 + (d.length 0 - d.length 8) =
      d.length 0 by omega)]
  abel

/-- March `C` of length `a₃ + a₈ - a₀`: `T(0, a₃, a₀ - a₃)`. -/
theorem state1_C (hn : IsNecklaceCore d.core) (hrep : RepGen d)
    (hmax₁ : d.length 3 ≤ d.length 0) (hmax₂ : d.length 8 ≤ d.length 0)
    (htri : d.length 0 ≤ d.length 3 + d.length 8) :
    pen1 d + prin d.graph
        (cutScript d sideC
          ![0, 0, 0, d.length 0 - d.length 8, 0, 0, 0, 0, d.length 0 - d.length 3]
          (d.length 3 + d.length 8 - d.length 0)) =
      one_chip (G := d.graph) (d.coreVertex 0) + one_chip (d.pathAt 3 (d.length 3)) +
        one_chip (d.pathAt 8 (d.length 0 - d.length 3)) := by
  rw [prin_cutC hn hrep (d.length 0 - d.length 8) (d.length 0 - d.length 3)
      (d.length 3 + d.length 8 - d.length 0) (by omega) (by omega),
    d.pathAt_of_eq 3 (show d.length 0 - d.length 8 +
      (d.length 3 + d.length 8 - d.length 0) = d.length 3 by omega),
    d.pathAt_of_eq 8 (show d.length 0 - d.length 3 +
      (d.length 3 + d.length 8 - d.length 0) = d.length 8 by omega),
    pen1, cvH 8 hn.h8]
  abel

/-- **Every core class is reached by the regime-1 pencil.** -/
theorem reaches_regime1 (hn : IsNecklaceCore d.core) (hrep : RepGen d)
    (hmax₁ : d.length 3 ≤ d.length 0) (hmax₂ : d.length 8 ≤ d.length 0)
    (htri : d.length 0 ≤ d.length 3 + d.length 8) (v : Fin 6) :
    StrongSeparator.Reaches d.graph (pen1 d) (d.coreVertex v) := by
  have hpen : pen1 d + prin d.graph 0 =
      one_chip (G := d.graph) (d.coreVertex 0) + one_chip (d.coreVertex 5) +
        one_chip (d.pathAt 3 (d.length 0 - d.length 8)) := by
    rw [map_zero, add_zero, pen1]
  have hAB := state1_AB hn hrep hmax₂ htri
  revert v
  refine forall_fin_six ?_ ?_ ?_ ?_ ?_ ?_
  · -- `v0`, carried by the pencil itself
    exact reaches_of_state _ _ _ _ _ hpen _ (Or.inl rfl)
  · -- `v1`, the tail of `e3` in `T(a₀, 0, 0)`
    exact reaches_of_state _ _ _ _ _ hAB _ (Or.inr (Or.inl (cvT 3 hn.t3).symm))
  · -- `v2`, the tail of `e8` in `T(a₀, 0, 0)`
    exact reaches_of_state _ _ _ _ _ hAB _ (Or.inr (Or.inr (cvT 8 hn.t8).symm))
  · -- `v3`, the head of `e3` in `T(0, a₃, a₀ - a₃)`
    exact reaches_of_state _ _ _ _ _ (state1_C hn hrep hmax₁ hmax₂ htri) _
      (Or.inr (Or.inl (cvH 3 hn.h3).symm))
  · -- `v4`, the head of `e0` in `T(a₀, 0, 0)`
    exact reaches_of_state _ _ _ _ _ hAB _ (Or.inl (cvH 0 hn.h0).symm)
  · -- `v5`, carried by the pencil itself
    exact reaches_of_state _ _ _ _ _ hpen _ (Or.inr (Or.inl rfl))

/-- **Regime 1 on the closed orthant.** -/
theorem bnExists_regime1 (hn : IsNecklaceCore d.core) (hconn : d.core.Connected)
    (hrep : RepGen d) (hmax₁ : d.length 3 ≤ d.length 0)
    (hmax₂ : d.length 8 ≤ d.length 0) (htri : d.length 0 ≤ d.length 3 + d.length 8) :
    BNExists d.graph 1 3 :=
  bnExists_of_reaches_coreVertices d hconn (pen1 d) 3 deg_pen1
    (reaches_regime1 hn hrep hmax₁ hmax₂ htri)

end RegimeOne

/-! ## Regime 2: the banana relay

`a₃ + a₈ ≤ a₀` and `a₇ ≤ a₆`.  With `s = min (a₀ - a₃ - a₈) a₇` the pencil is
`D = v0 + v5 + (e6 at depth a₆ - s)`, and the chain, with the `e0` depth in
brackets, is

```text
[0]          v0 + (e6 at a₆ - s) + v5
[a₈]         ·  + (e6 at a₆ - s) + v2         (march A)
[a₈ + s]     ·  + v3 + (e7 at s)              (the relay)
[a₈ + s + a₃] · + (e7 at s) + v1              (march B)
```
-/

section RegimeTwo

variable {d : DegSpec 6 9}

/-- The relay depth `s = min (a₀ - a₃ - a₈) a₇`. -/
def sDepth (L : Fin 9 → ℕ) : ℕ := min (L 0 - L 3 - L 8) (L 7)

/-- The regime-2 pencil. -/
def pen2 (d : DegSpec 6 9) : CFDiv d.graph :=
  one_chip (G := d.graph) (d.coreVertex 0) + one_chip (d.coreVertex 5) +
    one_chip (d.pathAt 6 (d.length 6 - sDepth d.length))

theorem deg_pen2 : deg (pen2 d) = 3 := by
  unfold pen2
  rw [deg.map_add, deg.map_add, deg_one_chip, deg_one_chip, deg_one_chip]
  norm_num

/-- March `A` brings the trailing chip from `v5` back to `v2`. -/
theorem state2_A (hn : IsNecklaceCore d.core) (hrep : RepGen d)
    (hx : d.length 3 + d.length 8 ≤ d.length 0) :
    pen2 d + prin d.graph
        (cutScript d sideA ![0, 0, 0, 0, 0, 0, 0, 0, 0] (d.length 8)) =
      one_chip (G := d.graph) (d.pathAt 0 (d.length 8)) +
        one_chip (d.pathAt 6 (d.length 6 - sDepth d.length)) +
        one_chip (d.pathAt 7 0) := by
  rw [prin_cutA hn hrep 0 0 (d.length 8) (by omega) (by omega), zero_add, pen2,
    cvT 0 hn.t0, cvH 8 hn.h8, cvT 8 hn.t8, cvT 7 hn.t7]
  abel

/-- The relay across `β₂`: the parked chip on `e6` reaches `v3` while the
arriving chip advances to depth `s` on `e7`. -/
theorem state2_R (hn : IsNecklaceCore d.core) (hrep : RepGen d)
    (hx : d.length 3 + d.length 8 ≤ d.length 0) (harc : d.length 7 ≤ d.length 6) :
    pen2 d + prin d.graph
        (cutScript d sideA ![0, 0, 0, 0, 0, 0, 0, 0, 0] (d.length 8) +
          cutScript d sideR
            ![d.length 8, 0, 0, 0, 0, 0, d.length 6 - sDepth d.length, 0, 0]
            (sDepth d.length)) =
      one_chip (G := d.graph) (d.pathAt 0 (d.length 8 + sDepth d.length)) +
        one_chip (d.coreVertex 3) + one_chip (d.pathAt 7 (sDepth d.length)) := by
  have hs : sDepth d.length = min (d.length 0 - d.length 3 - d.length 8) (d.length 7) :=
    rfl
  rw [map_add, ← add_assoc, state2_A hn hrep hx,
    prin_relay hn hrep (d.length 8) (d.length 6 - sDepth d.length) 0 (sDepth d.length)
      (by omega) (by omega) (by omega),
    zero_add, d.pathAt_of_eq 6 (show d.length 6 - sDepth d.length + sDepth d.length =
      d.length 6 by omega), cvH 6 hn.h6]
  abel

/-- March `B` brings the leading trailer from `v3` back to `v1`. -/
theorem state2_B (hn : IsNecklaceCore d.core) (hrep : RepGen d)
    (hx : d.length 3 + d.length 8 ≤ d.length 0) (harc : d.length 7 ≤ d.length 6) :
    pen2 d + prin d.graph
        (cutScript d sideA ![0, 0, 0, 0, 0, 0, 0, 0, 0] (d.length 8) +
          cutScript d sideR
            ![d.length 8, 0, 0, 0, 0, 0, d.length 6 - sDepth d.length, 0, 0]
            (sDepth d.length) +
          cutScript d sideB ![d.length 8 + sDepth d.length, 0, 0, 0, 0, 0, 0, 0, 0]
            (d.length 3)) =
      one_chip (G := d.graph)
          (d.pathAt 0 (d.length 8 + sDepth d.length + d.length 3)) +
        one_chip (d.pathAt 7 (sDepth d.length)) + one_chip (d.pathAt 3 0) := by
  have hs : sDepth d.length = min (d.length 0 - d.length 3 - d.length 8) (d.length 7) :=
    rfl
  rw [map_add, ← add_assoc, state2_R hn hrep hx harc,
    prin_cutB hn hrep (d.length 8 + sDepth d.length) 0 (d.length 3)
      (by omega) (by omega),
    zero_add, cvH 3 hn.h3]
  abel

/-- **Arrival at `v4` through its star.**  If some script carries `D` to one
chip on `e0` and two chips at `v1`, then `D` reaches `v4`: the star march at
`v4` runs for `u = min (min a₄ a₅) (a₀ - j)`, and whichever of its three slots
attains the minimum delivers its chip to `v4`.  (When `j = a₀` the march has
length `0` and the chip on `e0` is already at `v4`; when `a₄ = 0` or `a₅ = 0`
the march is again empty, and `v1` and `v4` are the same class.) -/
theorem reaches_v4_of_star (hn : IsNecklaceCore d.core) (hrep : RepGen d)
    (D : CFDiv d.graph) (script : firing_script d.graph) (j : ℕ)
    (hj : j ≤ d.length 0)
    (hst : D + prin d.graph script =
      one_chip (G := d.graph) (d.pathAt 0 j) + one_chip (d.coreVertex 1) +
        one_chip (d.coreVertex 1)) :
    StrongSeparator.Reaches d.graph D (d.coreVertex 4) := by
  obtain ⟨u, hu⟩ : ∃ u, u = min (min (d.length 4) (d.length 5)) (d.length 0 - j) :=
    ⟨_, rfl⟩
  have hst' : D + prin d.graph
      (script + cutScript d sideD ![j, 0, 0, 0, 0, 0, 0, 0, 0] u) =
      one_chip (G := d.graph) (d.pathAt 0 (j + u)) + one_chip (d.pathAt 4 u) +
        one_chip (d.pathAt 5 u) := by
    rw [map_add, ← add_assoc, hst,
      prin_star hn hrep j 0 0 u (by omega) (by omega) (by omega),
      zero_add, cvT 4 hn.t4, cvT 5 hn.t5]
    abel
  have hcase : d.length 4 ≤ u ∨ d.length 5 ≤ u ∨ d.length 0 ≤ j + u := by omega
  rcases hcase with h | h | h
  · exact reaches_of_state _ _ _ _ _ hst' _
      (Or.inr (Or.inl (by rw [d.pathAt_length h, hn.h4])))
  · exact reaches_of_state _ _ _ _ _ hst' _
      (Or.inr (Or.inr (by rw [d.pathAt_length h, hn.h5])))
  · exact reaches_of_state _ _ _ _ _ hst' _
      (Or.inl (by rw [d.pathAt_length h, hn.h0]))

/-- The regime-2 pencil reaches `v4`.  Either march `B` has already parked the
`e0` chip on `v4`, or there is room left on `e0`; then `s = a₇`, so the chip on
`e7` is a second chip at `v3`, and a second march `B` of length
`m = min a₃ (a₀ - a₈ - s - a₃)` either lands the `e0` chip on `v4` or leaves
two chips at `v1`, for the star. -/
theorem reaches_v4_regime2 (hn : IsNecklaceCore d.core) (hrep : RepGen d)
    (hx : d.length 3 + d.length 8 ≤ d.length 0) (harc : d.length 7 ≤ d.length 6) :
    StrongSeparator.Reaches d.graph (pen2 d) (d.coreVertex 4) := by
  have hs : sDepth d.length = min (d.length 0 - d.length 3 - d.length 8) (d.length 7) :=
    rfl
  have hB := state2_B hn hrep hx harc
  by_cases hr : d.length 0 ≤ d.length 8 + sDepth d.length + d.length 3
  · exact reaches_of_state _ _ _ _ _ hB _ (Or.inl (by rw [d.pathAt_length hr, hn.h0]))
  · have hs7 : sDepth d.length = d.length 7 := by omega
    obtain ⟨m, hm⟩ : ∃ m, m = min (d.length 3)
        (d.length 0 - (d.length 8 + sDepth d.length + d.length 3)) := ⟨_, rfl⟩
    have hB2 : pen2 d + prin d.graph
        (cutScript d sideA ![0, 0, 0, 0, 0, 0, 0, 0, 0] (d.length 8) +
          cutScript d sideR
            ![d.length 8, 0, 0, 0, 0, 0, d.length 6 - sDepth d.length, 0, 0]
            (sDepth d.length) +
          cutScript d sideB ![d.length 8 + sDepth d.length, 0, 0, 0, 0, 0, 0, 0, 0]
            (d.length 3) +
          cutScript d sideB
            ![d.length 8 + sDepth d.length + d.length 3, 0, 0, d.length 3 - m,
              0, 0, 0, 0, 0] m) =
        one_chip (G := d.graph)
            (d.pathAt 0 (d.length 8 + sDepth d.length + d.length 3 + m)) +
          one_chip (d.pathAt 3 (d.length 3 - m)) + one_chip (d.pathAt 3 0) := by
      rw [map_add, ← add_assoc, hB,
        prin_cutB hn hrep (d.length 8 + sDepth d.length + d.length 3) (d.length 3 - m) m
          (by omega) (by omega),
        d.pathAt_of_eq 7 hs7, cvH 7 hn.h7,
        d.pathAt_of_eq 3 (show d.length 3 - m + m = d.length 3 by omega), cvH 3 hn.h3]
      abel
    by_cases hfin : d.length 0 ≤ d.length 8 + sDepth d.length + d.length 3 + m
    · exact reaches_of_state _ _ _ _ _ hB2 _
        (Or.inl (by rw [d.pathAt_length hfin, hn.h0]))
    · -- The march emptied `e3`: two chips at `v1`, then the star.
      refine reaches_v4_of_star hn hrep (pen2 d) _
        (d.length 8 + sDepth d.length + d.length 3 + m) (by omega) (hB2.trans ?_)
      rw [d.pathAt_of_eq 3 (show d.length 3 - m = 0 by omega), cvT 3 hn.t3]

/-- **Every core class is reached by the regime-2 pencil.** -/
theorem reaches_regime2 (hn : IsNecklaceCore d.core) (hrep : RepGen d)
    (hx : d.length 3 + d.length 8 ≤ d.length 0) (harc : d.length 7 ≤ d.length 6)
    (v : Fin 6) :
    StrongSeparator.Reaches d.graph (pen2 d) (d.coreVertex v) := by
  have hpen : pen2 d + prin d.graph 0 =
      one_chip (G := d.graph) (d.coreVertex 0) + one_chip (d.coreVertex 5) +
        one_chip (d.pathAt 6 (d.length 6 - sDepth d.length)) := by
    rw [map_zero, add_zero, pen2]
  revert v
  refine forall_fin_six ?_ ?_ ?_ ?_ ?_ ?_
  · -- `v0`, carried by the pencil itself
    exact reaches_of_state _ _ _ _ _ hpen _ (Or.inl rfl)
  · -- `v1`, the leading trailer after march `B`
    exact reaches_of_state _ _ _ _ _ (state2_B hn hrep hx harc) _
      (Or.inr (Or.inr (cvT 3 hn.t3).symm))
  · -- `v2`, the trailing chip after march `A`
    exact reaches_of_state _ _ _ _ _ (state2_A hn hrep hx) _
      (Or.inr (Or.inr (cvT 7 hn.t7).symm))
  · -- `v3`, the relayed chip
    exact reaches_of_state _ _ _ _ _ (state2_R hn hrep hx harc) _ (Or.inr (Or.inl rfl))
  · -- `v4`
    exact reaches_v4_regime2 hn hrep hx harc
  · -- `v5`, carried by the pencil itself
    exact reaches_of_state _ _ _ _ _ hpen _ (Or.inr (Or.inl rfl))

/-- **Regime 2 on the closed orthant.** -/
theorem bnExists_regime2 (hn : IsNecklaceCore d.core) (hconn : d.core.Connected)
    (hrep : RepGen d) (hx : d.length 3 + d.length 8 ≤ d.length 0)
    (harc : d.length 7 ≤ d.length 6) :
    BNExists d.graph 1 3 :=
  bnExists_of_reaches_coreVertices d hconn (pen2 d) 3 deg_pen2
    (reaches_regime2 hn hrep hx harc)

end RegimeTwo

/-! ## The catalog row, on the closed orthant

The order-three rotation of the necklace moves a longest single slot to `e0`;
in regime 2 the arc swap of `β₂` makes `e6` the longer arc.  Both are the
positive-length symmetries of `LowGenus.GenusFourRow096Pencil`,
transported along the contracted graphs by `ClosedCoreSymmetry.bnExists_iff`. -/

section Row

open Utilities.Certificate.CoreOrbitReduction
open AtanasovRanganathan.GenusFourCubicAtlas

theorem isNecklaceCore_row096 : IsNecklaceCore row096Core := by constructor <;> decide

/-- The order-three rotation `v0 → v1 → v2`, `v4 → v3 → v5`, as a core
symmetry. -/
def rot : CoreSymmetry row096Core where
  vertexPerm := LowGenus.GenusFourRow096Pencil.rotVertex
  slotPerm := LowGenus.GenusFourRow096Pencil.rotSlot
  reversed := LowGenus.GenusFourRow096Pencil.rotReversed
  tail_eq := LowGenus.GenusFourRow096Pencil.rot_tail
  head_eq := LowGenus.GenusFourRow096Pencil.rot_head

/-- The swap of the two arcs `e6`, `e7` of `β₂`, as a core symmetry. -/
def swap : CoreSymmetry row096Core where
  vertexPerm := LowGenus.GenusFourRow096Pencil.swapVertex
  slotPerm := LowGenus.GenusFourRow096Pencil.swapSlot
  reversed := LowGenus.GenusFourRow096Pencil.rotReversed
  tail_eq := LowGenus.GenusFourRow096Pencil.swap_tail
  head_eq := LowGenus.GenusFourRow096Pencil.swap_head

/-- The representative map of `faceSpec` is a `compFold` of the vanishing set,
so `RepGen` is free. -/
theorem repGen_censusSpec (ℓ : Fin 9 → ℕ)
    (hForest : IsForest row096Core (zeroSet ℓ))
    (hNotLoopy : ¬ IsLoopy row096Core (zeroSet ℓ)) :
    RepGen (censusSpec row096Core (by norm_num) ℓ hForest hNotLoopy) :=
  fun u v h => (compFold_iff row096Core (zeroSet ℓ) u v).mp h

/-- **The chart where `e0` is a longest single slot**: the regime split, with
the arc swap first when `e6` is the shorter arc of `β₂` in regime 2. -/
theorem bnExists_chart (ℓ : Fin 9 → ℕ)
    (hForest : IsForest row096Core (zeroSet ℓ))
    (hNotLoopy : ¬ IsLoopy row096Core (zeroSet ℓ))
    (hmax₁ : ℓ 3 ≤ ℓ 0) (hmax₂ : ℓ 8 ≤ ℓ 0) :
    BNExists (censusSpec row096Core (by norm_num) ℓ hForest hNotLoopy).graph 1 3 := by
  by_cases htri : ℓ 0 ≤ ℓ 3 + ℓ 8
  · exact bnExists_regime1 isNecklaceCore_row096 row096.connected
      (repGen_censusSpec ℓ hForest hNotLoopy) hmax₁ hmax₂ htri
  · by_cases harc : ℓ 7 ≤ ℓ 6
    · exact bnExists_regime2 isNecklaceCore_row096 row096.connected
        (repGen_censusSpec ℓ hForest hNotLoopy) (show ℓ 3 + ℓ 8 ≤ ℓ 0 by omega) harc
    · have hs0 : (swap.slotPerm.symm : Fin 9 → Fin 9) 0 = 0 := by decide
      have hs3 : (swap.slotPerm.symm : Fin 9 → Fin 9) 3 = 3 := by decide
      have hs6 : (swap.slotPerm.symm : Fin 9 → Fin 9) 6 = 7 := by decide
      have hs7 : (swap.slotPerm.symm : Fin 9 → Fin 9) 7 = 6 := by decide
      have hs8 : (swap.slotPerm.symm : Fin 9 → Fin 9) 8 = 8 := by decide
      refine (ClosedCoreSymmetry.bnExists_iff swap ℓ (by norm_num) hForest
        hNotLoopy 1 3).mp ?_
      refine bnExists_regime2 isNecklaceCore_row096 row096.connected
        (repGen_censusSpec _ _ _) ?_ ?_
      · show ℓ ((swap.slotPerm.symm : Fin 9 → Fin 9) 3) +
            ℓ ((swap.slotPerm.symm : Fin 9 → Fin 9) 8) ≤
          ℓ ((swap.slotPerm.symm : Fin 9 → Fin 9) 0)
        rw [hs3, hs8, hs0]; omega
      · show ℓ ((swap.slotPerm.symm : Fin 9 → Fin 9) 7) ≤
          ℓ ((swap.slotPerm.symm : Fin 9 → Fin 9) 6)
        rw [hs7, hs6]; omega

/-- **`BNExists … 1 3` for atlas row `096`, on the whole closed length
orthant**, in the `censusSpec` form: the three cases are the orbit of the
chart `bnExists_chart` under the rotation of the necklace. -/
theorem bnExists_closed (ℓ : Fin 9 → ℕ)
    (hForest : IsForest row096Core (zeroSet ℓ))
    (hNotLoopy : ¬ IsLoopy row096Core (zeroSet ℓ)) :
    BNExists (censusSpec row096Core (by norm_num) ℓ hForest hNotLoopy).graph 1 3 := by
  have hr0 : (rot.slotPerm.symm : Fin 9 → Fin 9) 0 = 8 := by decide
  have hr3 : (rot.slotPerm.symm : Fin 9 → Fin 9) 3 = 0 := by decide
  have hr8 : (rot.slotPerm.symm : Fin 9 → Fin 9) 8 = 3 := by decide
  by_cases h0 : ℓ 3 ≤ ℓ 0 ∧ ℓ 8 ≤ ℓ 0
  · exact bnExists_chart ℓ hForest hNotLoopy h0.1 h0.2
  · by_cases h8 : ℓ 0 ≤ ℓ 8 ∧ ℓ 3 ≤ ℓ 8
    · -- one rotation brings `e8` to `e0`
      refine (ClosedCoreSymmetry.bnExists_iff rot ℓ (by norm_num) hForest
        hNotLoopy 1 3).mp ?_
      refine bnExists_chart _ _ _ ?_ ?_
      · show ℓ ((rot.slotPerm.symm : Fin 9 → Fin 9) 3) ≤
          ℓ ((rot.slotPerm.symm : Fin 9 → Fin 9) 0)
        rw [hr3, hr0]; exact h8.1
      · show ℓ ((rot.slotPerm.symm : Fin 9 → Fin 9) 8) ≤
          ℓ ((rot.slotPerm.symm : Fin 9 → Fin 9) 0)
        rw [hr8, hr0]; exact h8.2
    · -- two rotations bring `e3` to `e0`
      have h3 : ℓ 0 ≤ ℓ 3 ∧ ℓ 8 ≤ ℓ 3 := by
        simp only [not_and_or, not_le] at h0 h8
        omega
      refine (ClosedCoreSymmetry.bnExists_iff rot ℓ (by norm_num) hForest
        hNotLoopy 1 3).mp ?_
      refine (ClosedCoreSymmetry.bnExists_iff rot
        (ClosedCoreSymmetry.targetLength rot ℓ) (by norm_num) _ _ 1 3).mp ?_
      refine bnExists_chart _ _ _ ?_ ?_
      · show ℓ ((rot.slotPerm.symm : Fin 9 → Fin 9)
            ((rot.slotPerm.symm : Fin 9 → Fin 9) 3)) ≤
          ℓ ((rot.slotPerm.symm : Fin 9 → Fin 9)
            ((rot.slotPerm.symm : Fin 9 → Fin 9) 0))
        simp only [hr0, hr3, hr8]; exact h3.2
      · show ℓ ((rot.slotPerm.symm : Fin 9 → Fin 9)
            ((rot.slotPerm.symm : Fin 9 → Fin 9) 8)) ≤
          ℓ ((rot.slotPerm.symm : Fin 9 → Fin 9)
            ((rot.slotPerm.symm : Fin 9 → Fin 9) 0))
        simp only [hr0, hr3, hr8]; exact h3.1

/-- **Closed-face degree-three pencil for public atlas row 096**, in the
statement of `AtanasovRanganathan.GenusFourGeneratedRows.row096_closed`: every
subdivision and every equal-genus contraction of the necklace of three bananas
carries a degree-three rank-one divisor. -/
theorem row096_closed (length : Fin 9 → ℕ)
    (hForest : IsForest row096Core (zeroSlots length))
    (hNotLoopy : ¬ IsLoopy row096Core (zeroSlots length)) :
    BNExists (faceSpec row096Core (by norm_num) length hForest hNotLoopy).graph 1 3 := by
  rw [faceSpec_eq_censusSpec]
  exact bnExists_closed length hForest hNotLoopy

end Row

end AtanasovRanganathan.GenusFourRow096Closed
