import DraismaVargas.LocalCases.W4StablePathAssignment
import DraismaVargas.Infrastructure.GluingRelabel
import Utilities.Foundations.InducedSubgraph
import Utilities.Gluing.SeparatingEdgeCut
import Utilities.Subdivision.LeafReduction

/-!
# The stable source underlying W4

This module starts the source-facing bridge from a literal quotient graph to
the stable paths used as rows of the Draisma--Vargas length matrix.  It follows
the paper's construction: delete exactly the edge occurrences whose removal
leaves a genus-zero component, then smooth surviving divalent vertices.

The dangling certificate is occurrence-safe for multigraphs.  A distinguished
source edge is the unique crossing occurrence of a cut, both induced sides are
connected after deleting it, and the chosen side has genus zero.  Stable paths
are the equivalence classes generated by passage through surviving
valency-two vertices.  A full-dimensional stable-path labelling then forces
the old-edge component of `W4StablePathAssignment.PathAssignment`; only the
candidate-specific regrown occurrences remain to be supplied.
-/

namespace DraismaVargas.LocalCases.W4StableSource

open DraismaVargas.Infrastructure
open DraismaVargas.LocalCases.W4Assembly
open DraismaVargas.LocalCases.GlobalW4
open DraismaVargas.LocalCases.W4SourceClassification
open DraismaVargas.LocalCases.W4StablePathAssignment

variable {target : CFGraph} {degree : ℕ}

/-- One orientation of a dangling source-edge cut.  The distinguished edge
occurrence is the unique edge crossing the cut, both sides left after deleting
it are connected, and the chosen side has genus zero. -/
structure DanglingSide (G : CFGraph) (left right : G.V)
    extends Utilities.SeparatingEdgeCut G left right where
  side_connected :
    graph_connected
      (Utilities.inducedSubgraph G side ⟨left, left_mem⟩)
  complement_connected :
    graph_connected
      (Utilities.inducedSubgraph G (Finset.univ \ side)
        ⟨right, Finset.mem_sdiff.mpr ⟨Finset.mem_univ right, right_not_mem⟩⟩)
  side_genus_zero :
    genus (Utilities.inducedSubgraph G side ⟨left, left_mem⟩) = 0

/-- A quotient-source edge occurrence is dangling when deleting its unique
crossing occurrence leaves two connected components, one of genus zero. -/
def IsDangling (data : GluingDatum target degree)
    (edge : data.SourceEdge) : Prop :=
  Nonempty (DanglingSide data.sourceGraph
    (data.sourceEnds edge).1 (data.sourceEnds edge).2) ∨
  Nonempty (DanglingSide data.sourceGraph
    (data.sourceEnds edge).2 (data.sourceEnds edge).1)

/-- The edge part of the paper's dangling-no-glue condition: every dangling
quotient-source edge class has one sheet.  This is the exact portion needed
to classify the inactive branches at a W4 wall. -/
def DanglingEdgeNoGlue (data : GluingDatum target degree) : Prop :=
  ∀ edge : data.SourceEdge,
    IsDangling data edge → data.sourceEdgeIndex edge = 1

/-- Reconstructing a source-edge occurrence from its stored target occurrence
and sheet representative gives that same occurrence. -/
@[simp] theorem GluingDatum.sourceEdge_self
    (data : GluingDatum target degree) (edge : data.SourceEdge) :
    data.sourceEdge edge.1.1 edge.1.2 = edge := by
  apply Subtype.ext
  apply Prod.ext
  · rfl
  · exact edge.2

/-- A sheet names a fixed canonical wall block exactly when it belongs to
that block's sheet class. -/
theorem WallBlock.ofSheet_eq_iff_rel
    (data : GluingDatum target degree) (wall : target.V)
    (sourceBlock : WallBlock data wall) (sheet : Fin degree) :
    WallBlock.ofSheet data wall sheet = sourceBlock ↔
      (data.vertexPartition wall).Rel sourceBlock.1 sheet := by
  constructor
  · intro hBlock
    have hValue := congrArg Subtype.val hBlock
    change (data.vertexPartition wall).repr sheet = sourceBlock.1 at hValue
    unfold SheetPartition.Rel
    exact sourceBlock.2.trans hValue.symm
  · intro hRel
    apply Subtype.ext
    change (data.vertexPartition wall).repr sheet = sourceBlock.1
    exact hRel.symm.trans sourceBlock.2

/-- Refinement puts the canonical source-edge representative through a sheet
back in that sheet's old wall block. -/
theorem WallBlock.ofSourceEdge_eq_of_rel
    {wall : target.V}
    (data : GluingDatum target degree)
    (star : W4TargetPairings.FourStar target wall)
    (sourceBlock : WallBlock data wall) (label : Fin 4)
    (sheet : Fin degree)
    (hSheet : (data.vertexPartition wall).Rel sourceBlock.1 sheet) :
    WallBlock.ofSheet data wall
        (data.sourceEdge (star.edge label) sheet).1.2 = sourceBlock := by
  apply (WallBlock.ofSheet_eq_iff_rel data wall sourceBlock _).2
  rw [data.sourceEdge_sheet]
  exact hSheet.trans ((star.edgePartition_refines_wall data label).rel
    ((data.edgePartition (star.edge label)).rel_repr_right sheet))

/-- Classical decidability of the exact dangling proposition, used only to
enumerate the finite literal source.  No separate graph oracle is trusted. -/
noncomputable instance (data : GluingDatum target degree)
    (edge : data.SourceEdge) : Decidable (IsDangling data edge) :=
  Classical.propDecidable _

/-- The target-star labels that contain an actual non-dangling source-edge
occurrence incident to one old wall block.  This is a definition, rather than
a source-supplied four-element classifier. -/
noncomputable def activeLabels
    {wall : target.V}
    (data : GluingDatum target degree)
    (star : W4TargetPairings.FourStar target wall)
    (sourceBlock : WallBlock data wall) : Finset (Fin 4) := by
  classical
  exact Finset.univ.filter fun label ↦
    ∃ sheet : Fin degree,
      (data.vertexPartition wall).Rel sourceBlock.1 sheet ∧
        ¬ IsDangling data (data.sourceEdge (star.edge label) sheet)

@[simp] theorem mem_activeLabels_iff
    {wall : target.V}
    (data : GluingDatum target degree)
    (star : W4TargetPairings.FourStar target wall)
    (sourceBlock : WallBlock data wall) (label : Fin 4) :
    label ∈ activeLabels data star sourceBlock ↔
      ∃ sheet : Fin degree,
        (data.vertexPartition wall).Rel sourceBlock.1 sheet ∧
          ¬ IsDangling data (data.sourceEdge (star.edge label) sheet) := by
  classical
  simp [activeLabels]

/-- Choose one honest surviving sheet witnessing an active star label. -/
noncomputable def activeWitnessSheet
    {wall : target.V}
    (data : GluingDatum target degree)
    (star : W4TargetPairings.FourStar target wall)
    (sourceBlock : WallBlock data wall) (label : Fin 4)
    (hActive : label ∈ activeLabels data star sourceBlock) : Fin degree :=
  Classical.choose
    ((mem_activeLabels_iff data star sourceBlock label).mp hActive)

theorem activeSheet_rel
    {wall : target.V}
    (data : GluingDatum target degree)
    (star : W4TargetPairings.FourStar target wall)
    (sourceBlock : WallBlock data wall) (label : Fin 4)
    (hActive : label ∈ activeLabels data star sourceBlock) :
    (data.vertexPartition wall).Rel sourceBlock.1
      (activeWitnessSheet data star sourceBlock label hActive) :=
  (Classical.choose_spec
    ((mem_activeLabels_iff data star sourceBlock label).mp hActive)).1

theorem activeSheet_survives
    {wall : target.V}
    (data : GluingDatum target degree)
    (star : W4TargetPairings.FourStar target wall)
    (sourceBlock : WallBlock data wall) (label : Fin 4)
    (hActive : label ∈ activeLabels data star sourceBlock) :
    ¬ IsDangling data
      (data.sourceEdge (star.edge label)
        (activeWitnessSheet data star sourceBlock label hActive)) :=
  (Classical.choose_spec
    ((mem_activeLabels_iff data star sourceBlock label).mp hActive)).2

/-- If an incident edge partition has only one block inside the old wall
block, then every sheet in that wall block names the same source-edge
occurrence. -/
theorem sourceEdge_eq_anchor_of_blockCountWithin_eq_one
    {wall : target.V}
    (data : GluingDatum target degree)
    (star : W4TargetPairings.FourStar target wall)
    (sourceBlock : WallBlock data wall) (label : Fin 4)
    (sheet : Fin degree)
    (hSheet : (data.vertexPartition wall).Rel sourceBlock.1 sheet)
    (hCount :
      (data.edgePartition (star.edge label)).blockCountWithin
        (data.vertexPartition wall) sourceBlock.1 = 1) :
    data.sourceEdge (star.edge label) sheet =
      data.sourceEdge (star.edge label) sourceBlock.1 := by
  let fine := data.edgePartition (star.edge label)
  let coarse := data.vertexPartition wall
  have hBlocks : fine.block sourceBlock.1 = coarse.block sourceBlock.1 :=
    fine.block_eq_of_refines_of_blockCountWithin_eq_one coarse
      (star.edgePartition_refines_wall data label) sourceBlock.1 hCount
  have hSheetMem : sheet ∈ coarse.block sourceBlock.1 :=
    (coarse.mem_block_iff sourceBlock.1 sheet).2 hSheet
  rw [← hBlocks] at hSheetMem
  have hFineRel : fine.Rel sourceBlock.1 sheet :=
    (fine.mem_block_iff sourceBlock.1 sheet).1 hSheetMem
  apply Subtype.ext
  apply Prod.ext
  · rfl
  · exact hFineRel.symm

/-- A one-block active branch contains its active witness in the canonical
edge class through the wall-block representative, so that canonical
occurrence is non-dangling. -/
theorem sourceEdge_anchor_survives_of_active_of_blockCountWithin_eq_one
    {wall : target.V}
    (data : GluingDatum target degree)
    (star : W4TargetPairings.FourStar target wall)
    (sourceBlock : WallBlock data wall) (label : Fin 4)
    (hActive : label ∈ activeLabels data star sourceBlock)
    (hCount :
      (data.edgePartition (star.edge label)).blockCountWithin
        (data.vertexPartition wall) sourceBlock.1 = 1) :
    ¬ IsDangling data
      (data.sourceEdge (star.edge label) sourceBlock.1) := by
  let sheet := activeWitnessSheet data star sourceBlock label hActive
  have hEdge := sourceEdge_eq_anchor_of_blockCountWithin_eq_one data star
    sourceBlock label sheet
      (activeSheet_rel data star sourceBlock label hActive) hCount
  rw [← hEdge]
  exact activeSheet_survives data star sourceBlock label hActive

/-- An inactive star label has only dangling source-edge occurrences on the
chosen old wall block. -/
theorem isDangling_sourceEdge_of_not_mem_activeLabels
    {wall : target.V}
    (data : GluingDatum target degree)
    (star : W4TargetPairings.FourStar target wall)
    (sourceBlock : WallBlock data wall) (label : Fin 4)
    (hInactive : label ∉ activeLabels data star sourceBlock)
    (sheet : Fin degree)
    (hSheet : (data.vertexPartition wall).Rel sourceBlock.1 sheet) :
    IsDangling data (data.sourceEdge (star.edge label) sheet) := by
  by_contra hSurvives
  exact hInactive ((mem_activeLabels_iff data star sourceBlock label).2
    ⟨sheet, hSheet, hSurvives⟩)

/-- Dangling-no-glue converts inactivity into the literal cardinality-one
edge-block statement consumed by `ActiveBranchProfile`. -/
theorem blockCard_eq_one_of_not_mem_activeLabels
    {wall : target.V}
    (data : GluingDatum target degree)
    (star : W4TargetPairings.FourStar target wall)
    (hDanglingNoGlue : DanglingEdgeNoGlue data)
    (sourceBlock : WallBlock data wall) (label : Fin 4)
    (hInactive : label ∉ activeLabels data star sourceBlock)
    (sheet : Fin degree)
    (hSheet : (data.vertexPartition wall).Rel sourceBlock.1 sheet) :
    (data.edgePartition (star.edge label)).blockCard sheet = 1 := by
  rw [← data.sourceEdgeIndex_sourceEdge]
  exact hDanglingNoGlue _
    (isDangling_sourceEdge_of_not_mem_activeLabels data star sourceBlock
      label hInactive sheet hSheet)

/-- An inactive target branch is discrete throughout the wall block, so it
contributes one source-edge block for every sheet of that block. -/
theorem blockCountWithin_eq_blockCard_of_not_mem_activeLabels
    {wall : target.V}
    (data : GluingDatum target degree)
    (star : W4TargetPairings.FourStar target wall)
    (hDanglingNoGlue : DanglingEdgeNoGlue data)
    (sourceBlock : WallBlock data wall) (label : Fin 4)
    (hInactive : label ∉ activeLabels data star sourceBlock) :
    (data.edgePartition (star.edge label)).blockCountWithin
        (data.vertexPartition wall) sourceBlock.1 =
      (data.vertexPartition wall).blockCard sourceBlock.1 := by
  have hRefinesOnBlock :=
    DraismaVargas.LocalCases.GlobalW4.refinesOnBlock_splitBlock_of_blockCard_eq_one
        (fine := data.edgePartition (star.edge label))
        (wallPartition := data.vertexPartition wall)
        (anchor := sourceBlock.1) (by
          intro sheet hSheet
          exact blockCard_eq_one_of_not_mem_activeLabels data star
            hDanglingNoGlue sourceBlock label hInactive sheet hSheet)
  exact
    SheetPartition.blockCountWithin_eq_blockCard_of_refinesOnBlock_splitBlock
      (data.edgePartition (star.edge label)) (data.vertexPartition wall)
      (data.vertexPartition wall) sourceBlock.1 sourceBlock.1 hRefinesOnBlock
      (SheetPartition.Refines.refl _) rfl

/-- The source's zero/two/three active-branch theorem and dangling-no-glue
produce the canonical W4 active profile.  The active finsets themselves are
computed from the literal stable source. -/
noncomputable def activeBranchProfileOfDanglingNoGlue
    {wall : target.V}
    (data : GluingDatum target degree)
    (star : W4TargetPairings.FourStar target wall)
    (hActiveCard : ∀ sourceBlock : WallBlock data wall,
      (activeLabels data star sourceBlock).card = 0 ∨
        (activeLabels data star sourceBlock).card = 2 ∨
          (activeLabels data star sourceBlock).card = 3)
    (hDanglingNoGlue : DanglingEdgeNoGlue data) :
    ActiveBranchProfile data star where
  active := activeLabels data star
  active_card := hActiveCard
  inactive_singleton := by
    intro sourceBlock label hInactive sheet hSheet
    exact blockCard_eq_one_of_not_mem_activeLabels data star
      hDanglingNoGlue sourceBlock label hInactive sheet hSheet

/-- No two distinct surviving source-edge occurrences over one target-star
label meet the same old wall block.  This is the occurrence-level form of the
paper's injectivity on the non-dangling neighbourhood in auxiliary Case r0. -/
structure NonDanglingStarInjective
    {wall : target.V}
    (data : GluingDatum target degree)
    (star : W4TargetPairings.FourStar target wall)
    (sourceBlock : WallBlock data wall) : Prop where
  unique : ∀ label (first second : data.SourceEdge),
    WallBlock.ofSheet data wall first.1.2 = sourceBlock →
    WallBlock.ofSheet data wall second.1.2 = sourceBlock →
    first.1.1 = star.edge label →
    second.1.1 = star.edge label →
    ¬ IsDangling data first →
    ¬ IsDangling data second →
    first = second

/-- One block is injective on a star label whenever that label induces only
one edge block inside the wall block.  This is the partition-level mechanism
that derives nd2 neighbourhood injectivity from Equation (C). -/
theorem nonDanglingStarInjective_of_active_blockCountWithin_eq_one
    {wall : target.V}
    (data : GluingDatum target degree)
    (star : W4TargetPairings.FourStar target wall)
    (sourceBlock : WallBlock data wall)
    (hCount : ∀ label : Fin 4,
      label ∈ activeLabels data star sourceBlock →
        (data.edgePartition (star.edge label)).blockCountWithin
          (data.vertexPartition wall) sourceBlock.1 = 1) :
    NonDanglingStarInjective data star sourceBlock where
  unique := by
    intro label first second hFirstBlock hSecondBlock hFirstTarget
      hSecondTarget hFirstSurvives hSecondSurvives
    have hFirstRel :
        (data.vertexPartition wall).Rel sourceBlock.1 first.1.2 :=
      (WallBlock.ofSheet_eq_iff_rel data wall sourceBlock first.1.2).1
        hFirstBlock
    have hSecondRel :
        (data.vertexPartition wall).Rel sourceBlock.1 second.1.2 :=
      (WallBlock.ofSheet_eq_iff_rel data wall sourceBlock second.1.2).1
        hSecondBlock
    have hActive : label ∈ activeLabels data star sourceBlock :=
      (mem_activeLabels_iff data star sourceBlock label).2
        ⟨first.1.2, hFirstRel, by
          rw [← hFirstTarget,
            DraismaVargas.LocalCases.W4StableSource.GluingDatum.sourceEdge_self]
          exact hFirstSurvives⟩
    have hFirstCanonical :
        first = data.sourceEdge (star.edge label) sourceBlock.1 := by
      calc
        first = data.sourceEdge first.1.1 first.1.2 :=
          (DraismaVargas.LocalCases.W4StableSource.GluingDatum.sourceEdge_self
            data first).symm
        _ = data.sourceEdge (star.edge label) first.1.2 := by
          rw [hFirstTarget]
        _ = data.sourceEdge (star.edge label) sourceBlock.1 :=
          sourceEdge_eq_anchor_of_blockCountWithin_eq_one data star
            sourceBlock label first.1.2 hFirstRel (hCount label hActive)
    have hSecondCanonical :
        second = data.sourceEdge (star.edge label) sourceBlock.1 := by
      calc
        second = data.sourceEdge second.1.1 second.1.2 :=
          (DraismaVargas.LocalCases.W4StableSource.GluingDatum.sourceEdge_self
            data second).symm
        _ = data.sourceEdge (star.edge label) second.1.2 := by
          rw [hSecondTarget]
        _ = data.sourceEdge (star.edge label) sourceBlock.1 :=
          sourceEdge_eq_anchor_of_blockCountWithin_eq_one data star
            sourceBlock label second.1.2 hSecondRel (hCount label hActive)
    exact hFirstCanonical.trans hSecondCanonical.symm

/-- The occurrence finset left after deleting every dangling source edge. -/
noncomputable def nonDanglingEdges (data : GluingDatum target degree) :
    Finset data.SourceEdge :=
  Finset.univ.filter fun edge ↦ ¬ IsDangling data edge

@[simp] theorem mem_nonDanglingEdges (data : GluingDatum target degree)
    (edge : data.SourceEdge) :
    edge ∈ nonDanglingEdges data ↔ ¬ IsDangling data edge := by
  classical
  simp [nonDanglingEdges]

/-- Surviving quotient-source edge occurrences after deleting all dangling
occurrences. -/
def NonDanglingEdge (data : GluingDatum target degree) :=
  {edge : data.SourceEdge // ¬ IsDangling data edge}

noncomputable instance (data : GluingDatum target degree) :
    Fintype (NonDanglingEdge data) := by
  classical
  exact inferInstanceAs
    (Fintype {edge : data.SourceEdge // ¬ IsDangling data edge})

noncomputable instance (data : GluingDatum target degree) :
    DecidableEq (NonDanglingEdge data) :=
  inferInstanceAs
    (DecidableEq {edge : data.SourceEdge // ¬ IsDangling data edge})

/-- Occurrence-level incidence in the literal quotient source. -/
def Incident (data : GluingDatum target degree)
    (edge : data.SourceEdge) (vertex : data.SourceVertex) : Prop :=
  (data.sourceEnds edge).1 = vertex ∨ (data.sourceEnds edge).2 = vertex

@[simp] theorem incident_left (data : GluingDatum target degree)
    (edge : data.SourceEdge) :
    Incident data edge (data.sourceEnds edge).1 :=
  Or.inl rfl

@[simp] theorem incident_right (data : GluingDatum target degree)
    (edge : data.SourceEdge) :
    Incident data edge (data.sourceEnds edge).2 :=
  Or.inr rfl

/-! ## Degree-one source vertices are dangling -/

/-- The vertices away from a specified leaf, presented as the vertex set of
the corresponding induced subgraph. -/
private noncomputable def complementVertexEquiv
    (G : CFGraph) (leaf : G.V)
    (hDegree : vertex_degree G leaf = 1)
    (hComplement : (Finset.univ \ {leaf} : Finset G.V).Nonempty) :
    (Utilities.Certificate.LeafPruning.deleteLeaf G leaf
      hDegree).V ≃
      (Utilities.inducedSubgraph G (Finset.univ \ {leaf})
        hComplement).V where
  toFun vertex := ⟨vertex.1, by simp [vertex.2]⟩
  invFun vertex := ⟨vertex.1, by
    have hNotMem := (Finset.mem_sdiff.mp vertex.2).2
    simpa using hNotMem⟩
  left_inv vertex := by rfl
  right_inv vertex := by rfl

/-- Deleting a degree-one vertex and inducing on its complement give the
same graph up to the canonical vertex relabelling. -/
private noncomputable def deleteLeafComplementLaplacianEquiv
    (G : CFGraph) (leaf : G.V)
    (hDegree : vertex_degree G leaf = 1)
    (hComplement : (Finset.univ \ {leaf} : Finset G.V).Nonempty) :
    Utilities.Certificate.LaplacianEquiv
      (Utilities.Certificate.LeafPruning.deleteLeaf G leaf hDegree)
      (Utilities.inducedSubgraph G (Finset.univ \ {leaf})
        hComplement) where
  toEquiv := complementVertexEquiv G leaf hDegree hComplement
  num_edges_eq := by
    intro first second
    calc
      num_edges
          (Utilities.inducedSubgraph G (Finset.univ \ {leaf}) hComplement)
          ((complementVertexEquiv G leaf hDegree hComplement) first)
          ((complementVertexEquiv G leaf hDegree hComplement) second) =
          num_edges G first.1 second.1 := by
        exact Utilities.num_edges_inducedSubgraph G
          (Finset.univ \ {leaf}) hComplement
          ((complementVertexEquiv G leaf hDegree hComplement) first)
          ((complementVertexEquiv G leaf hDegree hComplement) second)
      _ = num_edges
          (Utilities.Certificate.LeafPruning.deleteLeaf G leaf hDegree)
          first second := by
        exact (Utilities.Certificate.LeafPruning.num_edges_deleteLeaf
          G leaf hDegree first second).symm

/-- A connected graph stays connected after inducing on the complement of a
degree-one vertex.  This is the exact complement-connectedness receipt needed
by the occurrence-safe dangling definition. -/
private theorem complement_connected_of_degree_one
    (G : CFGraph) (leaf other : G.V) (hOther : other ≠ leaf)
    (hConnected : graph_connected G)
    (hDegree : vertex_degree G leaf = 1) :
    graph_connected
      (Utilities.inducedSubgraph G (Finset.univ \ {leaf})
        ⟨other, by simp [hOther]⟩) := by
  exact
    (deleteLeafComplementLaplacianEquiv G leaf hDegree
      ⟨other, by simp [hOther]⟩).graphConnected
      (Utilities.Certificate.LeafReduction.graph_connected_deleteLeaf
        G leaf hConnected hDegree)

/-- The graph induced on a singleton is connected. -/
private theorem singleton_induced_connected (G : CFGraph) (vertex : G.V) :
    graph_connected
      (Utilities.inducedSubgraph G ({vertex} : Finset G.V)
        (Finset.singleton_nonempty vertex)) := by
  intro subset hSplit
  obtain ⟨first, second, hFirst, hSecond⟩ := hSplit
  have hFirstValue : first.1 = vertex := by simpa using first.2
  have hSecondValue : second.1 = vertex := by simpa using second.2
  have hEqual : first = second :=
    Subtype.ext (hFirstValue.trans hSecondValue.symm)
  exact (hSecond (hEqual ▸ hFirst)).elim

/-- The graph induced on a singleton has genus zero. -/
private theorem singleton_induced_genus_zero (G : CFGraph) (vertex : G.V) :
    genus
      (Utilities.inducedSubgraph G ({vertex} : Finset G.V)
        (Finset.singleton_nonempty vertex)) = 0 := by
  have hEdges :
      G.edges.filter
          (fun edge ↦ edge.1 ∈ ({vertex} : Finset G.V) ∧
            edge.2 ∈ ({vertex} : Finset G.V)) = 0 := by
    apply Multiset.filter_eq_nil.mpr
    intro edge hEdge hEnds
    have hFirst : edge.1 = vertex := by simpa using hEnds.1
    have hSecond : edge.2 = vertex := by simpa using hEnds.2
    have hLoop : edge = (vertex, vertex) := by
      apply Prod.ext
      · exact hFirst
      · exact hSecond
    exact G.loopless vertex (hLoop ▸ hEdge)
  unfold genus
  rw [Utilities.inducedSubgraph_edge_card_eq_filter,
    Utilities.inducedSubgraph_vertex_card, hEdges]
  simp

/-- In a connected graph, an edge incident to a degree-one vertex is an
occurrence-safe dangling edge, with the singleton leaf as its genus-zero
side. -/
private noncomputable def danglingSide_of_degree_one
    (G : CFGraph) (leaf other : G.V)
    (hConnected : graph_connected G)
    (hDegree : vertex_degree G leaf = 1)
    (hAdjacent : 0 < num_edges G leaf other) :
    DanglingSide G leaf other := by
  have hOther : other ≠ leaf := by
    intro hEqual
    subst other
    have hZero := num_edges_self_zero G leaf
    omega
  let leafData :=
    Utilities.Certificate.LeafPruning.leafData G leaf hDegree
  have hOtherRoot : other = leafData.root := by
    by_contra hNe
    have hZero := leafData.count_other other hNe
    omega
  have hMultiplicity : num_edges G leaf other = 1 := by
    rw [hOtherRoot]
    exact leafData.count_root
  let complementNonempty : (Finset.univ \ {leaf} : Finset G.V).Nonempty :=
    ⟨other, by simp [hOther]⟩
  exact
    { side := {leaf}
      left_mem := by simp
      right_not_mem := by simp [hOther]
      cross_num_edges := by
        intro first second hFirst hSecond
        have hFirstEq : first = leaf := by simpa using hFirst
        subst first
        by_cases hSecondEq : second = other
        · subst second
          simpa using hMultiplicity
        · have hSecondRoot : second ≠ leafData.root := by
            intro hRoot
            apply hSecondEq
            exact hRoot.trans hOtherRoot.symm
          rw [leafData.count_other second hSecondRoot]
          simp [hSecondEq]
      side_connected := singleton_induced_connected G leaf
      complement_connected := by
        exact complement_connected_of_degree_one G leaf other hOther
          hConnected hDegree
      side_genus_zero := singleton_induced_genus_zero G leaf }

/-- Every literal quotient-source edge occurs in the edge multiset of its
source graph. -/
theorem sourceEnds_mem_sourceGraph_edges
    (data : GluingDatum target degree) (edge : data.SourceEdge) :
    data.sourceEnds edge ∈ data.sourceGraph.edges := by
  unfold GluingDatum.sourceGraph
  apply Multiset.mem_map.mpr
  exact ⟨edge, by simp, rfl⟩

/-- A literal quotient-source occurrence gives positive edge multiplicity
between its two endpoints. -/
theorem sourceEnds_num_edges_pos
    (data : GluingDatum target degree) (edge : data.SourceEdge) :
    0 < num_edges data.sourceGraph
      (data.sourceEnds edge).1 (data.sourceEnds edge).2 := by
  unfold num_edges
  rw [Multiset.card_pos_iff_exists_mem]
  exact ⟨data.sourceEnds edge,
    Multiset.mem_filter.mpr
      ⟨sourceEnds_mem_sourceGraph_edges data edge, Or.inl rfl⟩⟩

/-- A source edge whose first endpoint has degree one is dangling. -/
theorem isDangling_of_sourceEnds_fst_degree_eq_one
    (data : GluingDatum target degree) (hConnected : data.Connected)
    (edge : data.SourceEdge)
    (hDegree : vertex_degree data.sourceGraph (data.sourceEnds edge).1 = 1) :
    IsDangling data edge := by
  left
  exact ⟨danglingSide_of_degree_one data.sourceGraph
    (data.sourceEnds edge).1 (data.sourceEnds edge).2 hConnected hDegree
    (sourceEnds_num_edges_pos data edge)⟩

/-- A source edge whose second endpoint has degree one is dangling. -/
theorem isDangling_of_sourceEnds_snd_degree_eq_one
    (data : GluingDatum target degree) (hConnected : data.Connected)
    (edge : data.SourceEdge)
    (hDegree : vertex_degree data.sourceGraph (data.sourceEnds edge).2 = 1) :
    IsDangling data edge := by
  right
  exact ⟨danglingSide_of_degree_one data.sourceGraph
    (data.sourceEnds edge).2 (data.sourceEnds edge).1 hConnected hDegree
    (by
      have hForward := sourceEnds_num_edges_pos data edge
      unfold num_edges at hForward ⊢
      simpa only [Or.comm] using hForward)⟩

/-- Neither endpoint of a surviving quotient-source occurrence can have
degree one. -/
theorem sourceEnds_degree_ne_one_of_not_isDangling
    (data : GluingDatum target degree) (hConnected : data.Connected)
    (edge : data.SourceEdge) (hSurvives : ¬ IsDangling data edge) :
    vertex_degree data.sourceGraph (data.sourceEnds edge).1 ≠ 1 ∧
      vertex_degree data.sourceGraph (data.sourceEnds edge).2 ≠ 1 := by
  exact ⟨fun hDegree ↦
      hSurvives (isDangling_of_sourceEnds_fst_degree_eq_one data hConnected
        edge hDegree),
    fun hDegree ↦
      hSurvives (isDangling_of_sourceEnds_snd_degree_eq_one data hConnected
        edge hDegree)⟩

/-- Incidence of a literal source occurrence is exactly target incidence
together with membership of its edge block in the chosen source-vertex
block. -/
theorem incident_iff_target_mem_and_rel
    (data : GluingDatum target degree) (edge : data.SourceEdge)
    (vertex : data.SourceVertex) :
    Incident data edge vertex ↔
      edge.1.1 ∈ GluingDatum.incidentEdges vertex.1.1 ∧
        (data.vertexPartition vertex.1.1).Rel vertex.1.2 edge.1.2 := by
  constructor
  · intro hIncident
    rcases hIncident with hLeft | hRight
    · have hEndpoint :=
        (data.sourceEndpoint_eq_iff
          (edge.1.1 : target.V × target.V).1 edge.1.2 vertex).mp hLeft
      refine ⟨?_, ?_⟩
      · simp [GluingDatum.incidentEdges, hEndpoint.1]
      · simpa [hEndpoint.1] using hEndpoint.2.symm
    · have hEndpoint :=
        (data.sourceEndpoint_eq_iff
          (edge.1.1 : target.V × target.V).2 edge.1.2 vertex).mp hRight
      refine ⟨?_, ?_⟩
      · simp [GluingDatum.incidentEdges, hEndpoint.1]
      · simpa [hEndpoint.1] using hEndpoint.2.symm
  · rintro ⟨hTarget, hRel⟩
    simp only [GluingDatum.incidentEdges, Finset.mem_filter,
      Finset.mem_univ, true_and] at hTarget
    rcases hTarget with hLeft | hRight
    · left
      apply (data.sourceEndpoint_eq_iff
        (edge.1.1 : target.V × target.V).1 edge.1.2 vertex).2
      exact ⟨hLeft, by simpa [hLeft] using hRel.symm⟩
    · right
      apply (data.sourceEndpoint_eq_iff
        (edge.1.1 : target.V × target.V).2 edge.1.2 vertex).2
      exact ⟨hRight, by simpa [hRight] using hRel.symm⟩

/-- Source-edge occurrences incident to one literal quotient-source vertex. -/
def IncidentSourceEdge (data : GluingDatum target degree)
    (vertex : data.SourceVertex) :=
  {edge : data.SourceEdge // Incident data edge vertex}

noncomputable instance (data : GluingDatum target degree)
    (vertex : data.SourceVertex) :
    Fintype (IncidentSourceEdge data vertex) := by
  classical
  exact inferInstanceAs (Fintype {edge : data.SourceEdge //
    Incident data edge vertex})

/-- Incident source occurrences are the edge-partition blocks lying inside
the chosen source-vertex block, fibrewise over incident target occurrences. -/
noncomputable def incidentSourceEdgeEquiv
    (data : GluingDatum target degree) (vertex : data.SourceVertex) :
    IncidentSourceEdge data vertex ≃
      Σ targetEdge : {edge : target.edges //
          edge ∈ GluingDatum.incidentEdges vertex.1.1},
        {fineBlock : (data.edgePartition targetEdge.1).Blocks //
          fineBlock ∈ SheetPartition.blocksWithin
            (data.edgePartition targetEdge.1)
            (data.vertexPartition vertex.1.1)
            ⟨vertex.1.2, vertex.2⟩} where
  toFun sourceEdge := by
    have hIncident :=
      (incident_iff_target_mem_and_rel data sourceEdge.1 vertex).mp
        sourceEdge.2
    let targetEdge : {edge : target.edges //
        edge ∈ GluingDatum.incidentEdges vertex.1.1} :=
      ⟨sourceEdge.1.1.1, hIncident.1⟩
    let fineBlock : (data.edgePartition targetEdge.1).Blocks :=
      ⟨sourceEdge.1.1.2, sourceEdge.1.2⟩
    refine ⟨targetEdge, fineBlock, ?_⟩
    apply (SheetPartition.mem_blocksWithin
      (data.edgePartition targetEdge.1)
      (data.vertexPartition vertex.1.1) ⟨vertex.1.2, vertex.2⟩
      fineBlock).2
    apply (SheetPartition.fineBlockToCoarseBlock_eq_iff_rel
      (data.edgePartition targetEdge.1)
      (data.vertexPartition vertex.1.1) fineBlock
      ⟨vertex.1.2, vertex.2⟩).2
    exact hIncident.2
  invFun item := by
    let sourceEdge : data.SourceEdge :=
      ⟨(item.1.1, item.2.1.1), item.2.1.2⟩
    refine ⟨sourceEdge, ?_⟩
    apply (incident_iff_target_mem_and_rel data sourceEdge vertex).2
    refine ⟨item.1.2, ?_⟩
    apply (SheetPartition.fineBlockToCoarseBlock_eq_iff_rel
      (data.edgePartition item.1.1)
      (data.vertexPartition vertex.1.1) item.2.1
      ⟨vertex.1.2, vertex.2⟩).1
    exact (SheetPartition.mem_blocksWithin
      (data.edgePartition item.1.1)
      (data.vertexPartition vertex.1.1) ⟨vertex.1.2, vertex.2⟩
      item.2.1).1 item.2.2
  left_inv sourceEdge := by
    apply Subtype.ext
    rfl
  right_inv item := by
    rcases item with ⟨targetEdge, fineBlock⟩
    rfl

/-- The number of incident source occurrences is the sum of the edge-block
counts inside the chosen source-vertex block. -/
theorem card_incidentSourceEdge_eq_sum_blockCountWithin
    (data : GluingDatum target degree) (vertex : data.SourceVertex) :
    Fintype.card (IncidentSourceEdge data vertex) =
      ∑ targetEdge ∈ GluingDatum.incidentEdges vertex.1.1,
        (data.edgePartition targetEdge).blockCountWithin
          (data.vertexPartition vertex.1.1) vertex.1.2 := by
  classical
  calc
    Fintype.card (IncidentSourceEdge data vertex) =
        Fintype.card
          (Σ targetEdge : {edge : target.edges //
              edge ∈ GluingDatum.incidentEdges vertex.1.1},
            {fineBlock : (data.edgePartition targetEdge.1).Blocks //
              fineBlock ∈ SheetPartition.blocksWithin
                (data.edgePartition targetEdge.1)
                (data.vertexPartition vertex.1.1)
                ⟨vertex.1.2, vertex.2⟩}) :=
      Fintype.card_congr (incidentSourceEdgeEquiv data vertex)
    _ = ∑ targetEdge : {edge : target.edges //
          edge ∈ GluingDatum.incidentEdges vertex.1.1},
        Fintype.card
          {fineBlock : (data.edgePartition targetEdge.1).Blocks //
            fineBlock ∈ SheetPartition.blocksWithin
              (data.edgePartition targetEdge.1)
              (data.vertexPartition vertex.1.1)
              ⟨vertex.1.2, vertex.2⟩} := by
      rw [Fintype.card_sigma]
    _ = ∑ targetEdge : {edge : target.edges //
          edge ∈ GluingDatum.incidentEdges vertex.1.1},
        (SheetPartition.blocksWithin
          (data.edgePartition targetEdge.1)
          (data.vertexPartition vertex.1.1)
          ⟨vertex.1.2, vertex.2⟩).card := by
      apply Finset.sum_congr rfl
      intro targetEdge _
      rw [Fintype.card_coe]
    _ = ∑ targetEdge : {edge : target.edges //
          edge ∈ GluingDatum.incidentEdges vertex.1.1},
        (data.edgePartition targetEdge.1).blockCountWithin
          (data.vertexPartition vertex.1.1) vertex.1.2 := by
      apply Finset.sum_congr rfl
      intro targetEdge _
      exact SheetPartition.card_blocksWithin_eq_blockCountWithin
        (data.edgePartition targetEdge.1)
        (data.vertexPartition vertex.1.1)
        (by
          exact if hLeft : (targetEdge.1 : target.V × target.V).1 =
              vertex.1.1 then by
            simpa [hLeft] using data.refines_left targetEdge.1
          else by
            have hRight : (targetEdge.1 : target.V × target.V).2 =
                vertex.1.1 := by
              have hIncident := targetEdge.2
              simp only [GluingDatum.incidentEdges, Finset.mem_filter,
                Finset.mem_univ, true_and] at hIncident
              exact hIncident.resolve_left hLeft
            simpa [hRight] using data.refines_right targetEdge.1)
        ⟨vertex.1.2, vertex.2⟩
    _ = ∑ targetEdge ∈ GluingDatum.incidentEdges vertex.1.1,
        (data.edgePartition targetEdge).blockCountWithin
          (data.vertexPartition vertex.1.1) vertex.1.2 := by
      exact (Finset.sum_subtype
        (GluingDatum.incidentEdges vertex.1.1) (by simp)
        (fun targetEdge ↦
          (data.edgePartition targetEdge).blockCountWithin
            (data.vertexPartition vertex.1.1) vertex.1.2)).symm

/-- The graph-theoretic degree of a quotient-source vertex is the number of
literal source-edge occurrences incident to it. -/
theorem vertex_degree_sourceGraph_eq_card_incidentSourceEdge
    (data : GluingDatum target degree) (vertex : data.SourceVertex) :
    vertex_degree data.sourceGraph vertex =
      Fintype.card (IncidentSourceEdge data vertex) := by
  classical
  have hOneOccurrence (edge : data.SourceEdge) :
      (∑ neighbor : data.SourceVertex,
        if data.sourceEnds edge = (vertex, neighbor) ∨
            data.sourceEnds edge = (neighbor, vertex) then (1 : ℤ) else 0) =
        if Incident data edge vertex then 1 else 0 := by
    have hEndsNe :
        (data.sourceEnds edge).1 ≠ (data.sourceEnds edge).2 := by
      intro hEqual
      have hLoop : data.sourceEnds edge =
          ((data.sourceEnds edge).1, (data.sourceEnds edge).1) := by
        apply Prod.ext
        · rfl
        · exact hEqual.symm
      exact data.sourceGraph.loopless (data.sourceEnds edge).1
        (hLoop ▸ sourceEnds_mem_sourceGraph_edges data edge)
    by_cases hIncident : Incident data edge vertex
    · rw [if_pos hIncident]
      rcases hIncident with hLeft | hRight
      · rw [Finset.sum_eq_single (data.sourceEnds edge).2]
        · have hPair : data.sourceEnds edge =
              (vertex, (data.sourceEnds edge).2) := by
            apply Prod.ext
            · exact hLeft
            · rfl
          rw [if_pos (Or.inl hPair)]
        · intro neighbor _ hNeighbor
          have hNoPair :
              ¬ (data.sourceEnds edge = (vertex, neighbor) ∨
                data.sourceEnds edge = (neighbor, vertex)) := by
            rintro (hPair | hPair)
            · exact hNeighbor
                (congrArg Prod.snd hPair).symm
            · have hSecond := congrArg Prod.snd hPair
              exact hEndsNe (hLeft.trans hSecond.symm)
          rw [if_neg hNoPair]
        · intro hNotMem
          exact (hNotMem (Finset.mem_univ _)).elim
      · rw [Finset.sum_eq_single (data.sourceEnds edge).1]
        · have hPair : data.sourceEnds edge =
              ((data.sourceEnds edge).1, vertex) := by
            apply Prod.ext
            · rfl
            · exact hRight
          rw [if_pos (Or.inr hPair)]
        · intro neighbor _ hNeighbor
          have hNoPair :
              ¬ (data.sourceEnds edge = (vertex, neighbor) ∨
                data.sourceEnds edge = (neighbor, vertex)) := by
            rintro (hPair | hPair)
            · have hFirst := congrArg Prod.fst hPair
              exact hEndsNe (hFirst.trans hRight.symm)
            · exact hNeighbor
                (congrArg Prod.fst hPair).symm
          rw [if_neg hNoPair]
        · intro hNotMem
          exact (hNotMem (Finset.mem_univ _)).elim
    · rw [if_neg hIncident]
      apply Finset.sum_eq_zero
      intro neighbor _
      have hNoPair :
          ¬ (data.sourceEnds edge = (vertex, neighbor) ∨
            data.sourceEnds edge = (neighbor, vertex)) := by
        rintro (hPair | hPair)
        · apply hIncident
          left
          exact congrArg Prod.fst hPair
        · apply hIncident
          right
          exact congrArg Prod.snd hPair
      rw [if_neg hNoPair]
  calc
    vertex_degree data.sourceGraph vertex =
        ∑ neighbor : data.SourceVertex,
          (num_edges data.sourceGraph vertex neighbor : ℤ) := by
      rfl
    _ = ∑ neighbor : data.SourceVertex,
        ∑ edge : data.SourceEdge,
          if data.sourceEnds edge = (vertex, neighbor) ∨
              data.sourceEnds edge = (neighbor, vertex) then (1 : ℤ) else 0 := by
      apply Finset.sum_congr rfl
      intro neighbor _
      rw [GluingDatum.SheetRelabeling.num_edges_sourceGraph_eq_sum]
      simp only [Nat.cast_sum, Nat.cast_ite, Nat.cast_one, Nat.cast_zero]
    _ = ∑ edge : data.SourceEdge,
        ∑ neighbor : data.SourceVertex,
          if data.sourceEnds edge = (vertex, neighbor) ∨
              data.sourceEnds edge = (neighbor, vertex) then (1 : ℤ) else 0 := by
      rw [Finset.sum_comm]
    _ = ∑ edge : data.SourceEdge,
        if Incident data edge vertex then 1 else 0 := by
      apply Finset.sum_congr rfl
      intro edge _
      exact hOneOccurrence edge
    _ = Fintype.card (IncidentSourceEdge data vertex) := by
      let incidentEdges :=
        (Finset.univ : Finset data.SourceEdge).filter fun edge ↦
          Incident data edge vertex
      let equivalence : IncidentSourceEdge data vertex ≃
          {edge : data.SourceEdge // edge ∈ incidentEdges} :=
        { toFun := fun edge ↦ ⟨edge.1, by
            exact Finset.mem_filter.mpr
              ⟨Finset.mem_univ edge.1, edge.2⟩⟩
          invFun := fun edge ↦ ⟨edge.1,
            (Finset.mem_filter.mp edge.2).2⟩
          left_inv := fun edge ↦ by rfl
          right_inv := fun edge ↦ by rfl }
      have hCard : Fintype.card (IncidentSourceEdge data vertex) =
          incidentEdges.card := by
        exact (Fintype.card_congr equivalence).trans
          (Fintype.card_coe incidentEdges)
      rw [hCard]
      change (∑ edge : data.SourceEdge,
        if Incident data edge vertex then 1 else 0) =
          (((Finset.univ : Finset data.SourceEdge).filter fun edge ↦
            Incident data edge vertex).card : ℤ)
      rw [Finset.card_filter, Nat.cast_sum]
      apply Finset.sum_congr rfl
      intro edge _
      by_cases hIncident : Incident data edge vertex <;>
        simp [hIncident]

/-- Local ramification is the graph-theoretic source valency residual from
the paper's Riemann--Hurwitz formula. -/
theorem localRamification_eq_vertex_degree
    (data : GluingDatum target degree) (vertex : data.SourceVertex) :
    data.localRamification vertex.1.1 ⟨vertex.1.2, vertex.2⟩ =
      vertex_degree data.sourceGraph vertex - 2 -
        ((data.vertexPartition vertex.1.1).blockCard vertex.1.2 : ℤ) *
          (((GluingDatum.incidentEdges vertex.1.1).card : ℤ) - 2) := by
  unfold GluingDatum.localRamification
  rw [vertex_degree_sourceGraph_eq_card_incidentSourceEdge,
    card_incidentSourceEdge_eq_sum_blockCountWithin]
  norm_cast

/-- Every vertex of a connected nontrivial target has at least one incident
edge occurrence. -/
theorem incidentEdges_card_pos_of_connected
    [Nontrivial target.V] (hConnected : graph_connected target)
    (vertex : target.V) :
    0 < (GluingDatum.incidentEdges vertex).card := by
  obtain ⟨other, hOther⟩ := exists_ne vertex
  have hSplit :
      ∃ inside outside : target.V,
        inside ∈ ({vertex} : Finset target.V) ∧
          outside ∉ ({vertex} : Finset target.V) :=
    ⟨vertex, other, by simp, by simpa using hOther⟩
  obtain ⟨inside, hInside, outside, _hOutside, hAdjacent⟩ :=
    hConnected ({vertex} : Finset target.V) hSplit
  have hInsideEq : inside = vertex := by simpa using hInside
  subst inside
  unfold num_edges at hAdjacent
  change 0 <
    (target.edges.filter
      (fun edge ↦ edge = (vertex, outside) ∨
        edge = (outside, vertex))).card at hAdjacent
  rw [Multiset.card_pos_iff_exists_mem] at hAdjacent
  obtain ⟨rawEdge, hFiltered⟩ := hAdjacent
  obtain ⟨hRawEdge, hEnds⟩ := Multiset.mem_filter.mp hFiltered
  let edge : target.edges :=
    ⟨rawEdge, ⟨0, Multiset.count_pos.mpr hRawEdge⟩⟩
  apply Finset.card_pos.mpr
  refine ⟨edge, ?_⟩
  simp only [GluingDatum.incidentEdges, Finset.mem_filter,
    Finset.mem_univ, true_and]
  rcases hEnds with hForward | hBackward
  · left
    exact congrArg Prod.fst hForward
  · right
    exact congrArg Prod.snd hBackward

/-- No target-edge fibre is entirely deleted as dangling: each target
occurrence has at least one surviving literal source occurrence above it. -/
def NoDanglingTargetFibres (data : GluingDatum target degree) : Prop :=
  ∀ targetEdge : target.edges,
    ∃ sourceEdge : data.SourceEdge,
      sourceEdge.1.1 = targetEdge ∧ ¬ IsDangling data sourceEdge

/-- The source's exact combinatorial-type conditions in the gluing-datum
model: no dangling target fibre, and positive change at every divalent target
vertex. -/
structure CombinatorialType (data : GluingDatum target degree) : Prop where
  noDanglingTargetFibres : NoDanglingTargetFibres data
  divalentChangePositive : ∀ vertex : target.V,
    (GluingDatum.incidentEdges vertex).card = 2 →
      1 ≤ data.targetChange vertex

/-- Each endpoint of a literal source occurrence has positive graph-theoretic
degree. -/
theorem sourceEnds_vertex_degree_pos
    (data : GluingDatum target degree) (edge : data.SourceEdge) :
    0 < vertex_degree data.sourceGraph (data.sourceEnds edge).1 ∧
      0 < vertex_degree data.sourceGraph (data.sourceEnds edge).2 := by
  have hAdjacent := sourceEnds_num_edges_pos data edge
  constructor
  · unfold vertex_degree
    have hLe :
        (num_edges data.sourceGraph
          (data.sourceEnds edge).1 (data.sourceEnds edge).2 : ℤ) ≤
          ∑ neighbor : data.SourceVertex,
            (num_edges data.sourceGraph
              (data.sourceEnds edge).1 neighbor : ℤ) := by
      exact Finset.single_le_sum
        (f := fun neighbor : data.SourceVertex ↦
          (num_edges data.sourceGraph
            (data.sourceEnds edge).1 neighbor : ℤ))
        (fun neighbor _ ↦ by positivity)
        (Finset.mem_univ (data.sourceEnds edge).2)
    exact lt_of_lt_of_le (by exact_mod_cast hAdjacent) hLe
  · unfold vertex_degree
    have hAdjacentReverse :
        0 < num_edges data.sourceGraph
          (data.sourceEnds edge).2 (data.sourceEnds edge).1 := by
      unfold num_edges at hAdjacent ⊢
      simpa only [Or.comm] using hAdjacent
    have hLe :
        (num_edges data.sourceGraph
          (data.sourceEnds edge).2 (data.sourceEnds edge).1 : ℤ) ≤
          ∑ neighbor : data.SourceVertex,
            (num_edges data.sourceGraph
              (data.sourceEnds edge).2 neighbor : ℤ) := by
      exact Finset.single_le_sum
        (f := fun neighbor : data.SourceVertex ↦
          (num_edges data.sourceGraph
            (data.sourceEnds edge).2 neighbor : ℤ))
        (fun neighbor _ ↦ by positivity)
        (Finset.mem_univ (data.sourceEnds edge).1)
    exact lt_of_lt_of_le (by exact_mod_cast hAdjacentReverse) hLe

/-- At a target leaf, absence of a dangling target fibre forces change at
least two.  This is the monovalent case of the source's
`ch(v) + val(v) ≥ 3` lemma. -/
theorem targetChange_ge_two_of_target_leaf
    (data : GluingDatum target degree) (hValid : data.Valid)
    (hNoDangling : NoDanglingTargetFibres data) (vertex : target.V)
    (hLeaf : (GluingDatum.incidentEdges vertex).card = 1) :
    2 ≤ data.targetChange vertex := by
  classical
  obtain ⟨targetEdge, hIncidentEdges⟩ :=
    Finset.card_eq_one.mp hLeaf
  obtain ⟨sourceEdge, hTargetEdge, hSurvives⟩ :=
    hNoDangling targetEdge
  let sourceVertex : data.SourceVertex :=
    data.sourceEndpoint vertex sourceEdge.1.2
  let sourceBlock : (data.vertexPartition vertex).Blocks :=
    ⟨sourceVertex.1.2, sourceVertex.2⟩
  have hTargetIncident :
      sourceEdge.1.1 ∈ GluingDatum.incidentEdges vertex := by
    rw [hTargetEdge, hIncidentEdges]
    simp
  have hSourceIncident : Incident data sourceEdge sourceVertex := by
    apply (incident_iff_target_mem_and_rel data sourceEdge sourceVertex).2
    refine ⟨?_, ?_⟩
    · change sourceEdge.1.1 ∈ GluingDatum.incidentEdges vertex
      exact hTargetIncident
    · change (data.vertexPartition vertex).Rel
        ((data.vertexPartition vertex).repr sourceEdge.1.2)
          sourceEdge.1.2
      exact (data.vertexPartition vertex).rel_repr_left sourceEdge.1.2
  have hSourceDegreePositive :
      0 < vertex_degree data.sourceGraph sourceVertex := by
    rcases hSourceIncident with hFirst | hSecond
    · rw [← hFirst]
      exact (sourceEnds_vertex_degree_pos data sourceEdge).1
    · rw [← hSecond]
      exact (sourceEnds_vertex_degree_pos data sourceEdge).2
  have hSourceDegreeNeOne :
      vertex_degree data.sourceGraph sourceVertex ≠ 1 := by
    intro hDegree
    apply hSurvives
    rcases hSourceIncident with hFirst | hSecond
    · apply isDangling_of_sourceEnds_fst_degree_eq_one data hValid.1
        sourceEdge
      rw [hFirst]
      exact hDegree
    · apply isDangling_of_sourceEnds_snd_degree_eq_one data hValid.1
        sourceEdge
      rw [hSecond]
      exact hDegree
  have hSourceDegreeAtLeastTwo :
      2 ≤ vertex_degree data.sourceGraph sourceVertex := by
    omega
  have hRefines :
      (data.edgePartition targetEdge).Refines
        (data.vertexPartition vertex) := by
    have hIncident : targetEdge ∈ GluingDatum.incidentEdges vertex := by
      rw [hIncidentEdges]
      simp
    simp only [GluingDatum.incidentEdges, Finset.mem_filter,
      Finset.mem_univ, true_and] at hIncident
    rcases hIncident with hLeft | hRight
    · simpa [hLeft] using data.refines_left targetEdge
    · simpa [hRight] using data.refines_right targetEdge
  have hDegreeEqBlockCount :
      vertex_degree data.sourceGraph sourceVertex =
        (data.edgePartition targetEdge).blockCountWithin
          (data.vertexPartition vertex) sourceBlock.1 := by
    rw [vertex_degree_sourceGraph_eq_card_incidentSourceEdge,
      card_incidentSourceEdge_eq_sum_blockCountWithin]
    simp [sourceVertex, sourceBlock, GluingDatum.sourceEndpoint,
      hIncidentEdges]
  have hBlockCountLeBlockCard :
      (data.edgePartition targetEdge).blockCountWithin
          (data.vertexPartition vertex) sourceBlock.1 ≤
        (data.vertexPartition vertex).blockCard sourceBlock.1 :=
    SheetPartition.blockCountWithin_le_blockCard
      (data.edgePartition targetEdge) (data.vertexPartition vertex)
      hRefines sourceBlock
  have hSourceDegreeLeBlockCard :
      vertex_degree data.sourceGraph sourceVertex ≤
        ((data.vertexPartition vertex).blockCard sourceBlock.1 : ℤ) := by
    rw [hDegreeEqBlockCount]
    exact_mod_cast hBlockCountLeBlockCard
  have hRamification :
      2 ≤ data.localRamification vertex sourceBlock := by
    have hFormula := localRamification_eq_vertex_degree data sourceVertex
    change data.localRamification vertex sourceBlock =
      vertex_degree data.sourceGraph sourceVertex - 2 -
        ((data.vertexPartition vertex).blockCard sourceBlock.1 : ℤ) *
          (((GluingDatum.incidentEdges vertex).card : ℤ) - 2) at hFormula
    rw [hFormula, hLeaf]
    norm_num
    omega
  calc
    2 ≤ data.localRamification vertex sourceBlock := hRamification
    _ ≤ data.targetChange vertex := by
      unfold GluingDatum.targetChange
      exact Finset.single_le_sum
        (fun block _ ↦ data.localRamification_nonneg vertex
          (hValid.2 vertex) block)
        (Finset.mem_univ sourceBlock)

/-- The exact combinatorial-type conditions imply nonnegativity of every
dimension correction term.  This is the kernel-checked gluing-datum form of
the source's `ch(v) + val(v) ≥ 3` lemma. -/
theorem CombinatorialType.correctionNonnegative
    [Nontrivial target.V] {data : GluingDatum target degree}
    (combinatorialType : CombinatorialType data)
    (hValid : data.Valid) (hTargetConnected : graph_connected target) :
    data.CorrectionNonnegative := by
  intro vertex
  have hValencyPositive :=
    incidentEdges_card_pos_of_connected hTargetConnected vertex
  by_cases hLeaf : (GluingDatum.incidentEdges vertex).card = 1
  · have hChange := targetChange_ge_two_of_target_leaf data hValid
      combinatorialType.noDanglingTargetFibres vertex hLeaf
    unfold GluingDatum.targetExcess
    omega
  · by_cases hDivalent :
        (GluingDatum.incidentEdges vertex).card = 2
    · have hChange :=
        combinatorialType.divalentChangePositive vertex hDivalent
      unfold GluingDatum.targetExcess
      omega
    · have hChange := data.targetChange_nonneg hValid vertex
      unfold GluingDatum.targetExcess
      omega

/-- Valency after deleting dangling occurrences, counted with occurrence
multiplicity. -/
noncomputable def nonDanglingValency (data : GluingDatum target degree)
    (vertex : data.SourceVertex) : ℕ := by
  classical
  exact
    ((Finset.univ : Finset data.SourceEdge).filter fun edge ↦
      ¬ IsDangling data edge ∧ Incident data edge vertex).card

/-- The quotient-source vertex represented by one old wall block. -/
def WallBlock.sourceVertex
    (data : GluingDatum target degree) (wall : target.V)
    (sourceBlock : WallBlock data wall) : data.SourceVertex :=
  data.sourceEndpoint wall sourceBlock.1

/-- The occurrence-safe wall-block form of the paper's no-return condition:
every block with a surviving incident occurrence maps to at least two distinct
target-star branches. -/
def NonDanglingNoReturn
    {wall : target.V}
    (data : GluingDatum target degree)
    (star : W4TargetPairings.FourStar target wall) : Prop :=
  ∀ sourceBlock : WallBlock data wall,
    nonDanglingValency data
        (WallBlock.sourceVertex data wall sourceBlock) ≠ 0 →
      2 ≤ (activeLabels data star sourceBlock).card

/-- Incidence at a wall-block source vertex is exactly incidence of the
target occurrence at the wall together with membership in that sheet block. -/
theorem incident_wallBlock_sourceVertex_iff
    {wall : target.V}
    (data : GluingDatum target degree)
    (sourceBlock : WallBlock data wall) (edge : data.SourceEdge) :
    Incident data edge (WallBlock.sourceVertex data wall sourceBlock) ↔
      edge.1.1 ∈ GluingDatum.incidentEdges wall ∧
        WallBlock.ofSheet data wall edge.1.2 = sourceBlock := by
  constructor
  · intro hIncident
    rcases hIncident with hLeft | hRight
    · have hEndpoint :=
        (data.sourceEndpoint_eq_iff
          (edge.1.1 : target.V × target.V).1 edge.1.2
          (WallBlock.sourceVertex data wall sourceBlock)).mp hLeft
      have hTarget : (edge.1.1 : target.V × target.V).1 = wall :=
        by simpa [WallBlock.sourceVertex, GluingDatum.sourceEndpoint] using
          hEndpoint.1
      have hEndpointSheet :
          (data.vertexPartition (edge.1.1 : target.V × target.V).1).Rel
            edge.1.2 sourceBlock.1 := by
        simpa [WallBlock.sourceVertex, GluingDatum.sourceEndpoint,
          sourceBlock.2] using hEndpoint.2
      have hSheet :
          (data.vertexPartition wall).Rel sourceBlock.1 edge.1.2 := by
        have hEndpointSheet' :
            (data.vertexPartition wall).Rel edge.1.2 sourceBlock.1 := by
          simpa [hTarget] using hEndpointSheet
        exact hEndpointSheet'.symm
      exact ⟨by simp [GluingDatum.incidentEdges, hTarget],
        (WallBlock.ofSheet_eq_iff_rel data wall sourceBlock edge.1.2).2
          hSheet⟩
    · have hEndpoint :=
        (data.sourceEndpoint_eq_iff
          (edge.1.1 : target.V × target.V).2 edge.1.2
          (WallBlock.sourceVertex data wall sourceBlock)).mp hRight
      have hTarget : (edge.1.1 : target.V × target.V).2 = wall :=
        by simpa [WallBlock.sourceVertex, GluingDatum.sourceEndpoint] using
          hEndpoint.1
      have hEndpointSheet :
          (data.vertexPartition (edge.1.1 : target.V × target.V).2).Rel
            edge.1.2 sourceBlock.1 := by
        simpa [WallBlock.sourceVertex, GluingDatum.sourceEndpoint,
          sourceBlock.2] using hEndpoint.2
      have hSheet :
          (data.vertexPartition wall).Rel sourceBlock.1 edge.1.2 := by
        have hEndpointSheet' :
            (data.vertexPartition wall).Rel edge.1.2 sourceBlock.1 := by
          simpa [hTarget] using hEndpointSheet
        exact hEndpointSheet'.symm
      exact ⟨by simp [GluingDatum.incidentEdges, hTarget],
        (WallBlock.ofSheet_eq_iff_rel data wall sourceBlock edge.1.2).2
          hSheet⟩
  · rintro ⟨hTarget, hBlock⟩
    have hSheet :=
      (WallBlock.ofSheet_eq_iff_rel data wall sourceBlock edge.1.2).1 hBlock
    simp only [GluingDatum.incidentEdges, Finset.mem_filter,
      Finset.mem_univ, true_and] at hTarget
    rcases hTarget with hLeft | hRight
    · left
      apply (data.sourceEndpoint_eq_iff
        (edge.1.1 : target.V × target.V).1 edge.1.2
        (WallBlock.sourceVertex data wall sourceBlock)).2
      exact ⟨hLeft, by
        simpa [hLeft, WallBlock.sourceVertex, GluingDatum.sourceEndpoint,
          sourceBlock.2] using hSheet.symm⟩
    · right
      apply (data.sourceEndpoint_eq_iff
        (edge.1.1 : target.V × target.V).2 edge.1.2
        (WallBlock.sourceVertex data wall sourceBlock)).2
      exact ⟨hRight, by
        simpa [hRight, WallBlock.sourceVertex, GluingDatum.sourceEndpoint,
          sourceBlock.2] using hSheet.symm⟩

/-- Surviving source-edge occurrences incident to one old wall block. -/
def NonDanglingIncidentEdge
    (data : GluingDatum target degree) (wall : target.V)
    (sourceBlock : WallBlock data wall) :=
  {edge : data.SourceEdge //
    ¬ IsDangling data edge ∧
      Incident data edge (WallBlock.sourceVertex data wall sourceBlock)}

noncomputable instance
    (data : GluingDatum target degree) (wall : target.V)
    (sourceBlock : WallBlock data wall) :
    Fintype (NonDanglingIncidentEdge data wall sourceBlock) := by
  classical
  exact inferInstanceAs (Fintype {edge : data.SourceEdge //
    ¬ IsDangling data edge ∧
      Incident data edge (WallBlock.sourceVertex data wall sourceBlock)})

/-- The unique four-star label below one surviving incident occurrence. -/
noncomputable def NonDanglingIncidentEdge.starLabel
    {wall : target.V}
    {data : GluingDatum target degree}
    (star : W4TargetPairings.FourStar target wall)
    {sourceBlock : WallBlock data wall}
    (edge : NonDanglingIncidentEdge data wall sourceBlock) : Fin 4 :=
  star.label.symm ⟨edge.1.1.1,
    ((incident_wallBlock_sourceVertex_iff data sourceBlock edge.1).mp
      edge.2.2).1⟩

@[simp] theorem NonDanglingIncidentEdge.edge_starLabel
    {wall : target.V}
    {data : GluingDatum target degree}
    (star : W4TargetPairings.FourStar target wall)
    {sourceBlock : WallBlock data wall}
    (edge : NonDanglingIncidentEdge data wall sourceBlock) :
    star.edge (edge.starLabel star) = edge.1.1.1 := by
  exact congrArg Subtype.val (star.label.apply_symm_apply
    ⟨edge.1.1.1,
      ((incident_wallBlock_sourceVertex_iff data sourceBlock edge.1).mp
        edge.2.2).1⟩)

theorem NonDanglingIncidentEdge.wallBlock
    {wall : target.V}
    {data : GluingDatum target degree}
    {sourceBlock : WallBlock data wall}
    (edge : NonDanglingIncidentEdge data wall sourceBlock) :
    WallBlock.ofSheet data wall edge.1.1.2 = sourceBlock :=
  ((incident_wallBlock_sourceVertex_iff data sourceBlock edge.1).mp
    edge.2.2).2

theorem NonDanglingIncidentEdge.starLabel_mem_activeLabels
    {wall : target.V}
    {data : GluingDatum target degree}
    (star : W4TargetPairings.FourStar target wall)
    {sourceBlock : WallBlock data wall}
    (edge : NonDanglingIncidentEdge data wall sourceBlock) :
    edge.starLabel star ∈ activeLabels data star sourceBlock := by
  apply (mem_activeLabels_iff data star sourceBlock _).2
  refine ⟨edge.1.1.2,
    (WallBlock.ofSheet_eq_iff_rel data wall sourceBlock edge.1.1.2).1
      edge.wallBlock, ?_⟩
  rw [edge.edge_starLabel star]
  rw [DraismaVargas.LocalCases.W4StableSource.GluingDatum.sourceEdge_self
    data edge.1]
  exact edge.2.1

/-- No-return injectivity makes the target-star label injective on the
surviving source neighbourhood. -/
theorem NonDanglingIncidentEdge.starLabel_injective
    {wall : target.V}
    {data : GluingDatum target degree}
    (star : W4TargetPairings.FourStar target wall)
    {sourceBlock : WallBlock data wall}
    (hInjective : NonDanglingStarInjective data star sourceBlock) :
    Function.Injective
      (fun edge : NonDanglingIncidentEdge data wall sourceBlock ↦
        edge.starLabel star) := by
  intro first second hLabel
  apply Subtype.ext
  apply hInjective.unique (first.starLabel star) first.1 second.1
  · exact first.wallBlock
  · exact second.wallBlock
  · exact (first.edge_starLabel star).symm
  · exact (second.edge_starLabel star).symm.trans
      (congrArg star.edge hLabel.symm)
  · exact first.2.1
  · exact second.2.1

/-- Every literal active label is hit by a surviving incident occurrence. -/
theorem NonDanglingIncidentEdge.starLabel_surjective
    {wall : target.V}
    {data : GluingDatum target degree}
    (star : W4TargetPairings.FourStar target wall)
    (sourceBlock : WallBlock data wall) :
    Function.Surjective
      (fun edge : NonDanglingIncidentEdge data wall sourceBlock ↦
        (⟨edge.starLabel star,
          edge.starLabel_mem_activeLabels star⟩ :
            {label // label ∈ activeLabels data star sourceBlock})) := by
  intro label
  let sheet := activeWitnessSheet data star sourceBlock label.1 label.2
  let edge := data.sourceEdge (star.edge label.1) sheet
  have hBlock : WallBlock.ofSheet data wall edge.1.2 = sourceBlock :=
    WallBlock.ofSourceEdge_eq_of_rel data star sourceBlock label.1 sheet
      (activeSheet_rel data star sourceBlock label.1 label.2)
  have hIncident :
      Incident data edge (WallBlock.sourceVertex data wall sourceBlock) :=
    (incident_wallBlock_sourceVertex_iff data sourceBlock edge).2
      ⟨star.edge_mem_incidentEdges label.1, hBlock⟩
  let occurrence : NonDanglingIncidentEdge data wall sourceBlock :=
    ⟨edge, activeSheet_survives data star sourceBlock label.1 label.2,
      hIncident⟩
  refine ⟨occurrence, ?_⟩
  apply Subtype.ext
  apply star.edge_injective
  rw [occurrence.edge_starLabel star]
  rfl

/-- Under no-return injectivity, literal active labels are in bijection with
the surviving source-edge occurrences incident to the wall block. -/
noncomputable def activeLabelEquivNonDanglingIncidentEdge
    {wall : target.V}
    {data : GluingDatum target degree}
    (star : W4TargetPairings.FourStar target wall)
    (sourceBlock : WallBlock data wall)
    (hInjective : NonDanglingStarInjective data star sourceBlock) :
    NonDanglingIncidentEdge data wall sourceBlock ≃
      {label // label ∈ activeLabels data star sourceBlock} :=
  Equiv.ofBijective
    (fun edge ↦ ⟨edge.starLabel star,
      edge.starLabel_mem_activeLabels star⟩)
    ⟨fun _ _ h ↦
      NonDanglingIncidentEdge.starLabel_injective star hInjective
        (congrArg Subtype.val h),
      NonDanglingIncidentEdge.starLabel_surjective star sourceBlock⟩

/-- The subtype of surviving incident occurrences has cardinality equal to
the non-dangling valency defined above. -/
theorem card_nonDanglingIncidentEdge_eq_nonDanglingValency
    (data : GluingDatum target degree) (wall : target.V)
    (sourceBlock : WallBlock data wall) :
    Fintype.card (NonDanglingIncidentEdge data wall sourceBlock) =
      nonDanglingValency data
        (WallBlock.sourceVertex data wall sourceBlock) := by
  classical
  let edges := (Finset.univ : Finset data.SourceEdge).filter fun edge ↦
    ¬ IsDangling data edge ∧
      Incident data edge (WallBlock.sourceVertex data wall sourceBlock)
  let equivalence : NonDanglingIncidentEdge data wall sourceBlock ≃
      {edge // edge ∈ edges} := {
    toFun edge := ⟨edge.1, by
      exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, edge.2⟩⟩
    invFun edge := ⟨edge.1, by
      exact (Finset.mem_filter.mp edge.2).2⟩
    left_inv edge := by rfl
    right_inv edge := by rfl }
  calc
    Fintype.card (NonDanglingIncidentEdge data wall sourceBlock) =
        Fintype.card {edge // edge ∈ edges} :=
      Fintype.card_congr equivalence
    _ = edges.card := Fintype.card_coe edges
    _ = nonDanglingValency data
          (WallBlock.sourceVertex data wall sourceBlock) := by
      rfl

/-- Active target labels cannot outnumber the surviving incident source-edge
occurrences that map to them. -/
theorem card_activeLabels_le_nonDanglingValency
    {wall : target.V}
    (data : GluingDatum target degree)
    (star : W4TargetPairings.FourStar target wall)
    (sourceBlock : WallBlock data wall) :
    (activeLabels data star sourceBlock).card ≤
      nonDanglingValency data
        (WallBlock.sourceVertex data wall sourceBlock) := by
  calc
    (activeLabels data star sourceBlock).card =
        Fintype.card
          {label // label ∈ activeLabels data star sourceBlock} := by
      rw [Fintype.card_coe]
    _ ≤ Fintype.card
          (NonDanglingIncidentEdge data wall sourceBlock) :=
      Fintype.card_le_of_surjective
        (fun edge : NonDanglingIncidentEdge data wall sourceBlock ↦
          (⟨edge.starLabel star,
            edge.starLabel_mem_activeLabels star⟩ :
              {label // label ∈ activeLabels data star sourceBlock}))
        (NonDanglingIncidentEdge.starLabel_surjective star sourceBlock)
    _ = nonDanglingValency data
          (WallBlock.sourceVertex data wall sourceBlock) :=
      card_nonDanglingIncidentEdge_eq_nonDanglingValency data wall sourceBlock

/-- A positive surviving valency supplies an actual active target-star label. -/
theorem activeLabels_card_pos_of_nonDanglingValency_pos
    {wall : target.V}
    (data : GluingDatum target degree)
    (star : W4TargetPairings.FourStar target wall)
    (sourceBlock : WallBlock data wall)
    (hPositive : 0 < nonDanglingValency data
      (WallBlock.sourceVertex data wall sourceBlock)) :
    0 < (activeLabels data star sourceBlock).card := by
  have hOccurrenceCard :
      0 < Fintype.card (NonDanglingIncidentEdge data wall sourceBlock) := by
    rw [card_nonDanglingIncidentEdge_eq_nonDanglingValency]
    exact hPositive
  let ⟨occurrence⟩ := Fintype.card_pos_iff.mp hOccurrenceCard
  exact Finset.card_pos.mpr
    ⟨occurrence.starLabel star,
      occurrence.starLabel_mem_activeLabels star⟩

/-- At local ramification zero, a wall block with exactly one active target
branch has exactly one surviving incident occurrence.  This is the r0
specialization of the paper's no-return argument. -/
theorem nonDanglingValency_eq_one_of_activeLabels_card_eq_one
    {wall : target.V}
    (data : GluingDatum target degree)
    (star : W4TargetPairings.FourStar target wall)
    (hValid : data.Valid)
    (hDanglingNoGlue : DanglingEdgeNoGlue data)
    (hChangeZero :
      ∑ sourceBlock : WallBlock data wall,
        AuxR0Profile.wallBlockRamification data star sourceBlock = 0)
    (sourceBlock : WallBlock data wall)
    (hOne : (activeLabels data star sourceBlock).card = 1) :
    nonDanglingValency data
        (WallBlock.sourceVertex data wall sourceBlock) = 1 := by
  classical
  obtain ⟨only, hActive⟩ := Finset.card_eq_one.mp hOne
  let value : Fin 4 → ℤ := fun label ↦
    ((data.edgePartition (star.edge label)).blockCountWithin
      (data.vertexPartition wall) sourceBlock.1 : ℤ)
  let blockSize : ℤ :=
    ((data.vertexPartition wall).blockCard sourceBlock.1 : ℤ)
  have hActiveFilter :
      (Finset.univ : Finset (Fin 4)).filter
          (fun label ↦ label ∈ activeLabels data star sourceBlock) =
        activeLabels data star sourceBlock := by
    ext label
    simp
  have hInactiveCard :
      ((Finset.univ : Finset (Fin 4)).filter
        fun label ↦ label ∉ activeLabels data star sourceBlock).card = 3 := by
    rw [hActive]
    simp only [Finset.mem_singleton]
    change ((Finset.univ : Finset (Fin 4)).filter
      (fun label ↦ label ≠ only)).card = 3
    rw [Finset.filter_ne', Finset.card_erase_of_mem (Finset.mem_univ only)]
    decide +kernel
  have hInactiveSum :
      (∑ label ∈ (Finset.univ : Finset (Fin 4)).filter
        (fun label ↦ label ∉ activeLabels data star sourceBlock),
          value label) = 3 * blockSize := by
    calc
      (∑ label ∈ (Finset.univ : Finset (Fin 4)).filter
          (fun label ↦ label ∉ activeLabels data star sourceBlock),
            value label) =
          ∑ _label ∈ (Finset.univ : Finset (Fin 4)).filter
            (fun label ↦ label ∉ activeLabels data star sourceBlock),
              blockSize := by
        apply Finset.sum_congr rfl
        intro label hLabel
        have hInactive := (Finset.mem_filter.mp hLabel).2
        dsimp only [value, blockSize]
        exact_mod_cast
          blockCountWithin_eq_blockCard_of_not_mem_activeLabels data star
            hDanglingNoGlue sourceBlock label hInactive
      _ = 3 * blockSize := by
        rw [Finset.sum_const, hInactiveCard]
        simp
  have hActiveSum :
      (∑ label ∈ activeLabels data star sourceBlock, value label) =
        value only := by
    rw [hActive]
    simp
  have hPartition := Finset.sum_filter_add_sum_filter_not
    (Finset.univ : Finset (Fin 4))
      (fun label ↦ label ∈ activeLabels data star sourceBlock) value
  rw [hActiveFilter, hInactiveSum, hActiveSum] at hPartition
  have hZero := AuxR0Profile.wallBlockRamification_eq_zero_of_sum_eq_zero
    (hValid.2 wall) hChangeZero sourceBlock
  change (∑ label : Fin 4, value label) - 2 * blockSize - 2 = 0 at hZero
  have hOnlyPositive : 1 ≤ value only := by
    have hNat := (data.edgePartition
      (star.edge only)).blockCountWithin_pos
        (data.vertexPartition wall) sourceBlock.1
    dsimp only [value]
    exact_mod_cast hNat
  have hBlockSizePositive : 1 ≤ blockSize := by
    have hNat := (data.vertexPartition wall).blockCard_pos sourceBlock.1
    dsimp only [blockSize]
    exact_mod_cast hNat
  have hOnlyCountInt : value only = 1 := by omega
  have hOnlyCount :
      (data.edgePartition (star.edge only)).blockCountWithin
        (data.vertexPartition wall) sourceBlock.1 = 1 := by
    dsimp only [value] at hOnlyCountInt
    exact_mod_cast hOnlyCountInt
  have hInjective :=
    nonDanglingStarInjective_of_active_blockCountWithin_eq_one data star
      sourceBlock (by
        intro label hLabel
        have hLabelEq : label = only := by
          rw [hActive] at hLabel
          simpa using hLabel
        subst label
        exact hOnlyCount)
  calc
    nonDanglingValency data
        (WallBlock.sourceVertex data wall sourceBlock) =
        Fintype.card (NonDanglingIncidentEdge data wall sourceBlock) :=
      (card_nonDanglingIncidentEdge_eq_nonDanglingValency data wall
        sourceBlock).symm
    _ = Fintype.card
        {label // label ∈ activeLabels data star sourceBlock} :=
      Fintype.card_congr
        (activeLabelEquivNonDanglingIncidentEdge star sourceBlock hInjective)
    _ = (activeLabels data star sourceBlock).card := Fintype.card_coe _
    _ = 1 := hOne

/-- Equality between the active-label count and surviving valency forces the
target-star labelling to be injective on the surviving neighbourhood. -/
theorem nonDanglingStarInjective_of_card_activeLabels_eq_nonDanglingValency
    {wall : target.V}
    (data : GluingDatum target degree)
    (star : W4TargetPairings.FourStar target wall)
    (sourceBlock : WallBlock data wall)
    (hCard : (activeLabels data star sourceBlock).card =
      nonDanglingValency data
        (WallBlock.sourceVertex data wall sourceBlock)) :
    NonDanglingStarInjective data star sourceBlock := by
  let labelOf : NonDanglingIncidentEdge data wall sourceBlock →
      {label // label ∈ activeLabels data star sourceBlock} :=
    fun edge ↦ ⟨edge.starLabel star,
      edge.starLabel_mem_activeLabels star⟩
  have hSurjective : Function.Surjective labelOf :=
    NonDanglingIncidentEdge.starLabel_surjective star sourceBlock
  have hTypeCard :
      Fintype.card (NonDanglingIncidentEdge data wall sourceBlock) =
        Fintype.card
          {label // label ∈ activeLabels data star sourceBlock} := by
    rw [card_nonDanglingIncidentEdge_eq_nonDanglingValency,
      Fintype.card_coe, hCard]
  have hInjective : Function.Injective labelOf :=
    ((Fintype.bijective_iff_surjective_and_card labelOf).2
      ⟨hSurjective, hTypeCard⟩).1
  constructor
  intro label first second hFirstBlock hSecondBlock hFirstTarget
    hSecondTarget hFirstSurvives hSecondSurvives
  have hFirstIncident :
      Incident data first (WallBlock.sourceVertex data wall sourceBlock) :=
    (incident_wallBlock_sourceVertex_iff data sourceBlock first).2
      ⟨by rw [hFirstTarget]; exact star.edge_mem_incidentEdges label,
        hFirstBlock⟩
  have hSecondIncident :
      Incident data second (WallBlock.sourceVertex data wall sourceBlock) :=
    (incident_wallBlock_sourceVertex_iff data sourceBlock second).2
      ⟨by rw [hSecondTarget]; exact star.edge_mem_incidentEdges label,
        hSecondBlock⟩
  let firstOccurrence : NonDanglingIncidentEdge data wall sourceBlock :=
    ⟨first, hFirstSurvives, hFirstIncident⟩
  let secondOccurrence : NonDanglingIncidentEdge data wall sourceBlock :=
    ⟨second, hSecondSurvives, hSecondIncident⟩
  have hLabels : labelOf firstOccurrence = labelOf secondOccurrence := by
    apply Subtype.ext
    apply star.edge_injective
    rw [firstOccurrence.edge_starLabel star,
      secondOccurrence.edge_starLabel star, hFirstTarget, hSecondTarget]
  exact congrArg Subtype.val (hInjective hLabels)

/-- Under local no-return injectivity, the active-label count is exactly the
non-dangling valency of the corresponding source vertex. -/
theorem card_activeLabels_eq_nonDanglingValency
    {wall : target.V}
    (data : GluingDatum target degree)
    (star : W4TargetPairings.FourStar target wall)
    (sourceBlock : WallBlock data wall)
    (hInjective : NonDanglingStarInjective data star sourceBlock) :
    (activeLabels data star sourceBlock).card =
      nonDanglingValency data
        (WallBlock.sourceVertex data wall sourceBlock) := by
  calc
    (activeLabels data star sourceBlock).card =
        Fintype.card
          {label // label ∈ activeLabels data star sourceBlock} := by
      rw [Fintype.card_coe]
    _ = Fintype.card
          (NonDanglingIncidentEdge data wall sourceBlock) := by
      exact Fintype.card_congr
        (activeLabelEquivNonDanglingIncidentEdge star sourceBlock
          hInjective).symm
    _ = nonDanglingValency data
          (WallBlock.sourceVertex data wall sourceBlock) :=
      card_nonDanglingIncidentEdge_eq_nonDanglingValency data wall sourceBlock

/-- The paper's local non-dangling-valency theorem supplies the exact
two-or-three active-cardinality field for a non-dangling W4 block. -/
theorem activeLabels_card_two_or_three_of_nonDanglingValency
    {wall : target.V}
    (data : GluingDatum target degree)
    (star : W4TargetPairings.FourStar target wall)
    (hInjective : ∀ sourceBlock : WallBlock data wall,
      NonDanglingStarInjective data star sourceBlock)
    (hValency : ∀ sourceBlock : WallBlock data wall,
      nonDanglingValency data
          (WallBlock.sourceVertex data wall sourceBlock) = 2 ∨
        nonDanglingValency data
          (WallBlock.sourceVertex data wall sourceBlock) = 3) :
    ∀ sourceBlock : WallBlock data wall,
      (activeLabels data star sourceBlock).card = 2 ∨
        (activeLabels data star sourceBlock).card = 3 := by
  intro sourceBlock
  rw [card_activeLabels_eq_nonDanglingValency data star sourceBlock
    (hInjective sourceBlock)]
  exact hValency sourceBlock

/-- Including the entirely dangling case, source non-dangling valency
zero/two/three gives the exhaustive W4 active classification. -/
theorem activeLabels_card_zero_two_or_three_of_nonDanglingValency
    {wall : target.V}
    (data : GluingDatum target degree)
    (star : W4TargetPairings.FourStar target wall)
    (hInjective : ∀ sourceBlock : WallBlock data wall,
      NonDanglingStarInjective data star sourceBlock)
    (hValency : ∀ sourceBlock : WallBlock data wall,
      nonDanglingValency data
          (WallBlock.sourceVertex data wall sourceBlock) = 0 ∨
        nonDanglingValency data
            (WallBlock.sourceVertex data wall sourceBlock) = 2 ∨
          nonDanglingValency data
            (WallBlock.sourceVertex data wall sourceBlock) = 3) :
    ∀ sourceBlock : WallBlock data wall,
      (activeLabels data star sourceBlock).card = 0 ∨
        (activeLabels data star sourceBlock).card = 2 ∨
          (activeLabels data star sourceBlock).card = 3 := by
  intro sourceBlock
  rw [card_activeLabels_eq_nonDanglingValency data star sourceBlock
    (hInjective sourceBlock)]
  exact hValency sourceBlock

/-- No-return supplies the lower active-label bound, while the literal map
from surviving occurrences supplies the upper bound.  Together with source
valency zero/two/three, this gives exactly the W4 active classification without
assuming neighbourhood injectivity. -/
theorem activeLabels_card_zero_two_or_three_of_noReturn
    {wall : target.V}
    (data : GluingDatum target degree)
    (star : W4TargetPairings.FourStar target wall)
    (hNoReturn : NonDanglingNoReturn data star)
    (hValency : ∀ sourceBlock : WallBlock data wall,
      nonDanglingValency data
          (WallBlock.sourceVertex data wall sourceBlock) = 0 ∨
        nonDanglingValency data
            (WallBlock.sourceVertex data wall sourceBlock) = 2 ∨
          nonDanglingValency data
            (WallBlock.sourceVertex data wall sourceBlock) = 3) :
    ∀ sourceBlock : WallBlock data wall,
      (activeLabels data star sourceBlock).card = 0 ∨
        (activeLabels data star sourceBlock).card = 2 ∨
          (activeLabels data star sourceBlock).card = 3 := by
  intro sourceBlock
  have hUpper := card_activeLabels_le_nonDanglingValency data star sourceBlock
  rcases hValency sourceBlock with hZero | hTwo | hThree
  · left
    omega
  · have hLower := hNoReturn sourceBlock (by omega)
    right
    left
    omega
  · have hLower := hNoReturn sourceBlock (by omega)
    omega

/-- In the W4 r0 situation, validity, dangling-no-glue, and Equation (C)
already rule out a singleton active image.  Hence the source valency bound
zero/two/three gives the complete active classification without a separate
no-return hypothesis. -/
theorem activeLabels_card_zero_two_or_three_of_changeZero
    {wall : target.V}
    (data : GluingDatum target degree)
    (star : W4TargetPairings.FourStar target wall)
    (hValid : data.Valid)
    (hDanglingNoGlue : DanglingEdgeNoGlue data)
    (hChangeZero :
      ∑ sourceBlock : WallBlock data wall,
        AuxR0Profile.wallBlockRamification data star sourceBlock = 0)
    (hValency : ∀ sourceBlock : WallBlock data wall,
      nonDanglingValency data
          (WallBlock.sourceVertex data wall sourceBlock) = 0 ∨
        nonDanglingValency data
            (WallBlock.sourceVertex data wall sourceBlock) = 2 ∨
          nonDanglingValency data
            (WallBlock.sourceVertex data wall sourceBlock) = 3) :
    ∀ sourceBlock : WallBlock data wall,
      (activeLabels data star sourceBlock).card = 0 ∨
        (activeLabels data star sourceBlock).card = 2 ∨
          (activeLabels data star sourceBlock).card = 3 := by
  intro sourceBlock
  have hUpper := card_activeLabels_le_nonDanglingValency data star sourceBlock
  rcases hValency sourceBlock with hZero | hTwo | hThree
  · left
    omega
  · have hPositive :=
      activeLabels_card_pos_of_nonDanglingValency_pos data star sourceBlock
        (by omega)
    have hNotOne : (activeLabels data star sourceBlock).card ≠ 1 := by
      intro hOne
      have hValencyOne :=
        nonDanglingValency_eq_one_of_activeLabels_card_eq_one data star hValid
          hDanglingNoGlue hChangeZero sourceBlock hOne
      omega
    right
    left
    omega
  · have hPositive :=
      activeLabels_card_pos_of_nonDanglingValency_pos data star sourceBlock
        (by omega)
    have hNotOne : (activeLabels data star sourceBlock).card ≠ 1 := by
      intro hOne
      have hValencyOne :=
        nonDanglingValency_eq_one_of_activeLabels_card_eq_one data star hValid
          hDanglingNoGlue hChangeZero sourceBlock hOne
      omega
    omega

/-- Two surviving edge occurrences are consecutive along a stable path when
they are distinct and meet at a surviving valency-two vertex. -/
def Consecutive (data : GluingDatum target degree)
    (first second : NonDanglingEdge data) : Prop :=
  first ≠ second ∧ ∃ vertex : data.SourceVertex,
    Incident data first.1 vertex ∧
      Incident data second.1 vertex ∧
      nonDanglingValency data vertex = 2

/-- The two active occurrences of an nd2 wall block are already consecutive
at the wall-block's quotient-source vertex.  Thus the wall datum needs no
separate direct-or-one-internal-edge connection hypothesis. -/
theorem consecutive_of_nd2_activeLabels
    {wall : target.V}
    (data : GluingDatum target degree)
    (star : W4TargetPairings.FourStar target wall)
    (sourceBlock : WallBlock data wall) (block : Nd2Block)
    (hActive : block.activeLabels = activeLabels data star sourceBlock)
    (hInjective : NonDanglingStarInjective data star sourceBlock)
    (hFirst : ¬ IsDangling data
      (data.sourceEdge (star.edge block.first) sourceBlock.1))
    (hSecond : ¬ IsDangling data
      (data.sourceEdge (star.edge block.second) sourceBlock.1)) :
    Consecutive data
      ⟨data.sourceEdge (star.edge block.first) sourceBlock.1, hFirst⟩
      ⟨data.sourceEdge (star.edge block.second) sourceBlock.1, hSecond⟩ := by
  constructor
  · intro hEqual
    exact sourceEdge_ne_of_label_ne data star block.distinct
      sourceBlock.1 sourceBlock.1 (congrArg Subtype.val hEqual)
  · refine ⟨WallBlock.sourceVertex data wall sourceBlock, ?_, ?_, ?_⟩
    · apply (incident_wallBlock_sourceVertex_iff data sourceBlock _).2
      exact ⟨star.edge_mem_incidentEdges block.first,
        WallBlock.ofSourceEdge_eq_of_rel data star sourceBlock block.first
          sourceBlock.1 rfl⟩
    · apply (incident_wallBlock_sourceVertex_iff data sourceBlock _).2
      exact ⟨star.edge_mem_incidentEdges block.second,
        WallBlock.ofSourceEdge_eq_of_rel data star sourceBlock block.second
          sourceBlock.1 rfl⟩
    · calc
        nonDanglingValency data
            (WallBlock.sourceVertex data wall sourceBlock) =
            block.activeLabels.card := by
          rw [hActive]
          exact (card_activeLabels_eq_nonDanglingValency data star sourceBlock
            hInjective).symm
        _ = 2 := by simp [Nd2Block.activeLabels, block.distinct]

/-- Stable paths are the equivalence classes generated by passage through
surviving valency-two vertices. -/
def StablePath (data : GluingDatum target degree) :=
  Quot (Consecutive data)

noncomputable instance (data : GluingDatum target degree) :
    Fintype (StablePath data) := by
  letI : Finite (StablePath data) := Quot.finite (Consecutive data)
  exact Fintype.ofFinite (StablePath data)

noncomputable instance (data : GluingDatum target degree) :
    DecidableEq (StablePath data) :=
  Classical.decEq _

/-- The stable path containing a surviving source edge. -/
def NonDanglingEdge.stablePath {data : GluingDatum target degree}
    (edge : NonDanglingEdge data) : StablePath data :=
  Quot.mk _ edge

theorem stablePath_eq_of_consecutive {data : GluingDatum target degree}
    {first second : NonDanglingEdge data}
    (h : Consecutive data first second) :
    first.stablePath = second.stablePath :=
  Quot.sound h

theorem stablePath_eq_iff {data : GluingDatum target degree}
    (first second : NonDanglingEdge data) :
    first.stablePath = second.stablePath ↔
      Relation.EqvGen (Consecutive data) first second :=
  Quot.eq

/-- Every surviving occurrence has one and only one stable-path class. -/
theorem existsUnique_stablePath {data : GluingDatum target degree}
    (edge : NonDanglingEdge data) :
    ∃! path : StablePath data, edge.stablePath = path := by
  exact ⟨edge.stablePath, rfl, fun path hPath ↦ hPath.symm⟩

/-! ## Honest full-rank presentations of the stable source -/

/-- A square labelling of the actual stable-source paths and target-edge
occurrences.  The induced presentation below enumerates every surviving
source occurrence in its stable-path class; its path lists are not arbitrary
matrix data. -/
structure StableLengthMatrixLabelling
    (data : GluingDatum target degree) (coordinate : Type*) where
  targetEdge : coordinate ≃ target.edges
  row : StablePath data ≃ coordinate

namespace StableLengthMatrixLabelling

variable {coordinate : Type*} [Fintype coordinate] [DecidableEq coordinate]
  {data : GluingDatum target degree}

/-- Enumerate all surviving source occurrences in one labelled stable-path
class.  Order is irrelevant to the length sum, while the list retains every
parallel occurrence exactly once. -/
noncomputable def path
    (labelling : StableLengthMatrixLabelling data coordinate)
    (row : coordinate) : List data.SourceEdge := by
  classical
  exact (Finset.univ : Finset data.SourceEdge).toList.filter fun edge ↦
    ∃ hSurvives : ¬ IsDangling data edge,
      labelling.row
        (NonDanglingEdge.stablePath
          (⟨edge, hSurvives⟩ : NonDanglingEdge data)) = row

omit [Fintype coordinate] in
@[simp] theorem mem_path_iff
    (labelling : StableLengthMatrixLabelling data coordinate)
    (row : coordinate) (edge : data.SourceEdge) :
    edge ∈ labelling.path row ↔
      ∃ hSurvives : ¬ IsDangling data edge,
        labelling.row
          (NonDanglingEdge.stablePath
            (⟨edge, hSurvives⟩ : NonDanglingEdge data)) = row := by
  classical
  simp [path]

/-- The literal square length-matrix presentation associated to the stable
source. -/
noncomputable def presentation
    (labelling : StableLengthMatrixLabelling data coordinate) :
    data.LengthMatrixPresentation coordinate where
  targetEdge := labelling.targetEdge
  path := labelling.path

omit [Fintype coordinate] in
/-- If every source occurrence above one target edge is dangling, its column
in the honest stable-source length matrix is zero. -/
theorem matrix_column_eq_zero_of_target_fibre_dangling
    (labelling : StableLengthMatrixLabelling data coordinate)
    (targetEdge : target.edges)
    (hDangling : ∀ sourceEdge : data.SourceEdge,
      sourceEdge.1.1 = targetEdge → IsDangling data sourceEdge)
    (row : coordinate) :
    GluingDatum.LengthMatrixPresentation.matrix labelling.presentation row
        (labelling.targetEdge.symm targetEdge) = 0 := by
  unfold GluingDatum.LengthMatrixPresentation.matrix
    GluingDatum.LengthMatrixPresentation.row
  apply List.sum_eq_zero
  intro coefficient hCoefficient
  obtain ⟨sourceEdge, hSourceEdge, rfl⟩ := List.mem_map.mp hCoefficient
  have hSurvives : ¬ IsDangling data sourceEdge :=
    (labelling.mem_path_iff row sourceEdge).mp hSourceEdge |>.choose
  apply GluingDatum.LengthMatrixPresentation.coefficient_eq_zero_of_target_ne
  intro hTarget
  apply hSurvives
  apply hDangling sourceEdge
  have hTarget' : targetEdge = sourceEdge.1.1 := by
    simpa [presentation] using hTarget
  exact hTarget'.symm

/-- Nonsingularity of the honest stable-source length matrix rules out a
dangling target fibre.  This is the first half of the source's theorem that a
full-rank discrete tropical morphism is a combinatorial type. -/
theorem noDanglingTargetFibres_of_det_ne_zero
    (labelling : StableLengthMatrixLabelling data coordinate)
    (hDet :
      (GluingDatum.LengthMatrixPresentation.matrix
        labelling.presentation).det ≠ 0) :
    NoDanglingTargetFibres data := by
  intro targetEdge
  by_contra hNoSurvivor
  have hAllDangling : ∀ sourceEdge : data.SourceEdge,
      sourceEdge.1.1 = targetEdge → IsDangling data sourceEdge := by
    intro sourceEdge hTarget
    by_contra hSurvives
    exact hNoSurvivor ⟨sourceEdge, hTarget, hSurvives⟩
  apply hDet
  apply Matrix.det_eq_zero_of_column_eq_zero
    (labelling.targetEdge.symm targetEdge)
  intro row
  exact labelling.matrix_column_eq_zero_of_target_fibre_dangling
    targetEdge hAllDangling row

end StableLengthMatrixLabelling

/-- A full-dimensional stable-path labelling by the rows expected by the W4
presentation.  Bijectivity records that no stable source path is duplicated
or omitted. -/
structure StablePathLabelling (data : GluingDatum target degree) where
  row : StablePath data ≃ Option target.edges

/-- Full-dimensionality supplies only the number of stable source paths.
Finite cardinality equality canonically removes the remaining arbitrary row
labelling choice. -/
noncomputable def StablePathLabelling.ofCardEq
    (data : GluingDatum target degree)
    (hCard : Fintype.card (StablePath data) = target.edges.card + 1) :
    StablePathLabelling data where
  row := Fintype.equivOfCardEq (by
    calc
      Fintype.card (StablePath data) = target.edges.card + 1 := hCard
      _ = Fintype.card (Option target.edges) := by
        rw [Fintype.card_option]
        exact congrArg (fun count : ℕ ↦ count + 1)
          (Multiset.card_coe target.edges).symm)

/-- The stable row of an old source edge; dangling occurrences are omitted. -/
noncomputable def StablePathLabelling.oldRowOf
    {data : GluingDatum target degree}
    (labelling : StablePathLabelling data) :
    data.SourceEdge → Option (Option target.edges) := by
  classical
  intro edge
  exact if h : IsDangling data edge then none
    else some (labelling.row
      (NonDanglingEdge.stablePath (⟨edge, h⟩ : NonDanglingEdge data)))

@[simp] theorem StablePathLabelling.oldRowOf_eq_none_iff
    {data : GluingDatum target degree}
    (labelling : StablePathLabelling data) (edge : data.SourceEdge) :
    labelling.oldRowOf edge = none ↔ IsDangling data edge := by
  classical
  unfold oldRowOf
  by_cases h : IsDangling data edge <;> simp [h]

@[simp] theorem StablePathLabelling.oldRowOf_eq_some
    {data : GluingDatum target degree}
    (labelling : StablePathLabelling data) (edge : NonDanglingEdge data) :
    labelling.oldRowOf edge.1 = some (labelling.row edge.stablePath) := by
  classical
  simp only [oldRowOf, dif_neg edge.2]
  congr 2

theorem StablePathLabelling.oldRowOf_eq_of_consecutive
    {data : GluingDatum target degree}
    (labelling : StablePathLabelling data)
    {first second : NonDanglingEdge data}
    (h : Consecutive data first second) :
    labelling.oldRowOf first.1 = labelling.oldRowOf second.1 := by
  rw [labelling.oldRowOf_eq_some, labelling.oldRowOf_eq_some,
    stablePath_eq_of_consecutive h]

/-- Extend a stable-path labelling by the candidate-specific regrown wall
occurrences.  The old assignment is forced by the actual stable source;
only the new-edge choice and its wall-block coherence remain to be supplied. -/
noncomputable def StablePathLabelling.toPathAssignment
    {data : GluingDatum target degree} {wall : target.V}
    (labelling : StablePathLabelling data)
    (regrown : Fin 3 → WallBlock data wall →
      Option (Option target.edges × Fin degree))
    (regrown_block : ∀ pairing sourceBlock row sheet,
      regrown pairing sourceBlock = some (row, sheet) →
      WallBlock.ofSheet data wall sheet = sourceBlock) :
    PathAssignment data wall where
  oldRowOf := labelling.oldRowOf
  regrown := regrown
  regrown_block := regrown_block

@[simp] theorem StablePathLabelling.toPathAssignment_oldRowOf
    {data : GluingDatum target degree} {wall : target.V}
    (labelling : StablePathLabelling data)
    (regrown : Fin 3 → WallBlock data wall →
      Option (Option target.edges × Fin degree))
    (regrown_block : ∀ pairing sourceBlock row sheet,
      regrown pairing sourceBlock = some (row, sheet) →
      WallBlock.ofSheet data wall sheet = sourceBlock)
    (edge : data.SourceEdge) :
    (labelling.toPathAssignment regrown regrown_block).oldRowOf edge =
      labelling.oldRowOf edge :=
  rfl

/-! ## The auxiliary r0-nd2 old-source picture -/

/-- The literal old-source picture delivered by the paper's auxiliary
`r0-nd2` argument.  The two canonical active branch occurrences survive;
they meet directly or through the unique internal surviving occurrence; and
they exhaust the surviving occurrences over this old wall block and the four
star columns.

These are graph statements about the stable source, not preassembled path
counts or `PathAssignment` membership conclusions. -/
structure AuxR0Nd2Picture
    {wall : target.V}
    (data : GluingDatum target degree)
    (star : W4TargetPairings.FourStar target wall)
    (sourceBlock : WallBlock data wall) (block : Nd2Block) where
  first_survives :
    ¬ IsDangling data
      (data.sourceEdge (star.edge block.first) sourceBlock.1)
  second_survives :
    ¬ IsDangling data
      (data.sourceEdge (star.edge block.second) sourceBlock.1)
  middle : Option (NonDanglingEdge data)
  connected : match middle with
    | none =>
      Consecutive data
          ⟨data.sourceEdge (star.edge block.first) sourceBlock.1,
            first_survives⟩
          ⟨data.sourceEdge (star.edge block.second) sourceBlock.1,
            second_survives⟩
    | some middle =>
        Consecutive data
          ⟨data.sourceEdge (star.edge block.first) sourceBlock.1,
            first_survives⟩ middle ∧
        Consecutive data middle
          ⟨data.sourceEdge (star.edge block.second) sourceBlock.1,
            second_survives⟩
  only_surviving : ∀ edge : data.SourceEdge,
    WallBlock.ofSheet data wall edge.1.2 = sourceBlock →
    (∃ label : Fin 4, star.edge label = edge.1.1) →
    ¬ IsDangling data edge →
    edge = data.sourceEdge (star.edge block.first) sourceBlock.1 ∨
      edge = data.sourceEdge (star.edge block.second) sourceBlock.1

namespace AuxR0Nd2Picture

variable {wall : target.V}

/-- Build the auxiliary nd2 picture from its local direct-or-one-internal-edge
topology and the source's assertion that each active branch has exactly its
canonical surviving occurrence.  Exhaustion over the four star columns is
derived from the literal active-label set. -/
noncomputable def ofActiveLabels
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    {sourceBlock : WallBlock data wall} {block : Nd2Block}
    (hActive : block.activeLabels = activeLabels data star sourceBlock)
    (hFirstSurvives :
      ¬ IsDangling data
        (data.sourceEdge (star.edge block.first) sourceBlock.1))
    (hSecondSurvives :
      ¬ IsDangling data
        (data.sourceEdge (star.edge block.second) sourceBlock.1))
    (middle : Option (NonDanglingEdge data))
    (hConnected : match middle with
      | none =>
          Consecutive data
            ⟨data.sourceEdge (star.edge block.first) sourceBlock.1,
              hFirstSurvives⟩
            ⟨data.sourceEdge (star.edge block.second) sourceBlock.1,
              hSecondSurvives⟩
      | some middle =>
          Consecutive data
            ⟨data.sourceEdge (star.edge block.first) sourceBlock.1,
              hFirstSurvives⟩ middle ∧
          Consecutive data middle
            ⟨data.sourceEdge (star.edge block.second) sourceBlock.1,
              hSecondSurvives⟩)
    (hInjective : NonDanglingStarInjective data star sourceBlock) :
    AuxR0Nd2Picture data star sourceBlock block where
  first_survives := hFirstSurvives
  second_survives := hSecondSurvives
  middle := middle
  connected := hConnected
  only_surviving := by
    intro edge hBlock hStar hSurvives
    obtain ⟨label, hTarget⟩ := hStar
    have hWallRel :
        (data.vertexPartition wall).Rel sourceBlock.1 edge.1.2 :=
      (WallBlock.ofSheet_eq_iff_rel data wall sourceBlock edge.1.2).mp hBlock
    have hLiteral : label ∈ activeLabels data star sourceBlock :=
      (mem_activeLabels_iff data star sourceBlock label).2
        ⟨edge.1.2, hWallRel, by simpa [hTarget] using hSurvives⟩
    have hLabel : label ∈ block.activeLabels := by
      rw [hActive]
      exact hLiteral
    rcases (block.mem_activeLabels label).mp hLabel with hFirst | hSecond
    · left
      subst label
      exact hInjective.unique block.first edge
        (data.sourceEdge (star.edge block.first) sourceBlock.1)
        hBlock (WallBlock.ofSourceEdge_eq_of_rel data star sourceBlock
          block.first sourceBlock.1 rfl)
        hTarget.symm rfl hSurvives hFirstSurvives
    · right
      subst label
      exact hInjective.unique block.second edge
        (data.sourceEdge (star.edge block.second) sourceBlock.1)
        hBlock (WallBlock.ofSourceEdge_eq_of_rel data star sourceBlock
          block.second sourceBlock.1 rfl)
        hTarget.symm rfl hSurvives hSecondSurvives

theorem first_survives_of_blockCountWithin_eq_one
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    {sourceBlock : WallBlock data wall} {block : Nd2Block}
    (hActive : block.activeLabels = activeLabels data star sourceBlock)
    (hCount :
      (data.edgePartition (star.edge block.first)).blockCountWithin
        (data.vertexPartition wall) sourceBlock.1 = 1) :
    ¬ IsDangling data
      (data.sourceEdge (star.edge block.first) sourceBlock.1) := by
  apply sourceEdge_anchor_survives_of_active_of_blockCountWithin_eq_one
    data star sourceBlock block.first
  · rw [← hActive]
    simp
  · exact hCount

theorem second_survives_of_blockCountWithin_eq_one
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    {sourceBlock : WallBlock data wall} {block : Nd2Block}
    (hActive : block.activeLabels = activeLabels data star sourceBlock)
    (hCount :
      (data.edgePartition (star.edge block.second)).blockCountWithin
        (data.vertexPartition wall) sourceBlock.1 = 1) :
    ¬ IsDangling data
      (data.sourceEdge (star.edge block.second) sourceBlock.1) := by
  apply sourceEdge_anchor_survives_of_active_of_blockCountWithin_eq_one
    data star sourceBlock block.second
  · rw [← hActive]
    simp
  · exact hCount

/-- Equation (C) supplies the two one-block hypotheses used here through
`AuxR0Profile.nd2_active_blockCountWithin`; the remaining neighbourhood
injectivity both identifies the active occurrences and proves their direct
connection at the wall-block source vertex. -/
noncomputable def ofActiveLabelsAndCounts
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    {sourceBlock : WallBlock data wall} {block : Nd2Block}
    (hActive : block.activeLabels = activeLabels data star sourceBlock)
    (hFirstCount :
      (data.edgePartition (star.edge block.first)).blockCountWithin
        (data.vertexPartition wall) sourceBlock.1 = 1)
    (hSecondCount :
      (data.edgePartition (star.edge block.second)).blockCountWithin
        (data.vertexPartition wall) sourceBlock.1 = 1)
    (middle : Option (NonDanglingEdge data))
    (hConnected : match middle with
      | none =>
          Consecutive data
            ⟨data.sourceEdge (star.edge block.first) sourceBlock.1,
              first_survives_of_blockCountWithin_eq_one hActive
                hFirstCount⟩
            ⟨data.sourceEdge (star.edge block.second) sourceBlock.1,
              second_survives_of_blockCountWithin_eq_one hActive
                hSecondCount⟩
      | some middle =>
          Consecutive data
            ⟨data.sourceEdge (star.edge block.first) sourceBlock.1,
              first_survives_of_blockCountWithin_eq_one hActive
                hFirstCount⟩ middle ∧
          Consecutive data middle
            ⟨data.sourceEdge (star.edge block.second) sourceBlock.1,
              second_survives_of_blockCountWithin_eq_one hActive
                hSecondCount⟩)
    (hInjective : NonDanglingStarInjective data star sourceBlock) :
    AuxR0Nd2Picture data star sourceBlock block :=
  ofActiveLabels hActive
    (first_survives_of_blockCountWithin_eq_one hActive hFirstCount)
    (second_survives_of_blockCountWithin_eq_one hActive hSecondCount)
    middle hConnected hInjective

noncomputable def first
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    {sourceBlock : WallBlock data wall} {block : Nd2Block}
    (picture : AuxR0Nd2Picture data star sourceBlock block) :
    NonDanglingEdge data :=
  ⟨data.sourceEdge (star.edge block.first) sourceBlock.1,
    picture.first_survives⟩

noncomputable def second
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    {sourceBlock : WallBlock data wall} {block : Nd2Block}
    (picture : AuxR0Nd2Picture data star sourceBlock block) :
    NonDanglingEdge data :=
  ⟨data.sourceEdge (star.edge block.second) sourceBlock.1,
    picture.second_survives⟩

/-- The direct-or-one-internal-edge auxiliary picture puts the two active old
branch occurrences in one stable path. -/
theorem stablePath_eq
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    {sourceBlock : WallBlock data wall} {block : Nd2Block}
    (picture : AuxR0Nd2Picture data star sourceBlock block) :
    picture.first.stablePath = picture.second.stablePath := by
  cases hMiddle : picture.middle with
  | none =>
      have hDirect : Consecutive data picture.first picture.second := by
        simpa [first, second, hMiddle] using picture.connected
      exact stablePath_eq_of_consecutive hDirect
  | some middle =>
      have hConnection :
          Consecutive data picture.first middle ∧
            Consecutive data middle picture.second := by
        simpa [first, second, hMiddle] using picture.connected
      exact (stablePath_eq_of_consecutive hConnection.1).trans
        (stablePath_eq_of_consecutive hConnection.2)

/-- The common stable row of the two active old branches. -/
noncomputable def oldRow
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    {sourceBlock : WallBlock data wall} {block : Nd2Block}
    (picture : AuxR0Nd2Picture data star sourceBlock block)
    (labelling : StablePathLabelling data) (_label : Fin 4) :
    Option target.edges :=
  labelling.row picture.first.stablePath

/-- The auxiliary r0-nd2 source picture proves the complete old-edge
membership equivalence consumed by `Nd2BlockMembership`. -/
theorem oldRowOf_mem
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    [DecidableEq target.edges]
    {sourceBlock : WallBlock data wall} {block : Nd2Block}
    (picture : AuxR0Nd2Picture data star sourceBlock block)
    (labelling : StablePathLabelling data) :
    ∀ row edge,
      WallBlock.ofSheet data wall edge.1.2 = sourceBlock →
      some edge.1.1 ∈ canonicalW4OldColumns star →
      (labelling.oldRowOf edge = some row ↔
        (row, edge) ∈ nd2OldOccurrences data star sourceBlock block
          (picture.oldRow labelling)) := by
  intro row edge hBlock hColumn
  have hStar : ∃ label : Fin 4, star.edge label = edge.1.1 := by
    simpa [canonicalW4OldColumns] using hColumn
  constructor
  · intro hAssigned
    have hSurvives : ¬ IsDangling data edge := by
      intro hDangling
      have hNone := (labelling.oldRowOf_eq_none_iff edge).2 hDangling
      rw [hNone] at hAssigned
      simp at hAssigned
    rcases picture.only_surviving edge hBlock hStar hSurvives with
      hFirst | hSecond
    · subst edge
      have hRow : labelling.row picture.first.stablePath = row := by
        rw [← Option.some_inj]
        rw [← labelling.oldRowOf_eq_some picture.first]
        exact hAssigned
      simp [nd2OldOccurrences, oldRow, hRow]
    · subst edge
      have hRow : labelling.row picture.first.stablePath = row := by
        rw [picture.stablePath_eq]
        rw [← Option.some_inj]
        rw [← labelling.oldRowOf_eq_some picture.second]
        exact hAssigned
      simp [nd2OldOccurrences, oldRow, hRow]
  · intro hMem
    simp [nd2OldOccurrences] at hMem
    rcases hMem with ⟨hRow, hEdge⟩ | ⟨hRow, hEdge⟩
    · subst row
      subst edge
      exact labelling.oldRowOf_eq_some picture.first
    · subst row
      subst edge
      change labelling.oldRowOf picture.second.1 =
        some (picture.oldRow labelling block.second)
      rw [labelling.oldRowOf_eq_some]
      simp only [oldRow]
      rw [← picture.stablePath_eq]

/-- The same old-edge theorem stated directly for the assignment obtained by
extending the stable-path labelling with arbitrary coherent regrowth. -/
theorem toPathAssignment_old_mem
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    [DecidableEq target.edges]
    {sourceBlock : WallBlock data wall} {block : Nd2Block}
    (picture : AuxR0Nd2Picture data star sourceBlock block)
    (labelling : StablePathLabelling data)
    (regrown : Fin 3 → WallBlock data wall →
      Option (Option target.edges × Fin degree))
    (regrown_block : ∀ pairing sourceBlock row sheet,
      regrown pairing sourceBlock = some (row, sheet) →
      WallBlock.ofSheet data wall sheet = sourceBlock) :
    ∀ row edge,
      WallBlock.ofSheet data wall edge.1.2 = sourceBlock →
      some edge.1.1 ∈ canonicalW4OldColumns star →
      ((labelling.toPathAssignment regrown regrown_block).oldRowOf edge =
          some row ↔
        (row, edge) ∈ nd2OldOccurrences data star sourceBlock block
          (picture.oldRow labelling)) := by
  exact picture.oldRowOf_mem labelling

@[simp] theorem oldRow_first_eq_second
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    {sourceBlock : WallBlock data wall} {block : Nd2Block}
    (picture : AuxR0Nd2Picture data star sourceBlock block)
    (labelling : StablePathLabelling data) :
    picture.oldRow labelling block.first =
      picture.oldRow labelling block.second :=
  rfl

end AuxR0Nd2Picture

/-! ## The auxiliary r0-nd3 old-source picture -/

/-- The literal old-source picture delivered by the paper's auxiliary
`r0-nd3` argument.  It chooses an honest sheet in each active branch edge
block, proves that those three canonical occurrences survive, and proves that
they exhaust the surviving old occurrences over the wall block. -/
structure AuxR0Nd3Picture
    {wall : target.V}
    (data : GluingDatum target degree)
    (star : W4TargetPairings.FourStar target wall)
    (sourceBlock : WallBlock data wall) (block : Nd3Block) where
  activeSheet : Fin 4 → Fin degree
  active_sheet : ∀ label, label ∈ block.activeLabels →
    (data.vertexPartition wall).Rel sourceBlock.1 (activeSheet label)
  active_survives : ∀ label, label ∈ block.activeLabels →
    ¬ IsDangling data
      (data.sourceEdge (star.edge label) (activeSheet label))
  only_surviving : ∀ edge : data.SourceEdge,
    WallBlock.ofSheet data wall edge.1.2 = sourceBlock →
    (∃ label : Fin 4, star.edge label = edge.1.1) →
    ¬ IsDangling data edge →
    ∃ label : Fin 4, label ∈ block.activeLabels ∧
      edge = data.sourceEdge (star.edge label) (activeSheet label)

namespace AuxR0Nd3Picture

variable {wall : target.V}

/-- Choose one source sheet on each active nd3 branch.  Inactive values are
irrelevant and use the wall-block representative. -/
noncomputable def chosenSheet
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    {sourceBlock : WallBlock data wall} {block : Nd3Block}
    (hActive : block.activeLabels = activeLabels data star sourceBlock)
    (label : Fin 4) : Fin degree :=
  if hLabel : label ∈ block.activeLabels then
    activeWitnessSheet data star sourceBlock label (by
      rw [← hActive]
      exact hLabel)
  else sourceBlock.1

theorem chosenSheet_rel
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    {sourceBlock : WallBlock data wall} {block : Nd3Block}
    (hActive : block.activeLabels = activeLabels data star sourceBlock)
    (label : Fin 4) (hLabel : label ∈ block.activeLabels) :
    (data.vertexPartition wall).Rel sourceBlock.1
      (chosenSheet hActive label) := by
  simp only [chosenSheet, dif_pos hLabel]
  apply activeSheet_rel

theorem chosenSheet_survives
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    {sourceBlock : WallBlock data wall} {block : Nd3Block}
    (hActive : block.activeLabels = activeLabels data star sourceBlock)
    (label : Fin 4) (hLabel : label ∈ block.activeLabels) :
    ¬ IsDangling data
      (data.sourceEdge (star.edge label) (chosenSheet hActive label)) := by
  simp only [chosenSheet, dif_pos hLabel]
  apply activeSheet_survives

/-- Build the auxiliary nd3 picture from the literal active-label definition
and the source's injectivity on non-dangling neighbours.  Active sheets and
the exhaustive occurrence statement are derived here. -/
noncomputable def ofActiveLabels
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    {sourceBlock : WallBlock data wall} {block : Nd3Block}
    (hActive : block.activeLabels = activeLabels data star sourceBlock)
    (hInjective : NonDanglingStarInjective data star sourceBlock) :
    AuxR0Nd3Picture data star sourceBlock block where
  activeSheet := chosenSheet hActive
  active_sheet := chosenSheet_rel hActive
  active_survives := chosenSheet_survives hActive
  only_surviving := by
    intro edge hBlock hStar hSurvives
    obtain ⟨label, hTarget⟩ := hStar
    have hWallRel :
        (data.vertexPartition wall).Rel sourceBlock.1 edge.1.2 :=
      (WallBlock.ofSheet_eq_iff_rel data wall sourceBlock edge.1.2).mp hBlock
    have hLiteral : label ∈ activeLabels data star sourceBlock :=
      (mem_activeLabels_iff data star sourceBlock label).2
        ⟨edge.1.2, hWallRel, by simpa [hTarget] using hSurvives⟩
    have hLabel : label ∈ block.activeLabels := by
      rw [hActive]
      exact hLiteral
    have hChosenBlock := WallBlock.ofSourceEdge_eq_of_rel data star
      sourceBlock label (chosenSheet hActive label)
      (chosenSheet_rel hActive label hLabel)
    exact ⟨label, hLabel,
      hInjective.unique label edge
        (data.sourceEdge (star.edge label) (chosenSheet hActive label))
        hBlock hChosenBlock hTarget.symm rfl hSurvives
        (chosenSheet_survives hActive label hLabel)⟩

noncomputable def activeEdge
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    {sourceBlock : WallBlock data wall} {block : Nd3Block}
    (picture : AuxR0Nd3Picture data star sourceBlock block)
    (label : Fin 4) (hActive : label ∈ block.activeLabels) :
    NonDanglingEdge data :=
  ⟨data.sourceEdge (star.edge label) (picture.activeSheet label),
    picture.active_survives label hActive⟩

/-- Each active branch is assigned the stable path of its honest surviving
source occurrence.  Inactive labels receive the harmless unused row `none`. -/
noncomputable def oldRow
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    {sourceBlock : WallBlock data wall} {block : Nd3Block}
    (picture : AuxR0Nd3Picture data star sourceBlock block)
    (labelling : StablePathLabelling data) (label : Fin 4) :
    Option target.edges :=
  if hActive : label ∈ block.activeLabels then
    labelling.row (picture.activeEdge label hActive).stablePath
  else none

theorem oldRow_active
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    {sourceBlock : WallBlock data wall} {block : Nd3Block}
    (picture : AuxR0Nd3Picture data star sourceBlock block)
    (labelling : StablePathLabelling data) (label : Fin 4)
    (hActive : label ∈ block.activeLabels) :
    picture.oldRow labelling label =
      labelling.row (picture.activeEdge label hActive).stablePath := by
  unfold oldRow
  rw [dif_pos hActive]

theorem oldRowOf_active
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    {sourceBlock : WallBlock data wall} {block : Nd3Block}
    (picture : AuxR0Nd3Picture data star sourceBlock block)
    (labelling : StablePathLabelling data) (label : Fin 4)
    (hActive : label ∈ block.activeLabels) :
    labelling.oldRowOf
        (data.sourceEdge (star.edge label) (picture.activeSheet label)) =
      some (picture.oldRow labelling label) := by
  change labelling.oldRowOf (picture.activeEdge label hActive).1 = _
  rw [labelling.oldRowOf_eq_some]
  rw [picture.oldRow_active labelling label hActive]

/-- The auxiliary r0-nd3 source picture proves the complete old-edge
membership equivalence consumed by `Nd3BlockMembership`. -/
theorem oldRowOf_mem
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    [DecidableEq target.edges]
    {sourceBlock : WallBlock data wall} {block : Nd3Block}
    (picture : AuxR0Nd3Picture data star sourceBlock block)
    (labelling : StablePathLabelling data) :
    ∀ row edge,
      WallBlock.ofSheet data wall edge.1.2 = sourceBlock →
      some edge.1.1 ∈ canonicalW4OldColumns star →
      (labelling.oldRowOf edge = some row ↔
        (row, edge) ∈ nd3OldOccurrences data star block
          picture.activeSheet (picture.oldRow labelling)) := by
  intro row edge hBlock hColumn
  have hStar : ∃ label : Fin 4, star.edge label = edge.1.1 := by
    simpa [canonicalW4OldColumns] using hColumn
  constructor
  · intro hAssigned
    have hSurvives : ¬ IsDangling data edge := by
      intro hDangling
      have hNone := (labelling.oldRowOf_eq_none_iff edge).2 hDangling
      rw [hNone] at hAssigned
      simp at hAssigned
    obtain ⟨label, hActive, hEdge⟩ :=
      picture.only_surviving edge hBlock hStar hSurvives
    subst edge
    have hRow : picture.oldRow labelling label = row := by
      rw [← Option.some_inj]
      rw [← picture.oldRowOf_active labelling label hActive]
      exact hAssigned
    rcases (block.mem_activeLabels label).mp hActive with
      hFirst | hSecond | hThird
    · subst label
      simp [nd3OldOccurrences, hRow]
    · subst label
      simp [nd3OldOccurrences, hRow]
    · subst label
      simp [nd3OldOccurrences, hRow]
  · intro hMem
    simp [nd3OldOccurrences] at hMem
    rcases hMem with
      ⟨hRow, hEdge⟩ | ⟨hRow, hEdge⟩ | ⟨hRow, hEdge⟩
    · subst row
      subst edge
      exact picture.oldRowOf_active labelling block.first (by simp)
    · subst row
      subst edge
      exact picture.oldRowOf_active labelling block.second (by simp)
    · subst row
      subst edge
      exact picture.oldRowOf_active labelling block.third (by simp)

/-- The same old-edge theorem for the assignment obtained by extending the
stable-path labelling with arbitrary coherent regrowth. -/
theorem toPathAssignment_old_mem
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    [DecidableEq target.edges]
    {sourceBlock : WallBlock data wall} {block : Nd3Block}
    (picture : AuxR0Nd3Picture data star sourceBlock block)
    (labelling : StablePathLabelling data)
    (regrown : Fin 3 → WallBlock data wall →
      Option (Option target.edges × Fin degree))
    (regrown_block : ∀ pairing sourceBlock row sheet,
      regrown pairing sourceBlock = some (row, sheet) →
      WallBlock.ofSheet data wall sheet = sourceBlock) :
    ∀ row edge,
      WallBlock.ofSheet data wall edge.1.2 = sourceBlock →
      some edge.1.1 ∈ canonicalW4OldColumns star →
      ((labelling.toPathAssignment regrown regrown_block).oldRowOf edge =
          some row ↔
        (row, edge) ∈ nd3OldOccurrences data star block
          picture.activeSheet (picture.oldRow labelling)) := by
  exact picture.oldRowOf_mem labelling

end AuxR0Nd3Picture

/-! ## Whole-wall source pictures and canonical regrowth -/

theorem WallBlock.ofSheet_eq_of_rel
    (data : GluingDatum target degree) (wall : target.V)
    (sourceBlock : WallBlock data wall) (sheet : Fin degree)
    (hRel : (data.vertexPartition wall).Rel sourceBlock.1 sheet) :
    WallBlock.ofSheet data wall sheet = sourceBlock := by
  apply Subtype.ext
  change (data.vertexPartition wall).repr sheet = sourceBlock.1
  exact hRel.symm.trans sourceBlock.2

/-- One source block's actual auxiliary r0 picture, before comparison with the
canonical active-label classification. -/
inductive AuxR0BlockPicture
    {wall : target.V}
    (data : GluingDatum target degree)
    (star : W4TargetPairings.FourStar target wall)
    (sourceBlock : WallBlock data wall) where
  | dangling
      (old_dangling : ∀ (edge : data.SourceEdge) (label : Fin 4),
        WallBlock.ofSheet data wall edge.1.2 = sourceBlock →
        star.edge label = edge.1.1 →
        IsDangling data edge)
  | nd2 (block : Nd2Block)
      (picture : AuxR0Nd2Picture data star sourceBlock block)
  | nd3 (block : Nd3Block)
      (picture : AuxR0Nd3Picture data star sourceBlock block)

/-- Retain the genuine source kind of an auxiliary picture. -/
def AuxR0BlockPicture.kind
    {wall : target.V}
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    {sourceBlock : WallBlock data wall} :
    AuxR0BlockPicture data star sourceBlock →
      ActiveBlockClassification.Kind
  | .dangling _ => .dangling
  | .nd2 block _ => .nd2 block
  | .nd3 block _ => .nd3 block

def AuxR0BlockPicture.pattern
    {wall : target.V}
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    {sourceBlock : WallBlock data wall} :
    AuxR0BlockPicture data star sourceBlock → BlockPattern
  | picture => picture.kind.pattern

/-- The source-facing input for W4, stated before any path assignment, list
enumeration, candidate resolution, or determinant algebra. Its fields are the
inherited wall facts used in the paper: incoming validity, the full-dimensional
stable-path cardinality, dangling-no-glue, non-dangling valency zero/two/three,
and Equation (C) in its literal `ch(w₀) + val(w₀) - 3 = 1` form. The W4
specialization derives both no-return's needed census consequence and
neighbourhood injectivity. -/
structure AuxR0SourceInput
    {wall : target.V}
    (data : GluingDatum target degree)
    (star : W4TargetPairings.FourStar target wall) where
  valid : data.Valid
  stablePath_card : Fintype.card (StablePath data) = target.edges.card + 1
  dangling_no_glue : DanglingEdgeNoGlue data
  nonDangling_valency : ∀ sourceBlock : WallBlock data wall,
    nonDanglingValency data
        (WallBlock.sourceVertex data wall sourceBlock) = 0 ∨
      nonDanglingValency data
          (WallBlock.sourceVertex data wall sourceBlock) = 2 ∨
        nonDanglingValency data
          (WallBlock.sourceVertex data wall sourceBlock) = 3
  equation_c : data.targetExcess wall = 1

namespace AuxR0SourceInput

variable {wall : target.V}

/-- Construct the W4 source interface from an actual change-minimal target
resolution whose local block counts say that the resolving source fibre is a
forest.  This Euler receipt implies source-genus preservation, so Equation (C)
is derived from the global dimension formula rather than accepted as a
separate source hypothesis. -/
theorem ofChangeMinimalExpansion
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    (right : target.edges → Bool)
    (resolution : ResolutionM11.LocalResolution degree)
    (hCompatible : GlobalResolution.OldCompatible data wall right resolution)
    (_hContracts : resolution.ContractsTo (data.vertexPartition wall))
    (hBlockCard :
      Fintype.card resolution.newEdge.Blocks +
          Fintype.card (data.vertexPartition wall).Blocks =
        Fintype.card resolution.left.Blocks +
          Fintype.card resolution.right.Blocks)
    (hMinimal :
      (GlobalResolution.datum data wall right resolution
        hCompatible).ChangeMinimal)
    (valid : data.Valid)
    (stablePath_card : Fintype.card (StablePath data) = target.edges.card + 1)
    (dangling_no_glue : DanglingEdgeNoGlue data)
    (nonDangling_valency : ∀ sourceBlock : WallBlock data wall,
      nonDanglingValency data
          (WallBlock.sourceVertex data wall sourceBlock) = 0 ∨
        nonDanglingValency data
            (WallBlock.sourceVertex data wall sourceBlock) = 2 ∨
          nonDanglingValency data
            (WallBlock.sourceVertex data wall sourceBlock) = 3) :
    AuxR0SourceInput data star where
  valid := valid
  stablePath_card := stablePath_card
  dangling_no_glue := dangling_no_glue
  nonDangling_valency := nonDangling_valency
  equation_c :=
    GlobalResolution.targetExcess_wall_eq_one_of_changeMinimal_of_block_card
      data wall right resolution hCompatible hBlockCard hMinimal

/-- Full-dimensional numerical form of the preceding constructor.  A
genus-zero expanded target saturating the dimension formula is change-minimal
as soon as its correction terms are nonnegative. -/
theorem ofDimensionSaturatedExpansion
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    (right : target.edges → Bool)
    (resolution : ResolutionM11.LocalResolution degree)
    (hCompatible : GlobalResolution.OldCompatible data wall right resolution)
    (hContracts : resolution.ContractsTo (data.vertexPartition wall))
    (hBlockCard :
      Fintype.card resolution.newEdge.Blocks +
          Fintype.card (data.vertexPartition wall).Blocks =
        Fintype.card resolution.left.Blocks +
          Fintype.card resolution.right.Blocks)
    (hTargetGenus : genus target = 0)
    (hCorrection :
      (GlobalResolution.datum data wall right resolution
        hCompatible).CorrectionNonnegative)
    (hSaturated :
      ((TargetExpansion.graph target wall right).edges.card : ℤ) =
        2 * genus (GlobalResolution.datum data wall right resolution
          hCompatible).sourceGraph + 2 * degree - 5)
    (valid : data.Valid)
    (stablePath_card : Fintype.card (StablePath data) = target.edges.card + 1)
    (dangling_no_glue : DanglingEdgeNoGlue data)
    (nonDangling_valency : ∀ sourceBlock : WallBlock data wall,
      nonDanglingValency data
          (WallBlock.sourceVertex data wall sourceBlock) = 0 ∨
        nonDanglingValency data
            (WallBlock.sourceVertex data wall sourceBlock) = 2 ∨
          nonDanglingValency data
            (WallBlock.sourceVertex data wall sourceBlock) = 3) :
    AuxR0SourceInput data star := by
  apply ofChangeMinimalExpansion right resolution hCompatible hContracts
    hBlockCard
  · apply GluingDatum.changeMinimal_of_genus_zero_dimension_saturated
      (GlobalResolution.datum data wall right resolution hCompatible)
      hCorrection
    · simpa using hTargetGenus
    · exact hSaturated
  · exact valid
  · exact stablePath_card
  · exact dangling_no_glue
  · exact nonDangling_valency

/-- Source-facing specialization of the full-dimensional constructor.  The
resolved datum's honest combinatorial-type certificate derives correction
nonnegativity, so callers need not supply that numerical consequence
directly. -/
theorem ofCombinatorialTypeDimensionSaturatedExpansion
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    (right : target.edges → Bool)
    (resolution : ResolutionM11.LocalResolution degree)
    (hCompatible : GlobalResolution.OldCompatible data wall right resolution)
    (hContracts : resolution.ContractsTo (data.vertexPartition wall))
    (hBlockCard :
      Fintype.card resolution.newEdge.Blocks +
          Fintype.card (data.vertexPartition wall).Blocks =
        Fintype.card resolution.left.Blocks +
          Fintype.card resolution.right.Blocks)
    (hTargetConnected : graph_connected target)
    (hTargetGenus : genus target = 0)
    (hResolvedValid :
      (GlobalResolution.datum data wall right resolution hCompatible).Valid)
    (hCombinatorialType :
      CombinatorialType
        (GlobalResolution.datum data wall right resolution hCompatible))
    (hSaturated :
      ((TargetExpansion.graph target wall right).edges.card : ℤ) =
        2 * genus (GlobalResolution.datum data wall right resolution
          hCompatible).sourceGraph + 2 * degree - 5)
    (valid : data.Valid)
    (stablePath_card : Fintype.card (StablePath data) = target.edges.card + 1)
    (dangling_no_glue : DanglingEdgeNoGlue data)
    (nonDangling_valency : ∀ sourceBlock : WallBlock data wall,
      nonDanglingValency data
          (WallBlock.sourceVertex data wall sourceBlock) = 0 ∨
        nonDanglingValency data
            (WallBlock.sourceVertex data wall sourceBlock) = 2 ∨
          nonDanglingValency data
            (WallBlock.sourceVertex data wall sourceBlock) = 3) :
    AuxR0SourceInput data star := by
  apply ofDimensionSaturatedExpansion right resolution hCompatible hContracts
    hBlockCard hTargetGenus
  · apply hCombinatorialType.correctionNonnegative hResolvedValid
    exact TargetExpansion.graph_connected target wall right hTargetConnected
  · exact hSaturated
  · exact valid
  · exact stablePath_card
  · exact dangling_no_glue
  · exact nonDangling_valency

/-- Equation (C) and the literal four-valent star force `ch(w₀) = 0`. -/
theorem targetChange_eq_zero
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    (input : AuxR0SourceInput data star) :
    data.targetChange wall = 0 := by
  have hCard := star.card_incidentEdges
  have hEquation := input.equation_c
  unfold GluingDatum.targetExcess at hEquation
  omega

/-- Reindex the target change through the four-star labels to recover the
block sum consumed by the existing auxiliary W4 constructors. -/
theorem change_zero
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    (input : AuxR0SourceInput data star) :
    ∑ sourceBlock : WallBlock data wall,
      AuxR0Profile.wallBlockRamification data star sourceBlock = 0 := by
  rw [← AuxR0Profile.targetChange_eq_sum_wallBlockRamification]
  exact input.targetChange_eq_zero

/-- The source matrix-row labelling is forced by the full-dimensional stable
path cardinality; no separate choice belongs in the source interface. -/
noncomputable def labelling
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    (input : AuxR0SourceInput data star) : StablePathLabelling data :=
  StablePathLabelling.ofCardEq data input.stablePath_card

/-- The literal active-label sets and dangling-no-glue determine the
canonical downstream active profile. -/
noncomputable def activeProfile
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    (input : AuxR0SourceInput data star) :
    ActiveBranchProfile data star :=
  activeBranchProfileOfDanglingNoGlue data star
    (activeLabels_card_zero_two_or_three_of_changeZero data star input.valid
      input.dangling_no_glue input.change_zero input.nonDangling_valency)
    input.dangling_no_glue

/-- Incoming validity and global Equation (C) determine every local r0
profile used to obtain the active nd2 one-block equalities. -/
theorem auxProfile
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    (input : AuxR0SourceInput data star) :
    AuxR0Profile data star input.activeProfile.blockPattern :=
  AuxR0Profile.ofValidChangeZero
    input.activeProfile.danglingSingletonProfile.exterior input.valid
      input.change_zero

/-- Construct the actual auxiliary picture selected by the canonical active
classification of one wall block, retaining definitional agreement with that
classification. -/
noncomputable def classifiedBlockPicture
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    (input : AuxR0SourceInput data star)
    (sourceBlock : WallBlock data wall) :
    {picture : AuxR0BlockPicture data star sourceBlock //
      picture.kind =
        (input.activeProfile.classification sourceBlock).kind} := by
  cases hClassification : input.activeProfile.classification sourceBlock with
  | dangling hActive =>
      have hActiveLiteral : (∅ : Finset (Fin 4)) =
          activeLabels data star sourceBlock := by
        simpa [activeProfile, activeBranchProfileOfDanglingNoGlue] using hActive
      have hOldDangling : ∀ (edge : data.SourceEdge) (label : Fin 4),
          WallBlock.ofSheet data wall edge.1.2 = sourceBlock →
          star.edge label = edge.1.1 →
          IsDangling data edge := by
        intro edge label hBlock hTarget
        by_contra hSurvives
        have hWallRel :
            (data.vertexPartition wall).Rel sourceBlock.1 edge.1.2 :=
          (WallBlock.ofSheet_eq_iff_rel data wall sourceBlock edge.1.2).1
            hBlock
        have hLiteral : label ∈ activeLabels data star sourceBlock :=
          (mem_activeLabels_iff data star sourceBlock label).2
            ⟨edge.1.2, hWallRel, by simpa [hTarget] using hSurvives⟩
        rw [← hActiveLiteral] at hLiteral
        simp at hLiteral
      exact ⟨.dangling hOldDangling, rfl⟩
  | nd2 block hActive =>
      have hActiveLiteral :
          block.activeLabels = activeLabels data star sourceBlock := by
        simpa [activeProfile, activeBranchProfileOfDanglingNoGlue] using hActive
      have hPattern :
          input.activeProfile.blockPattern sourceBlock.1 = .nd2 block := by
        rw [input.activeProfile.blockPattern_anchor]
        rw [hClassification]
        rfl
      obtain ⟨hFirstCount, hSecondCount⟩ :=
        input.auxProfile.nd2_active_blockCountWithin sourceBlock.1 block
          hPattern sourceBlock.1 rfl
      have hInjective :=
        nonDanglingStarInjective_of_active_blockCountWithin_eq_one data star
          sourceBlock (by
            intro label hLabel
            have hBlockLabel : label ∈ block.activeLabels := by
              rw [hActiveLiteral]
              exact hLabel
            rcases (block.mem_activeLabels label).1 hBlockLabel with
              hFirst | hSecond
            · subst label
              exact hFirstCount
            · subst label
              exact hSecondCount)
      have hFirstSurvives :=
        AuxR0Nd2Picture.first_survives_of_blockCountWithin_eq_one
          hActiveLiteral hFirstCount
      have hSecondSurvives :=
        AuxR0Nd2Picture.second_survives_of_blockCountWithin_eq_one
          hActiveLiteral hSecondCount
      have hConnected := consecutive_of_nd2_activeLabels data star sourceBlock
        block hActiveLiteral hInjective hFirstSurvives hSecondSurvives
      exact ⟨.nd2 block
          (AuxR0Nd2Picture.ofActiveLabelsAndCounts hActiveLiteral hFirstCount
            hSecondCount none hConnected hInjective), by
        rfl⟩
  | nd3 block hActive =>
      have hActiveLiteral :
          block.activeLabels = activeLabels data star sourceBlock := by
        simpa [activeProfile, activeBranchProfileOfDanglingNoGlue] using hActive
      have hActiveCard :
          (activeLabels data star sourceBlock).card = 3 := by
        rw [← hActiveLiteral]
        simp [Nd3Block.activeLabels, block.first_ne_second,
          block.first_ne_third, block.second_ne_third]
      have hValency :
          nonDanglingValency data
              (WallBlock.sourceVertex data wall sourceBlock) = 3 := by
        have hUpper := card_activeLabels_le_nonDanglingValency data star
          sourceBlock
        rcases input.nonDangling_valency sourceBlock with hZero | hTwo | hThree
        · omega
        · omega
        · exact hThree
      have hInjective :=
        nonDanglingStarInjective_of_card_activeLabels_eq_nonDanglingValency
          data star sourceBlock (hActiveCard.trans hValency.symm)
      exact ⟨.nd3 block
          (AuxR0Nd3Picture.ofActiveLabels hActiveLiteral
            hInjective), by
        rfl⟩

/-- Forget the retained pattern equality from `classifiedBlockPicture`. -/
noncomputable def blockPicture
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    (input : AuxR0SourceInput data star)
    (sourceBlock : WallBlock data wall) :
    AuxR0BlockPicture data star sourceBlock :=
  (input.classifiedBlockPicture sourceBlock).1

theorem blockPicture_kind
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    (input : AuxR0SourceInput data star)
    (sourceBlock : WallBlock data wall) :
    (input.blockPicture sourceBlock).kind =
      (input.activeProfile.classification sourceBlock).kind :=
  (input.classifiedBlockPicture sourceBlock).2

end AuxR0SourceInput

/-- Stable-source data for every W4 wall block before candidate regrowth. -/
structure AuxR0Family
    {wall : target.V}
    (data : GluingDatum target degree)
    (star : W4TargetPairings.FourStar target wall)
    (active : ActiveBranchProfile data star) where
  labelling : StablePathLabelling data
  block : ∀ sourceBlock : WallBlock data wall,
    AuxR0BlockPicture data star sourceBlock
  block_kind : ∀ sourceBlock,
    (block sourceBlock).kind =
      (active.classification sourceBlock).kind

/-- All stable-source pictures assembled from the minimal source-facing W4
input.  Pattern agreement is forced by the canonical active classification. -/
noncomputable def AuxR0SourceInput.family
    {wall : target.V}
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    (input : AuxR0SourceInput data star) :
    AuxR0Family data star input.activeProfile where
  labelling := input.labelling
  block := input.blockPicture
  block_kind := input.blockPicture_kind

namespace AuxR0Family

variable {wall : target.V}

/-- Canonical W4 regrowth forced by one auxiliary source picture.  An nd2
block regrows exactly for a separating pairing; an nd3 block regrows the
singleton branch's honest sheet. -/
noncomputable def regrown
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    {active : ActiveBranchProfile data star}
    (family : AuxR0Family data star active)
    (pairing : Fin 3) (sourceBlock : WallBlock data wall) :
    Option (Option target.edges × Fin degree) :=
  match family.block sourceBlock with
  | .dangling _ => none
  | .nd2 block picture =>
      if W4TargetPairings.Pairing.labelRight pairing block.first =
          W4TargetPairings.Pairing.labelRight pairing block.second then none
      else some (picture.oldRow family.labelling block.first, sourceBlock.1)
  | .nd3 block picture =>
      let label := block.singletonLabel pairing
      some (picture.oldRow family.labelling label,
        picture.activeSheet label)

/-- Every canonically regrown sheet lies in the old wall block that generated
it. -/
theorem regrown_block
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    {active : ActiveBranchProfile data star}
    (family : AuxR0Family data star active) :
    ∀ pairing sourceBlock row sheet,
      family.regrown pairing sourceBlock = some (row, sheet) →
      WallBlock.ofSheet data wall sheet = sourceBlock := by
  intro pairing sourceBlock row sheet hRegrown
  cases hPicture : family.block sourceBlock with
  | dangling old_dangling =>
      simp [regrown, hPicture] at hRegrown
  | nd2 block picture =>
      by_cases hSame :
          W4TargetPairings.Pairing.labelRight pairing block.first =
            W4TargetPairings.Pairing.labelRight pairing block.second
      · simp [regrown, hPicture, hSame] at hRegrown
      · have hPair :
            (picture.oldRow family.labelling block.first, sourceBlock.1) =
              (row, sheet) := by
          exact Option.some.inj (by
            simpa [regrown, hPicture, hSame] using hRegrown)
        have hSheet : sourceBlock.1 = sheet := congrArg Prod.snd hPair
        rw [← hSheet]
        exact WallBlock.ofSheet_anchor data wall sourceBlock
  | nd3 block picture =>
      let label := block.singletonLabel pairing
      have hPair :
          (picture.oldRow family.labelling label,
              picture.activeSheet label) = (row, sheet) := by
        exact Option.some.inj (by
          simpa [regrown, hPicture, label] using hRegrown)
      have hSheet : picture.activeSheet label = sheet :=
        congrArg Prod.snd hPair
      rw [← hSheet]
      apply WallBlock.ofSheet_eq_of_rel
      exact picture.active_sheet label
        (block.singletonLabel_mem_activeLabels pairing)

/-- The complete old-and-new finite path assignment generated by a family of
auxiliary source pictures. -/
noncomputable def assignment
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    {active : ActiveBranchProfile data star}
    (family : AuxR0Family data star active) :
    PathAssignment data wall :=
  family.labelling.toPathAssignment family.regrown family.regrown_block

@[simp] theorem assignment_regrown
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    {active : ActiveBranchProfile data star}
    (family : AuxR0Family data star active)
    (pairing : Fin 3) (sourceBlock : WallBlock data wall) :
    family.assignment.regrown pairing sourceBlock =
      family.regrown pairing sourceBlock :=
  rfl

/-- Each auxiliary source picture supplies the canonically selected dangling,
nd2, or nd3 membership theorem, including candidate regrowth. -/
noncomputable def blockMembership
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    [DecidableEq target.edges]
    {active : ActiveBranchProfile data star}
    (family : AuxR0Family data star active)
    (sourceBlock : WallBlock data wall) :
    ExpectedBlockMembership data star family.assignment active sourceBlock := by
  cases hClassification : active.classification sourceBlock with
  | dangling hActive =>
      unfold ExpectedBlockMembership
      rw [hClassification]
      cases hPicture : family.block sourceBlock with
      | dangling old_dangling =>
          exact {
            regrown_none := by
              intro pairing
              rw [family.assignment_regrown]
              simp [regrown, hPicture]
            old_none := by
              intro edge hBlock hColumn
              apply (family.labelling.oldRowOf_eq_none_iff edge).2
              have hStar : ∃ label : Fin 4, star.edge label = edge.1.1 := by
                simpa [canonicalW4OldColumns] using hColumn
              obtain ⟨label, hTarget⟩ := hStar
              exact old_dangling edge label hBlock hTarget }
      | nd2 actual picture =>
          have hKind := family.block_kind sourceBlock
          rw [hPicture, hClassification] at hKind
          exact ActiveBlockClassification.Kind.noConfusion hKind
      | nd3 actual picture =>
          have hKind := family.block_kind sourceBlock
          rw [hPicture, hClassification] at hKind
          exact ActiveBlockClassification.Kind.noConfusion hKind
  | nd2 block hActive =>
      unfold ExpectedBlockMembership
      rw [hClassification]
      cases hPicture : family.block sourceBlock with
      | dangling old_dangling =>
          have hKind := family.block_kind sourceBlock
          rw [hPicture, hClassification] at hKind
          exact ActiveBlockClassification.Kind.noConfusion hKind
      | nd2 actual picture =>
          have hKind := family.block_kind sourceBlock
          rw [hPicture, hClassification] at hKind
          have hActual : actual = block :=
            ActiveBlockClassification.Kind.nd2.inj hKind
          subst actual
          exact {
            newRow := fun _ ↦ picture.oldRow family.labelling block.first
            oldRow := picture.oldRow family.labelling
            regrown_mem := by
              intro pairing row sheet
              rw [family.assignment_regrown]
              by_cases hSame :
                  W4TargetPairings.Pairing.labelRight pairing block.first =
                    W4TargetPairings.Pairing.labelRight pairing block.second
              · simp [regrown, hPicture, nd2NewOccurrences, hSame]
              · simp [regrown, hPicture, nd2NewOccurrences, hSame, eq_comm]
            old_mem := by
              simpa only [assignment] using
                picture.toPathAssignment_old_mem family.labelling family.regrown
                  family.regrown_block
            new_row := by intros; rfl
            old_row := picture.oldRow_first_eq_second family.labelling }
      | nd3 actual picture =>
          have hKind := family.block_kind sourceBlock
          rw [hPicture, hClassification] at hKind
          exact ActiveBlockClassification.Kind.noConfusion hKind
  | nd3 block hActive =>
      unfold ExpectedBlockMembership
      rw [hClassification]
      cases hPicture : family.block sourceBlock with
      | dangling old_dangling =>
          have hKind := family.block_kind sourceBlock
          rw [hPicture, hClassification] at hKind
          exact ActiveBlockClassification.Kind.noConfusion hKind
      | nd2 actual picture =>
          have hKind := family.block_kind sourceBlock
          rw [hPicture, hClassification] at hKind
          exact ActiveBlockClassification.Kind.noConfusion hKind
      | nd3 actual picture =>
          have hKind := family.block_kind sourceBlock
          rw [hPicture, hClassification] at hKind
          have hActual : actual = block :=
            ActiveBlockClassification.Kind.nd3.inj hKind
          subst actual
          exact {
            activeSheet := picture.activeSheet
            active_sheet := picture.active_sheet
            newRow := fun pairing ↦ picture.oldRow family.labelling
              (block.singletonLabel pairing)
            oldRow := picture.oldRow family.labelling
            regrown_mem := by
              intro pairing row sheet
              rw [family.assignment_regrown]
              simp [regrown, hPicture, nd3NewOccurrences, eq_comm]
            old_mem := by
              simpa only [assignment] using
                picture.toPathAssignment_old_mem family.labelling family.regrown
                  family.regrown_block
            new_row := by intros; rfl }

/-- A family of auxiliary source pictures generates every block-local
membership theorem required by the finite W4 assignment. -/
noncomputable def familyMembership
    {data : GluingDatum target degree}
    {star : W4TargetPairings.FourStar target wall}
    [DecidableEq target.edges]
    {active : ActiveBranchProfile data star}
    (family : AuxR0Family data star active) :
    FamilyMembership data star active where
  assignment := family.assignment
  block := family.blockMembership

/-- The stable source pictures, together with incoming validity and Equation
(C), produce the complete semantic W4 family. -/
noncomputable def presentedFamily
    (data : GluingDatum target degree)
    (star : W4TargetPairings.FourStar target wall)
    [DecidableEq target.edges]
    (hValid : data.Valid)
    (active : ActiveBranchProfile data star)
    (hChangeZero :
      ∑ sourceBlock : WallBlock data wall,
        AuxR0Profile.wallBlockRamification data star sourceBlock = 0)
    (family : AuxR0Family data star active) :
    BalancedGlobal.PresentedFamily (coordinate := Option target.edges)
      3 data wall :=
  presentedFamilyOfStablePathAssignment data star hValid active hChangeZero
    family.familyMembership

end AuxR0Family

/-- The minimal inherited source facts in `AuxR0SourceInput` produce the
complete three-candidate semantic W4 family.  Everything after this theorem
is already handled by the proved global W4 wall-crossing machinery. -/
noncomputable def AuxR0SourceInput.presentedFamily
    (data : GluingDatum target degree)
    {wall : target.V}
    (star : W4TargetPairings.FourStar target wall)
    [DecidableEq target.edges]
    (input : AuxR0SourceInput data star) :
    BalancedGlobal.PresentedFamily (coordinate := Option target.edges)
      3 data wall :=
  input.family.presentedFamily data star input.valid input.activeProfile
    input.change_zero

/-! ## Danglingness propagates across a divalent source vertex

The paper's second half of "a full-rank discrete tropical morphism is a
combinatorial type" needs the following graph fact about the occurrence-safe
dangling certificate: if one occurrence at a source vertex of graph degree
two is dangling, so is the other.  The cut is simply moved across that vertex,
which changes each induced side by one pendant vertex and therefore preserves
both connectivity and genus.
-/



/-! ## Occurrence bookkeeping in the literal quotient source -/

/-- Edge multiplicity in the literal quotient source counts the occurrences
joining the two chosen source vertices. -/
theorem num_edges_sourceGraph_eq_card_filter
    (data : GluingDatum target degree) (first second : data.SourceVertex) :
    num_edges data.sourceGraph first second =
      ((Finset.univ : Finset data.SourceEdge).filter fun edge ↦
        data.sourceEnds edge = (first, second) ∨
          data.sourceEnds edge = (second, first)).card := by
  classical
  rw [GluingDatum.SheetRelabeling.num_edges_sourceGraph_eq_sum,
    Finset.card_filter]

/-- An occurrence between two source vertices gives positive multiplicity. -/
theorem num_edges_pos_of_sourceEnds
    (data : GluingDatum target degree) {edge : data.SourceEdge}
    {first second : data.SourceVertex}
    (hEnds : data.sourceEnds edge = (first, second) ∨
      data.sourceEnds edge = (second, first)) :
    0 < num_edges data.sourceGraph first second := by
  classical
  rw [num_edges_sourceGraph_eq_card_filter]
  exact Finset.card_pos.mpr ⟨edge, Finset.mem_filter.mpr
    ⟨Finset.mem_univ edge, hEnds⟩⟩

/-- Positive multiplicity produces an occurrence with the given endpoints. -/
theorem exists_sourceEnds_of_num_edges_pos
    (data : GluingDatum target degree) {first second : data.SourceVertex}
    (hPos : 0 < num_edges data.sourceGraph first second) :
    ∃ edge : data.SourceEdge,
      data.sourceEnds edge = (first, second) ∨
        data.sourceEnds edge = (second, first) := by
  classical
  rw [num_edges_sourceGraph_eq_card_filter] at hPos
  obtain ⟨edge, hEdge⟩ := Finset.card_pos.mp hPos
  exact ⟨edge, (Finset.mem_filter.mp hEdge).2⟩

/-- Two distinct occurrences with the same pair of endpoints give edge
multiplicity at least two. -/
theorem two_le_num_edges_of_ne
    (data : GluingDatum target degree) {first second : data.SourceEdge}
    {left right : data.SourceVertex} (hNe : first ≠ second)
    (hFirst : data.sourceEnds first = (left, right) ∨
      data.sourceEnds first = (right, left))
    (hSecond : data.sourceEnds second = (left, right) ∨
      data.sourceEnds second = (right, left)) :
    2 ≤ num_edges data.sourceGraph left right := by
  classical
  rw [num_edges_sourceGraph_eq_card_filter]
  have hSubset : ({first, second} : Finset data.SourceEdge) ⊆
      (Finset.univ : Finset data.SourceEdge).filter fun edge ↦
        data.sourceEnds edge = (left, right) ∨
          data.sourceEnds edge = (right, left) := by
    intro edge hEdge
    rcases Finset.mem_insert.mp hEdge with hEdge | hEdge
    · exact Finset.mem_filter.mpr ⟨Finset.mem_univ edge, hEdge ▸ hFirst⟩
    · have hEdge' : edge = second := Finset.mem_singleton.mp hEdge
      exact Finset.mem_filter.mpr ⟨Finset.mem_univ edge, hEdge' ▸ hSecond⟩
  have hCard := Finset.card_le_card hSubset
  rwa [Finset.card_pair hNe] at hCard

/-- The other endpoint of an occurrence incident to a source vertex. -/
theorem exists_other_sourceEnd
    (data : GluingDatum target degree) {edge : data.SourceEdge}
    {vertex : data.SourceVertex} (hIncident : Incident data edge vertex) :
    ∃ other : data.SourceVertex,
      data.sourceEnds edge = (vertex, other) ∨
        data.sourceEnds edge = (other, vertex) := by
  rcases hIncident with hLeft | hRight
  · exact ⟨(data.sourceEnds edge).2, Or.inl (by
      rw [← hLeft])⟩
  · exact ⟨(data.sourceEnds edge).1, Or.inr (by
      rw [← hRight])⟩

/-- Incidence read off from the ordered endpoints. -/
theorem incident_of_sourceEnds
    (data : GluingDatum target degree) {edge : data.SourceEdge}
    {first second : data.SourceVertex}
    (hEnds : data.sourceEnds edge = (first, second) ∨
      data.sourceEnds edge = (second, first)) :
    Incident data edge first := by
  rcases hEnds with hEnds | hEnds
  · exact Or.inl (by rw [hEnds])
  · exact Or.inr (by rw [hEnds])

/-- At a source vertex of graph degree two, only the two named incident
occurrences are incident. -/
theorem eq_of_incident_of_vertex_degree_eq_two
    (data : GluingDatum target degree) {first second edge : data.SourceEdge}
    {vertex : data.SourceVertex} (hNe : first ≠ second)
    (hFirst : Incident data first vertex) (hSecond : Incident data second vertex)
    (hDegree : vertex_degree data.sourceGraph vertex = 2)
    (hEdge : Incident data edge vertex) :
    edge = first ∨ edge = second := by
  classical
  by_contra hNeither
  push Not at hNeither
  have hCard : Fintype.card (IncidentSourceEdge data vertex) = 2 := by
    have := vertex_degree_sourceGraph_eq_card_incidentSourceEdge data vertex
    rw [hDegree] at this
    exact_mod_cast this.symm
  let firstItem : IncidentSourceEdge data vertex := ⟨first, hFirst⟩
  let secondItem : IncidentSourceEdge data vertex := ⟨second, hSecond⟩
  let edgeItem : IncidentSourceEdge data vertex := ⟨edge, hEdge⟩
  have hFirstNe : firstItem ≠ secondItem := fun h ↦ hNe (congrArg Subtype.val h)
  have hEdgeNeFirst : edgeItem ≠ firstItem :=
    fun h ↦ hNeither.1 (congrArg Subtype.val h)
  have hEdgeNeSecond : edgeItem ≠ secondItem :=
    fun h ↦ hNeither.2 (congrArg Subtype.val h)
  have hTripleCard :
      ({firstItem, secondItem, edgeItem} :
        Finset (IncidentSourceEdge data vertex)).card = 3 := by
    rw [Finset.card_insert_of_notMem (by
        simp [hFirstNe, hEdgeNeFirst.symm]),
      Finset.card_insert_of_notMem (by
        simp [hEdgeNeSecond.symm]),
      Finset.card_singleton]
  have hLe :
      ({firstItem, secondItem, edgeItem} :
        Finset (IncidentSourceEdge data vertex)).card ≤
      Fintype.card (IncidentSourceEdge data vertex) :=
    Finset.card_le_univ _
  omega



/-! ## Pendant vertices of induced subgraphs -/

private theorem mem_of_mem_erase_eq {G : CFGraph} {vertices erased : Finset G.V}
    {vertex value : G.V} (hEq : erased = vertices.erase vertex)
    (hValue : value ∈ erased) : value ∈ vertices ∧ value ≠ vertex := by
  subst hEq
  exact ⟨(Finset.mem_erase.mp hValue).2, (Finset.mem_erase.mp hValue).1⟩

private theorem mem_erase_eq_of {G : CFGraph} {vertices erased : Finset G.V}
    {vertex value : G.V} (hEq : erased = vertices.erase vertex)
    (hValue : value ∈ vertices) (hNe : value ≠ vertex) : value ∈ erased := by
  subst hEq
  exact Finset.mem_erase.mpr ⟨hNe, hValue⟩

/-- Vertex degree inside an induced subgraph is the ambient degree restricted
to the inducing set. -/
private theorem vertex_degree_inducedSubgraph
    (G : CFGraph) (vertices : Finset G.V) (hNonempty : vertices.Nonempty)
    (vertex : G.V) (hVertex : vertex ∈ vertices) :
    vertex_degree (Utilities.inducedSubgraph G vertices hNonempty)
        ⟨vertex, hVertex⟩ =
      ∑ other ∈ vertices, (num_edges G vertex other : ℤ) := by
  unfold vertex_degree
  rw [← Finset.sum_coe_sort vertices
    (fun other ↦ (num_edges G vertex other : ℤ))]
  apply Finset.sum_congr rfl
  intro other _
  exact_mod_cast Utilities.num_edges_inducedSubgraph G vertices hNonempty
    ⟨vertex, hVertex⟩ other

/-- Erasing a degree-one vertex of an induced subgraph is again an induced
subgraph, up to the canonical relabelling. -/
private noncomputable def erasedInducedLaplacianEquiv
    (G : CFGraph) (vertices erased : Finset G.V) (hNonempty : vertices.Nonempty)
    (hErased : erased.Nonempty) (vertex : G.V) (hVertex : vertex ∈ vertices)
    (hEq : erased = vertices.erase vertex)
    (hDegree : vertex_degree (Utilities.inducedSubgraph G vertices hNonempty)
      ⟨vertex, hVertex⟩ = 1) :
    Utilities.Certificate.LaplacianEquiv
      (Utilities.Certificate.LeafPruning.deleteLeaf
        (Utilities.inducedSubgraph G vertices hNonempty)
        ⟨vertex, hVertex⟩ hDegree)
      (Utilities.inducedSubgraph G erased hErased) where
  toEquiv :=
    { toFun := fun item ↦ ⟨item.1.1, mem_erase_eq_of hEq item.1.2
        fun hValue ↦ item.2 (Subtype.ext hValue)⟩
      invFun := fun item ↦ ⟨⟨item.1, (mem_of_mem_erase_eq hEq item.2).1⟩,
        fun hValue ↦ (mem_of_mem_erase_eq hEq item.2).2
          (congrArg Subtype.val hValue)⟩
      left_inv := fun _ ↦ rfl
      right_inv := fun _ ↦ rfl }
  num_edges_eq := by
    intro left right
    have hErasedEdges := Utilities.num_edges_inducedSubgraph G erased hErased
      ⟨left.1.1, mem_erase_eq_of hEq left.1.2
        fun hValue ↦ left.2 (Subtype.ext hValue)⟩
      ⟨right.1.1, mem_erase_eq_of hEq right.1.2
        fun hValue ↦ right.2 (Subtype.ext hValue)⟩
    have hInduced := Utilities.num_edges_inducedSubgraph G vertices hNonempty
      left.1 right.1
    have hDeleted := Utilities.Certificate.LeafPruning.num_edges_deleteLeaf
      (Utilities.inducedSubgraph G vertices hNonempty) ⟨vertex, hVertex⟩
      hDegree left right
    exact hErasedEdges.trans (hInduced.symm.trans hDeleted.symm)

/-- Erasing a pendant vertex of an induced subgraph preserves genus and
connectivity.  Both directions are available, so the same lemma also inserts
a pendant vertex. -/
private theorem inducedSubgraph_erase_pendant
    (G : CFGraph) (vertices erased : Finset G.V) (hNonempty : vertices.Nonempty)
    (hErased : erased.Nonempty) (vertex : G.V) (hVertex : vertex ∈ vertices)
    (hEq : erased = vertices.erase vertex)
    (hDegree : ∑ other ∈ vertices, (num_edges G vertex other : ℤ) = 1) :
    genus (Utilities.inducedSubgraph G erased hErased) =
        genus (Utilities.inducedSubgraph G vertices hNonempty) ∧
      (graph_connected (Utilities.inducedSubgraph G erased hErased) ↔
        graph_connected (Utilities.inducedSubgraph G vertices hNonempty)) := by
  have hLeaf : vertex_degree (Utilities.inducedSubgraph G vertices hNonempty)
      ⟨vertex, hVertex⟩ = 1 := by
    rw [vertex_degree_inducedSubgraph G vertices hNonempty vertex hVertex]
    exact hDegree
  have hEquiv := erasedInducedLaplacianEquiv G vertices erased hNonempty
    hErased vertex hVertex hEq hLeaf
  refine ⟨?_, ?_⟩
  · rw [hEquiv.genus_eq]
    exact Utilities.Certificate.LeafReduction.genus_deleteLeaf _ _ hLeaf
  · rw [← hEquiv.graphConnected_iff]
    exact Utilities.Certificate.LeafReduction.graph_connected_deleteLeaf_iff
      _ _ hLeaf



/-- Two descriptions of the same occurrence's endpoints agree as unordered
pairs. -/
theorem sourceEnds_pair_eq (data : GluingDatum target degree)
    {edge : data.SourceEdge} {a b c d : data.SourceVertex}
    (hFirst : data.sourceEnds edge = (a, b) ∨ data.sourceEnds edge = (b, a))
    (hSecond : data.sourceEnds edge = (c, d) ∨ data.sourceEnds edge = (d, c)) :
    (a = c ∧ b = d) ∨ (a = d ∧ b = c) := by
  rcases hFirst with hFirst | hFirst <;> rcases hSecond with hSecond | hSecond <;>
    rw [hFirst] at hSecond <;> simp only [Prod.mk.injEq] at hSecond
  · exact Or.inl ⟨hSecond.1, hSecond.2⟩
  · exact Or.inr ⟨hSecond.1, hSecond.2⟩
  · exact Or.inr ⟨hSecond.2, hSecond.1⟩
  · exact Or.inl ⟨hSecond.2, hSecond.1⟩


/-! ## Degree-two accounting -/

/-- At a vertex of graph degree two with two distinct named neighbours, both
multiplicities are one and every other multiplicity vanishes. -/
private theorem num_edges_of_vertex_degree_eq_two
    (G : CFGraph) {vertex left right : G.V} (hNe : left ≠ right)
    (hLeft : 1 ≤ num_edges G vertex left)
    (hRight : 1 ≤ num_edges G vertex right)
    (hDegree : vertex_degree G vertex = 2) :
    num_edges G vertex left = 1 ∧ num_edges G vertex right = 1 ∧
      ∀ other : G.V, other ≠ left → other ≠ right →
        num_edges G vertex other = 0 := by
  classical
  have hNonneg : ∀ other : G.V, (0 : ℤ) ≤ (num_edges G vertex other : ℤ) :=
    fun _ ↦ Int.natCast_nonneg _
  have hTotal : (∑ other : G.V, (num_edges G vertex other : ℤ)) = 2 := hDegree
  have hPair :
      (num_edges G vertex left : ℤ) + (num_edges G vertex right : ℤ) ≤ 2 := by
    have hBound := Finset.sum_le_sum_of_subset_of_nonneg
      (Finset.subset_univ ({left, right} : Finset G.V))
      (fun other _ _ ↦ hNonneg other)
    rw [Finset.sum_pair hNe, hTotal] at hBound
    exact hBound
  refine ⟨by omega, by omega, ?_⟩
  intro other hOtherLeft hOtherRight
  have hBound := Finset.sum_le_sum_of_subset_of_nonneg
    (Finset.subset_univ ({left, right, other} : Finset G.V))
    (fun item _ _ ↦ hNonneg item)
  rw [Finset.sum_insert (by simp [hNe, Ne.symm hOtherLeft]),
    Finset.sum_pair (Ne.symm hOtherRight), hTotal] at hBound
  omega

/-! ## Propagating a dangling cut across a divalent vertex -/

/-- Moving the cut across a divalent vertex lying outside the genus-zero
side: the new side is the old side together with that vertex. -/
private theorem nonempty_danglingSide_insert
    (G : CFGraph) {inside outside far : G.V}
    (cut : DanglingSide G inside outside)
    (hInsideEdge : 1 ≤ num_edges G inside outside)
    (hFarEdge : 1 ≤ num_edges G outside far)
    (hMultiplicity : inside = far → 2 ≤ num_edges G inside outside)
    (hDegree : vertex_degree G outside = 2) :
    Nonempty (DanglingSide G outside far) := by
  classical
  have hInside : inside ∈ cut.side := cut.left_mem
  have hOutside : outside ∉ cut.side := cut.right_not_mem
  have hEndpointsOne : num_edges G inside outside = 1 := by
    have hCross := cut.cross_num_edges inside outside hInside hOutside
    rwa [if_pos ⟨rfl, rfl⟩] at hCross
  have hFarNotMem : far ∉ cut.side := by
    intro hFar
    have hCross := cut.cross_num_edges far outside hFar hOutside
    have hPos : 1 ≤ num_edges G far outside := by
      rw [num_edges_symmetric G far outside]
      exact hFarEdge
    by_cases hCase : far = inside
    · have := hMultiplicity hCase.symm
      omega
    · rw [if_neg fun h ↦ hCase h.1] at hCross
      omega
  have hFarNeOutside : far ≠ outside := by
    intro hEqual
    have hZero : num_edges G outside outside = 0 := num_edges_self_zero G outside
    rw [hEqual] at hFarEdge
    omega
  have hInsideNeFar : inside ≠ far := fun h ↦ hFarNotMem (by
    rw [← h]; exact hInside)
  have hLocal := num_edges_of_vertex_degree_eq_two G hInsideNeFar
    (by rw [num_edges_symmetric G outside inside]; exact hInsideEdge)
    hFarEdge hDegree
  have hSideSum :
      ∑ item ∈ cut.side, (num_edges G outside item : ℤ) = 1 := by
    have hTerms : ∀ item ∈ cut.side,
        (num_edges G outside item : ℤ) = if item = inside then 1 else 0 := by
      intro item hItem
      by_cases hCase : item = inside
      · rw [if_pos hCase, hCase, hLocal.1]
        norm_num
      · rw [if_neg hCase,
          hLocal.2.2 item hCase fun h ↦ hFarNotMem (by
            rw [← h]; exact hItem)]
        norm_num
    rw [Finset.sum_congr rfl hTerms]
    simp [hInside]
  have hTotalSum :
      (∑ item : G.V, (num_edges G outside item : ℤ)) = 2 := hDegree
  have hComplementSum :
      ∑ item ∈ (Finset.univ \ cut.side), (num_edges G outside item : ℤ) = 1 := by
    have hSplit := Finset.sum_sdiff (s₁ := cut.side)
      (s₂ := (Finset.univ : Finset G.V))
      (f := fun item ↦ (num_edges G outside item : ℤ))
      (Finset.subset_univ _)
    rw [hSideSum, hTotalSum] at hSplit
    omega
  have hInsertSum :
      ∑ item ∈ insert outside cut.side, (num_edges G outside item : ℤ) = 1 := by
    rw [Finset.sum_insert hOutside, hSideSum, num_edges_self_zero]
    norm_num
  have hSidePendant := inducedSubgraph_erase_pendant G
    (insert outside cut.side) cut.side ⟨outside, Finset.mem_insert_self _ _⟩
    ⟨inside, hInside⟩ outside (Finset.mem_insert_self _ _)
    (Finset.erase_insert hOutside).symm hInsertSum
  have hComplementPendant := inducedSubgraph_erase_pendant G
    (Finset.univ \ cut.side) (Finset.univ \ insert outside cut.side)
    ⟨outside, by simp [hOutside]⟩
    ⟨far, by simp [hFarNeOutside, hFarNotMem]⟩ outside (by simp [hOutside])
    (by
      ext item
      simp only [Finset.mem_sdiff, Finset.mem_univ, true_and,
        Finset.mem_insert, Finset.mem_erase, not_or])
    hComplementSum
  exact ⟨
    { side := insert outside cut.side
      left_mem := Finset.mem_insert_self _ _
      right_not_mem := by simp [hFarNeOutside, hFarNotMem]
      cross_num_edges := by
        intro one two hOne hTwo
        have hTwoNeOutside : two ≠ outside := fun h ↦ hTwo (by
          rw [h]; exact Finset.mem_insert_self outside cut.side)
        by_cases hPair : one = outside ∧ two = far
        · rw [if_pos hPair, hPair.1, hPair.2]
          exact hLocal.2.1
        · rw [if_neg hPair]
          by_cases hOneOutside : one = outside
          · have hTwoNeFar : two ≠ far := fun h ↦ hPair ⟨hOneOutside, h⟩
            have hTwoNeInside : two ≠ inside := fun h ↦ hTwo (by
              rw [h]; exact Finset.mem_insert_of_mem hInside)
            rw [hOneOutside]
            exact hLocal.2.2 two hTwoNeInside hTwoNeFar
          · have hOneSide : one ∈ cut.side :=
              (Finset.mem_insert.mp hOne).resolve_left hOneOutside
            have hTwoSide : two ∉ cut.side := fun h ↦
              hTwo (Finset.mem_insert_of_mem h)
            have hCross := cut.cross_num_edges one two hOneSide hTwoSide
            rwa [if_neg fun h ↦ hTwoNeOutside h.2] at hCross
      side_connected := hSidePendant.2.mp cut.side_connected
      complement_connected := hComplementPendant.2.mpr cut.complement_connected
      side_genus_zero := hSidePendant.1.symm.trans cut.side_genus_zero }⟩

/-- Moving the cut across a divalent vertex lying inside the genus-zero side:
the new side is the old side with that vertex erased. -/
private theorem nonempty_danglingSide_erase
    (G : CFGraph) {inside outside far : G.V}
    (cut : DanglingSide G inside outside)
    (hInsideEdge : 1 ≤ num_edges G inside outside)
    (hFarEdge : 1 ≤ num_edges G inside far)
    (hMultiplicity : far = outside → 2 ≤ num_edges G inside outside)
    (hDegree : vertex_degree G inside = 2) :
    Nonempty (DanglingSide G far inside) := by
  classical
  have hInside : inside ∈ cut.side := cut.left_mem
  have hOutside : outside ∉ cut.side := cut.right_not_mem
  have hEndpointsOne : num_edges G inside outside = 1 := by
    have hCross := cut.cross_num_edges inside outside hInside hOutside
    rwa [if_pos ⟨rfl, rfl⟩] at hCross
  have hFarMem : far ∈ cut.side := by
    by_contra hFarNot
    have hCross := cut.cross_num_edges inside far hInside hFarNot
    by_cases hCase : far = outside
    · have := hMultiplicity hCase
      omega
    · rw [if_neg fun h ↦ hCase h.2] at hCross
      omega
  have hFarNeInside : far ≠ inside := by
    intro hEqual
    have hZero : num_edges G inside inside = 0 := num_edges_self_zero G inside
    rw [hEqual] at hFarEdge
    omega
  have hOutsideNeFar : outside ≠ far := fun h ↦
    hOutside (h.symm ▸ hFarMem)
  have hLocal := num_edges_of_vertex_degree_eq_two G hOutsideNeFar
    hInsideEdge hFarEdge hDegree
  have hSideSum :
      ∑ item ∈ cut.side, (num_edges G inside item : ℤ) = 1 := by
    have hTerms : ∀ item ∈ cut.side,
        (num_edges G inside item : ℤ) = if item = far then 1 else 0 := by
      intro item hItem
      by_cases hCase : item = far
      · rw [if_pos hCase, hCase, hLocal.2.1]
        norm_num
      · rw [if_neg hCase,
          hLocal.2.2 item (fun h ↦ hOutside (h ▸ hItem)) hCase]
        norm_num
    rw [Finset.sum_congr rfl hTerms]
    simp [hFarMem]
  have hTotalSum :
      (∑ item : G.V, (num_edges G inside item : ℤ)) = 2 := hDegree
  have hComplementSum :
      ∑ item ∈ (Finset.univ \ cut.side), (num_edges G inside item : ℤ) = 1 := by
    have hSplit := Finset.sum_sdiff (s₁ := cut.side)
      (s₂ := (Finset.univ : Finset G.V))
      (f := fun item ↦ (num_edges G inside item : ℤ))
      (Finset.subset_univ _)
    rw [hSideSum, hTotalSum] at hSplit
    omega
  have hComplementErase :
      (Finset.univ : Finset G.V) \ cut.side.erase inside =
        insert inside (Finset.univ \ cut.side) := by
    ext item
    simp only [Finset.mem_sdiff, Finset.mem_univ, true_and, Finset.mem_erase,
      Finset.mem_insert, not_and]
    constructor
    · intro hItem
      by_cases hCase : item = inside
      · exact Or.inl hCase
      · exact Or.inr (hItem hCase)
    · rintro (hItem | hItem)
      · intro hNe
        exact absurd hItem hNe
      · intro _
        exact hItem
  have hComplementInsertSum :
      ∑ item ∈ (Finset.univ \ cut.side.erase inside),
        (num_edges G inside item : ℤ) = 1 := by
    rw [hComplementErase, Finset.sum_insert (by simp [hInside]),
      hComplementSum, num_edges_self_zero]
    norm_num
  have hSidePendant := inducedSubgraph_erase_pendant G
    cut.side (cut.side.erase inside) ⟨inside, hInside⟩
    ⟨far, Finset.mem_erase.mpr ⟨hFarNeInside, hFarMem⟩⟩ inside hInside rfl
    hSideSum
  have hComplementPendant := inducedSubgraph_erase_pendant G
    (Finset.univ \ cut.side.erase inside) (Finset.univ \ cut.side)
    ⟨inside, by simp⟩ ⟨outside, by simp [hOutside]⟩ inside (by simp)
    (by
      ext item
      simp only [Finset.mem_sdiff, Finset.mem_univ, true_and,
        Finset.mem_erase, not_and]
      constructor
      · intro hItem
        exact ⟨fun hEqual ↦ absurd hInside (hEqual ▸ hItem), fun _ ↦ hItem⟩
      · rintro ⟨hNe, hItem⟩
        exact hItem hNe)
    hComplementInsertSum
  exact ⟨
    { side := cut.side.erase inside
      left_mem := Finset.mem_erase.mpr ⟨hFarNeInside, hFarMem⟩
      right_not_mem := by simp
      cross_num_edges := by
        intro one two hOne hTwo
        have hOneNeInside : one ≠ inside := (Finset.mem_erase.mp hOne).1
        have hOneSide : one ∈ cut.side := (Finset.mem_erase.mp hOne).2
        by_cases hPair : one = far ∧ two = inside
        · rw [if_pos hPair, hPair.1, hPair.2,
            num_edges_symmetric G far inside]
          exact hLocal.2.1
        · rw [if_neg hPair]
          by_cases hTwoInside : two = inside
          · have hOneNeFar : one ≠ far := fun h ↦ hPair ⟨h, hTwoInside⟩
            have hOneNeOutside : one ≠ outside := fun h ↦
              hOutside (h ▸ hOneSide)
            rw [hTwoInside, num_edges_symmetric G one inside]
            exact hLocal.2.2 one hOneNeOutside hOneNeFar
          · have hTwoSide : two ∉ cut.side := fun h ↦
              hTwo (Finset.mem_erase.mpr ⟨hTwoInside, h⟩)
            have hCross := cut.cross_num_edges one two hOneSide hTwoSide
            rwa [if_neg fun h ↦ hOneNeInside h.1] at hCross
      side_connected := hSidePendant.2.mpr cut.side_connected
      complement_connected := hComplementPendant.2.mp cut.complement_connected
      side_genus_zero := hSidePendant.1.trans cut.side_genus_zero }⟩

/-- A cut oriented along the endpoints of an occurrence certifies that the
occurrence is dangling. -/
theorem isDangling_of_danglingSide
    (data : GluingDatum target degree) {edge : data.SourceEdge}
    {one two : data.SourceVertex}
    (hEnds : data.sourceEnds edge = (one, two) ∨
      data.sourceEnds edge = (two, one))
    (side : DanglingSide data.sourceGraph one two) :
    IsDangling data edge := by
  rcases hEnds with hEnds | hEnds
  · exact Or.inl (by rw [hEnds]; exact ⟨side⟩)
  · exact Or.inr (by rw [hEnds]; exact ⟨side⟩)

/-- Danglingness propagates across a source vertex of graph degree two. -/
theorem isDangling_of_incident_of_vertex_degree_eq_two
    (data : GluingDatum target degree)
    {first second : data.SourceEdge} {vertex : data.SourceVertex}
    (hNe : first ≠ second)
    (hFirst : Incident data first vertex)
    (hSecond : Incident data second vertex)
    (hDegree : vertex_degree data.sourceGraph vertex = 2)
    (hDangling : IsDangling data first) :
    IsDangling data second := by
  obtain ⟨far, hSecondEnds⟩ := exists_other_sourceEnd data hSecond
  have hMain : ∀ inside outside : data.SourceVertex,
      DanglingSide data.sourceGraph inside outside →
      (data.sourceEnds first = (inside, outside) ∨
        data.sourceEnds first = (outside, inside)) →
      IsDangling data second := by
    intro inside outside cut hFirstEnds
    have hInsideEdge : 1 ≤ num_edges data.sourceGraph inside outside :=
      num_edges_pos_of_sourceEnds data hFirstEnds
    have hVertexCases : vertex = inside ∨ vertex = outside := by
      rcases hFirstEnds with hEnds | hEnds <;> rcases hFirst with hInc | hInc <;>
        rw [hEnds] at hInc
      · exact Or.inl hInc.symm
      · exact Or.inr hInc.symm
      · exact Or.inr hInc.symm
      · exact Or.inl hInc.symm
    rcases hVertexCases with hCase | hCase
    · have hFarEdge : 1 ≤ num_edges data.sourceGraph inside far := by
        rw [← hCase]
        exact num_edges_pos_of_sourceEnds data hSecondEnds
      have hMultiplicity : far = outside →
          2 ≤ num_edges data.sourceGraph inside outside := by
        intro hFarOutside
        refine two_le_num_edges_of_ne data hNe hFirstEnds ?_
        rw [← hCase, ← hFarOutside]
        exact hSecondEnds
      have hDegreeInside : vertex_degree data.sourceGraph inside = 2 := by
        rw [← hCase]
        exact hDegree
      obtain ⟨newCut⟩ := nonempty_danglingSide_erase data.sourceGraph cut
        hInsideEdge hFarEdge hMultiplicity hDegreeInside
      refine isDangling_of_danglingSide data ?_ newCut
      rw [← hCase]
      exact Or.symm hSecondEnds
    · have hFarEdge : 1 ≤ num_edges data.sourceGraph outside far := by
        rw [← hCase]
        exact num_edges_pos_of_sourceEnds data hSecondEnds
      have hMultiplicity : inside = far →
          2 ≤ num_edges data.sourceGraph inside outside := by
        intro hInsideFar
        refine two_le_num_edges_of_ne data hNe hFirstEnds ?_
        rw [← hCase, hInsideFar]
        exact Or.symm hSecondEnds
      have hDegreeOutside : vertex_degree data.sourceGraph outside = 2 := by
        rw [← hCase]
        exact hDegree
      obtain ⟨newCut⟩ := nonempty_danglingSide_insert data.sourceGraph cut
        hInsideEdge hFarEdge hMultiplicity hDegreeOutside
      refine isDangling_of_danglingSide data ?_ newCut
      rw [← hCase]
      exact hSecondEnds
  rcases hDangling with hSide | hSide
  · exact hSide.elim fun cut ↦ hMain _ _ cut (Or.inl rfl)
  · exact hSide.elim fun cut ↦ hMain _ _ cut (Or.inr rfl)

/-! ## Local structure at a divalent target vertex of zero change -/

/-- Block counts inside a coarse block only depend on that block. -/
private theorem blockCountWithin_congr {d : ℕ} (fine coarse : SheetPartition d)
    {first second : Fin d} (hRel : coarse.Rel first second) :
    fine.blockCountWithin coarse first = fine.blockCountWithin coarse second := by
  unfold SheetPartition.blockCountWithin
  rw [coarse.block_eq_of_rel hRel]

/-- The edge partition of an incident target occurrence refines the vertex
partition. -/
theorem edgePartition_refines_of_mem_incidentEdges
    (data : GluingDatum target degree) (vertex : target.V)
    (edge : target.edges) (hEdge : edge ∈ GluingDatum.incidentEdges vertex) :
    (data.edgePartition edge).Refines (data.vertexPartition vertex) := by
  simp only [GluingDatum.incidentEdges, Finset.mem_filter, Finset.mem_univ,
    true_and] at hEdge
  rcases hEdge with hLeft | hRight
  · simpa [hLeft] using data.refines_left edge
  · simpa [hRight] using data.refines_right edge

/-- Zero change at a target vertex forces every local ramification above it to
vanish. -/
theorem localRamification_eq_zero_of_targetChange_zero
    (data : GluingDatum target degree) (hValid : data.Valid) (vertex : target.V)
    (hZero : data.targetChange vertex = 0)
    (sourceBlock : (data.vertexPartition vertex).Blocks) :
    data.localRamification vertex sourceBlock = 0 := by
  have hSum : ∑ block : (data.vertexPartition vertex).Blocks,
      data.localRamification vertex block = 0 := hZero
  exact (Finset.sum_eq_zero_iff_of_nonneg fun block _ ↦
    data.localRamification_nonneg vertex (hValid.2 vertex) block).mp hSum
    sourceBlock (Finset.mem_univ _)

/-- At a divalent target vertex of zero change, every incident edge partition
induces exactly one block inside every vertex block. -/
theorem blockCountWithin_eq_one_of_divalent_targetChange_zero
    (data : GluingDatum target degree) (hValid : data.Valid) (vertex : target.V)
    (hDivalent : (GluingDatum.incidentEdges vertex).card = 2)
    (hZero : data.targetChange vertex = 0)
    (edge : target.edges) (hEdge : edge ∈ GluingDatum.incidentEdges vertex)
    (sheet : Fin degree) :
    (data.edgePartition edge).blockCountWithin
      (data.vertexPartition vertex) sheet = 1 := by
  classical
  obtain ⟨first, second, hNe, hPair⟩ := Finset.card_eq_two.mp hDivalent
  set block : (data.vertexPartition vertex).Blocks :=
    ⟨(data.vertexPartition vertex).repr sheet,
      (data.vertexPartition vertex).repr_idem sheet⟩ with hBlock
  have hRamification :=
    localRamification_eq_zero_of_targetChange_zero data hValid vertex hZero block
  unfold GluingDatum.localRamification at hRamification
  rw [hDivalent] at hRamification
  have hTotal :
      ∑ item ∈ GluingDatum.incidentEdges vertex,
        ((data.edgePartition item).blockCountWithin
          (data.vertexPartition vertex) block.1 : ℤ) = 2 := by
    have hZeroFactor : ((2 : ℕ) : ℤ) - 2 = 0 := by norm_num
    rw [hZeroFactor, mul_zero] at hRamification
    omega
  rw [hPair, Finset.sum_pair hNe] at hTotal
  have hFirstPos := SheetPartition.blockCountWithin_pos
    (data.edgePartition first) (data.vertexPartition vertex) block.1
  have hSecondPos := SheetPartition.blockCountWithin_pos
    (data.edgePartition second) (data.vertexPartition vertex) block.1
  have hBlockCount :
      (data.edgePartition edge).blockCountWithin
        (data.vertexPartition vertex) block.1 = 1 := by
    rw [hPair] at hEdge
    rcases Finset.mem_insert.mp hEdge with hCase | hCase
    · rw [hCase]; omega
    · rw [Finset.mem_singleton.mp hCase]; omega
  rw [← hBlockCount]
  exact blockCountWithin_congr (data.edgePartition edge)
    (data.vertexPartition vertex)
    ((data.vertexPartition vertex).rel_repr_right sheet)

/-- At a divalent target vertex of zero change, each incident edge partition
agrees blockwise with the vertex partition. -/
theorem edgePartition_block_eq_of_divalent_targetChange_zero
    (data : GluingDatum target degree) (hValid : data.Valid) (vertex : target.V)
    (hDivalent : (GluingDatum.incidentEdges vertex).card = 2)
    (hZero : data.targetChange vertex = 0)
    (edge : target.edges) (hEdge : edge ∈ GluingDatum.incidentEdges vertex)
    (sheet : Fin degree) :
    (data.edgePartition edge).block sheet =
      (data.vertexPartition vertex).block sheet :=
  SheetPartition.block_eq_of_refines_of_blockCountWithin_eq_one
    (data.edgePartition edge) (data.vertexPartition vertex)
    (edgePartition_refines_of_mem_incidentEdges data vertex edge hEdge) sheet
    (blockCountWithin_eq_one_of_divalent_targetChange_zero data hValid vertex
      hDivalent hZero edge hEdge sheet)

/-- Consequently the two partitions define the same sheet relation there. -/
theorem edgePartition_rel_iff_of_divalent_targetChange_zero
    (data : GluingDatum target degree) (hValid : data.Valid) (vertex : target.V)
    (hDivalent : (GluingDatum.incidentEdges vertex).card = 2)
    (hZero : data.targetChange vertex = 0)
    (edge : target.edges) (hEdge : edge ∈ GluingDatum.incidentEdges vertex)
    (sheet other : Fin degree) :
    (data.edgePartition edge).Rel sheet other ↔
      (data.vertexPartition vertex).Rel sheet other := by
  constructor
  · intro hRel
    have hMem : other ∈ (data.edgePartition edge).block sheet :=
      ((data.edgePartition edge).mem_block_iff sheet other).2 hRel
    rw [edgePartition_block_eq_of_divalent_targetChange_zero data hValid vertex
      hDivalent hZero edge hEdge sheet] at hMem
    exact ((data.vertexPartition vertex).mem_block_iff sheet other).1 hMem
  · intro hRel
    have hMem : other ∈ (data.vertexPartition vertex).block sheet :=
      ((data.vertexPartition vertex).mem_block_iff sheet other).2 hRel
    rw [← edgePartition_block_eq_of_divalent_targetChange_zero data hValid
      vertex hDivalent hZero edge hEdge sheet] at hMem
    exact ((data.edgePartition edge).mem_block_iff sheet other).1 hMem

/-- The dilation index of a source occurrence above an incident target
occurrence is the local degree of the vertex block it meets. -/
theorem sourceEdgeIndex_eq_of_divalent_targetChange_zero
    (data : GluingDatum target degree) (hValid : data.Valid) (vertex : target.V)
    (hDivalent : (GluingDatum.incidentEdges vertex).card = 2)
    (hZero : data.targetChange vertex = 0)
    (edge : target.edges) (hEdge : edge ∈ GluingDatum.incidentEdges vertex)
    (sheet : Fin degree) :
    data.sourceEdgeIndex (data.sourceEdge edge sheet) =
      (data.vertexPartition vertex).blockCard sheet := by
  rw [GluingDatum.sourceEdgeIndex_sourceEdge]
  unfold SheetPartition.blockCard
  rw [edgePartition_block_eq_of_divalent_targetChange_zero data hValid vertex
    hDivalent hZero edge hEdge sheet]

/-- Every source vertex above a divalent target vertex of zero change has
graph degree two. -/
theorem vertex_degree_eq_two_of_divalent_targetChange_zero
    (data : GluingDatum target degree) (hValid : data.Valid) (vertex : target.V)
    (hDivalent : (GluingDatum.incidentEdges vertex).card = 2)
    (hZero : data.targetChange vertex = 0)
    (sourceVertex : data.SourceVertex) (hAbove : sourceVertex.1.1 = vertex) :
    vertex_degree data.sourceGraph sourceVertex = 2 := by
  have hFormula := localRamification_eq_vertex_degree data sourceVertex
  have hRamification := localRamification_eq_zero_of_targetChange_zero data
    hValid sourceVertex.1.1 (by rw [hAbove]; exact hZero)
    ⟨sourceVertex.1.2, sourceVertex.2⟩
  rw [hRamification, hAbove, hDivalent] at hFormula
  have hZeroFactor : ((2 : ℕ) : ℤ) - 2 = 0 := by norm_num
  rw [hZeroFactor, mul_zero] at hFormula
  omega

/-! ## The pairing of source occurrences above the two incident target
occurrences -/

/-- A canonical source occurrence above an incident target occurrence meets
the source vertex carried by the same sheet. -/
theorem incident_sourceEdge_sourceEndpoint
    (data : GluingDatum target degree) (vertex : target.V)
    (edge : target.edges) (hEdge : edge ∈ GluingDatum.incidentEdges vertex)
    (sheet : Fin degree) :
    Incident data (data.sourceEdge edge sheet)
      (data.sourceEndpoint vertex sheet) := by
  apply (incident_iff_target_mem_and_rel data (data.sourceEdge edge sheet)
    (data.sourceEndpoint vertex sheet)).2
  refine ⟨hEdge, ?_⟩
  have hRefines :=
    edgePartition_refines_of_mem_incidentEdges data vertex edge hEdge
  have hRel : (data.vertexPartition vertex).Rel
      ((data.edgePartition edge).repr sheet) sheet :=
    hRefines.rel ((data.edgePartition edge).rel_repr_left sheet)
  change (data.vertexPartition vertex).Rel
    ((data.vertexPartition vertex).repr sheet)
    ((data.edgePartition edge).repr sheet)
  unfold SheetPartition.Rel at hRel ⊢
  rw [(data.vertexPartition vertex).repr_idem sheet, hRel]

/-- Canonical source occurrences above distinct target occurrences differ. -/
theorem sourceEdge_ne_of_target_ne
    (data : GluingDatum target degree) {first second : target.edges}
    (hNe : first ≠ second) (sheet other : Fin degree) :
    data.sourceEdge first sheet ≠ data.sourceEdge second other := by
  intro hEqual
  exact hNe (congrArg (fun edge : data.SourceEdge ↦ edge.1.1) hEqual)

/-- Above a divalent target vertex of zero change, danglingness of the two
canonical source occurrences through one sheet agree. -/
theorem isDangling_sourceEdge_iff_of_divalent_targetChange_zero
    (data : GluingDatum target degree) (hValid : data.Valid) (vertex : target.V)
    (hDivalent : (GluingDatum.incidentEdges vertex).card = 2)
    (hZero : data.targetChange vertex = 0)
    {first second : target.edges} (hNe : first ≠ second)
    (hFirst : first ∈ GluingDatum.incidentEdges vertex)
    (hSecond : second ∈ GluingDatum.incidentEdges vertex)
    (sheet : Fin degree) :
    IsDangling data (data.sourceEdge first sheet) ↔
      IsDangling data (data.sourceEdge second sheet) := by
  have hDegree := vertex_degree_eq_two_of_divalent_targetChange_zero data hValid
    vertex hDivalent hZero (data.sourceEndpoint vertex sheet) rfl
  have hFirstIncident :=
    incident_sourceEdge_sourceEndpoint data vertex first hFirst sheet
  have hSecondIncident :=
    incident_sourceEdge_sourceEndpoint data vertex second hSecond sheet
  constructor
  · exact isDangling_of_incident_of_vertex_degree_eq_two data
      (sourceEdge_ne_of_target_ne data hNe sheet sheet) hFirstIncident
      hSecondIncident hDegree
  · exact isDangling_of_incident_of_vertex_degree_eq_two data
      (sourceEdge_ne_of_target_ne data (Ne.symm hNe) sheet sheet)
      hSecondIncident hFirstIncident hDegree

/-- When both survive, the two canonical source occurrences through one sheet
are consecutive along a stable path. -/
theorem consecutive_sourceEdge_of_divalent_targetChange_zero
    (data : GluingDatum target degree) (hValid : data.Valid) (vertex : target.V)
    (hDivalent : (GluingDatum.incidentEdges vertex).card = 2)
    (hZero : data.targetChange vertex = 0)
    {first second : target.edges} (hNe : first ≠ second)
    (hFirst : first ∈ GluingDatum.incidentEdges vertex)
    (hSecond : second ∈ GluingDatum.incidentEdges vertex)
    (sheet : Fin degree)
    (hFirstSurvives : ¬ IsDangling data (data.sourceEdge first sheet))
    (hSecondSurvives : ¬ IsDangling data (data.sourceEdge second sheet)) :
    Consecutive data ⟨data.sourceEdge first sheet, hFirstSurvives⟩
      ⟨data.sourceEdge second sheet, hSecondSurvives⟩ := by
  classical
  have hDegree := vertex_degree_eq_two_of_divalent_targetChange_zero data hValid
    vertex hDivalent hZero (data.sourceEndpoint vertex sheet) rfl
  have hFirstIncident :=
    incident_sourceEdge_sourceEndpoint data vertex first hFirst sheet
  have hSecondIncident :=
    incident_sourceEdge_sourceEndpoint data vertex second hSecond sheet
  have hEdgeNe := sourceEdge_ne_of_target_ne data hNe sheet sheet
  refine ⟨fun hEqual ↦ hEdgeNe (congrArg Subtype.val hEqual),
    data.sourceEndpoint vertex sheet, hFirstIncident, hSecondIncident, ?_⟩
  have hFilter :
      ((Finset.univ : Finset data.SourceEdge).filter fun edge ↦
        ¬ IsDangling data edge ∧
          Incident data edge (data.sourceEndpoint vertex sheet)) =
        {data.sourceEdge first sheet, data.sourceEdge second sheet} := by
    apply Finset.Subset.antisymm
    · intro edge hEdge
      have hProperty := (Finset.mem_filter.mp hEdge).2
      rcases eq_of_incident_of_vertex_degree_eq_two data hEdgeNe hFirstIncident
        hSecondIncident hDegree hProperty.2 with hCase | hCase
      · simp [hCase]
      · simp [hCase]
    · intro edge hEdge
      rcases Finset.mem_insert.mp hEdge with hCase | hCase
      · rw [hCase]
        exact Finset.mem_filter.mpr ⟨Finset.mem_univ _,
          hFirstSurvives, hFirstIncident⟩
      · rw [Finset.mem_singleton.mp hCase]
        exact Finset.mem_filter.mpr ⟨Finset.mem_univ _,
          hSecondSurvives, hSecondIncident⟩
  unfold nonDanglingValency
  rw [hFilter, Finset.card_pair hEdgeNe]

/-- The two canonical source occurrences through one sheet lie on the same
stable path. -/
theorem stablePath_sourceEdge_eq_of_divalent_targetChange_zero
    (data : GluingDatum target degree) (hValid : data.Valid) (vertex : target.V)
    (hDivalent : (GluingDatum.incidentEdges vertex).card = 2)
    (hZero : data.targetChange vertex = 0)
    {first second : target.edges} (hNe : first ≠ second)
    (hFirst : first ∈ GluingDatum.incidentEdges vertex)
    (hSecond : second ∈ GluingDatum.incidentEdges vertex)
    (sheet : Fin degree)
    (hFirstSurvives : ¬ IsDangling data (data.sourceEdge first sheet))
    (hSecondSurvives : ¬ IsDangling data (data.sourceEdge second sheet)) :
    NonDanglingEdge.stablePath
        (⟨data.sourceEdge first sheet, hFirstSurvives⟩ : NonDanglingEdge data) =
      NonDanglingEdge.stablePath
        (⟨data.sourceEdge second sheet, hSecondSurvives⟩ : NonDanglingEdge data) :=
  stablePath_eq_of_consecutive
    (consecutive_sourceEdge_of_divalent_targetChange_zero data hValid vertex
      hDivalent hZero hNe hFirst hSecond sheet hFirstSurvives hSecondSurvives)

/-- Transporting a source occurrence from one incident target occurrence to
the other, and back, is the identity. -/
theorem sourceEdge_transport_left_inverse
    (data : GluingDatum target degree) (hValid : data.Valid) (vertex : target.V)
    (hDivalent : (GluingDatum.incidentEdges vertex).card = 2)
    (hZero : data.targetChange vertex = 0)
    (first second : target.edges)
    (hFirst : first ∈ GluingDatum.incidentEdges vertex)
    (hSecond : second ∈ GluingDatum.incidentEdges vertex)
    (edge : data.SourceEdge) (hTarget : edge.1.1 = first) :
    data.sourceEdge first (data.sourceEdge second edge.1.2).1.2 = edge := by
  have hIdem : (data.edgePartition first).repr edge.1.2 = edge.1.2 := by
    rw [← hTarget]
    exact edge.2
  have hSecondRel : (data.edgePartition second).Rel
      ((data.edgePartition second).repr edge.1.2) edge.1.2 :=
    (data.edgePartition second).rel_repr_left edge.1.2
  have hVertexRel : (data.vertexPartition vertex).Rel
      ((data.edgePartition second).repr edge.1.2) edge.1.2 :=
    (edgePartition_rel_iff_of_divalent_targetChange_zero data hValid vertex
      hDivalent hZero second hSecond _ _).1 hSecondRel
  have hFirstRel : (data.edgePartition first).Rel
      ((data.edgePartition second).repr edge.1.2) edge.1.2 :=
    (edgePartition_rel_iff_of_divalent_targetChange_zero data hValid vertex
      hDivalent hZero first hFirst _ _).2 hVertexRel
  apply Subtype.ext
  apply Prod.ext
  · exact hTarget.symm
  · show (data.edgePartition first).repr
      ((data.edgePartition second).repr edge.1.2) = edge.1.2
    unfold SheetPartition.Rel at hFirstRel
    rw [hFirstRel, hIdem]

/-! ## Equal columns at a divalent target vertex of zero change -/

/-- At a divalent target vertex whose change vanishes, the two columns of the
honest stable-source length matrix indexed by its incident target occurrences
are equal.  Each entry is the sum of `1 / m(e)` over the surviving source
occurrences of one stable path above that target occurrence, and the two
families are matched sheet by sheet. -/
theorem StableLengthMatrixLabelling.matrix_column_eq_of_divalent_targetChange_zero
    {coordinate : Type*} [Fintype coordinate] [DecidableEq coordinate]
    {data : GluingDatum target degree} (hValid : data.Valid)
    (labelling : StableLengthMatrixLabelling data coordinate)
    (vertex : target.V)
    (hDivalent : (GluingDatum.incidentEdges vertex).card = 2)
    (hZero : data.targetChange vertex = 0)
    {first second : target.edges} (hNe : first ≠ second)
    (hFirst : first ∈ GluingDatum.incidentEdges vertex)
    (hSecond : second ∈ GluingDatum.incidentEdges vertex)
    (row : coordinate) :
    GluingDatum.LengthMatrixPresentation.matrix labelling.presentation row
        (labelling.targetEdge.symm first) =
      GluingDatum.LengthMatrixPresentation.matrix labelling.presentation row
        (labelling.targetEdge.symm second) := by
  classical
  have hConvert : ∀ item : target.edges,
      GluingDatum.LengthMatrixPresentation.matrix labelling.presentation row
          (labelling.targetEdge.symm item) =
        ∑ edge ∈ (Finset.univ : Finset data.SourceEdge).filter
            (fun edge ↦ (∃ hSurvives : ¬ IsDangling data edge,
                labelling.row (NonDanglingEdge.stablePath
                  (⟨edge, hSurvives⟩ : NonDanglingEdge data)) = row) ∧
              edge.1.1 = item),
          (1 : ℚ) / data.sourceEdgeIndex edge := by
    intro item
    have hNodup : (labelling.path row).Nodup := by
      unfold StableLengthMatrixLabelling.path
      exact List.Nodup.filter _ (Finset.univ.nodup_toList)
    have hToFinset : (labelling.path row).toFinset =
        (Finset.univ : Finset data.SourceEdge).filter
          (fun edge ↦ ∃ hSurvives : ¬ IsDangling data edge,
            labelling.row (NonDanglingEdge.stablePath
              (⟨edge, hSurvives⟩ : NonDanglingEdge data)) = row) := by
      ext edge
      simp [List.mem_toFinset, labelling.mem_path_iff]
    calc
      GluingDatum.LengthMatrixPresentation.matrix labelling.presentation row
            (labelling.targetEdge.symm item)
          = ((labelling.path row).map fun edge ↦
              GluingDatum.LengthMatrixPresentation.coefficient
                labelling.presentation edge
                (labelling.targetEdge.symm item)).sum := rfl
      _ = ∑ edge ∈ (labelling.path row).toFinset,
            GluingDatum.LengthMatrixPresentation.coefficient
              labelling.presentation edge
              (labelling.targetEdge.symm item) :=
          (List.sum_toFinset _ hNodup).symm
      _ = ∑ edge ∈ (Finset.univ : Finset data.SourceEdge).filter
              (fun edge ↦ ∃ hSurvives : ¬ IsDangling data edge,
                labelling.row (NonDanglingEdge.stablePath
                  (⟨edge, hSurvives⟩ : NonDanglingEdge data)) = row),
            GluingDatum.LengthMatrixPresentation.coefficient
              labelling.presentation edge
              (labelling.targetEdge.symm item) := by
          rw [hToFinset]
      _ = ∑ edge ∈ ((Finset.univ : Finset data.SourceEdge).filter
              (fun edge ↦ ∃ hSurvives : ¬ IsDangling data edge,
                labelling.row (NonDanglingEdge.stablePath
                  (⟨edge, hSurvives⟩ : NonDanglingEdge data)) = row)).filter
              (fun edge ↦ edge.1.1 = item),
            (1 : ℚ) / data.sourceEdgeIndex edge := by
          conv_rhs => rw [Finset.sum_filter]
          apply Finset.sum_congr rfl
          intro edge _
          by_cases hCase : edge.1.1 = item
          · rw [if_pos hCase]
            simp [GluingDatum.LengthMatrixPresentation.coefficient,
              StableLengthMatrixLabelling.presentation, hCase]
          · rw [if_neg hCase]
            apply GluingDatum.LengthMatrixPresentation.coefficient_eq_zero_of_target_ne
            simp only [StableLengthMatrixLabelling.presentation,
              Equiv.apply_symm_apply]
            exact fun hEqual ↦ hCase hEqual.symm
      _ = ∑ edge ∈ (Finset.univ : Finset data.SourceEdge).filter
              (fun edge ↦ (∃ hSurvives : ¬ IsDangling data edge,
                  labelling.row (NonDanglingEdge.stablePath
                    (⟨edge, hSurvives⟩ : NonDanglingEdge data)) = row) ∧
                edge.1.1 = item),
            (1 : ℚ) / data.sourceEdgeIndex edge := by
          rw [Finset.filter_filter]
  have hTransfer : ∀ (one two : target.edges),
      one ∈ GluingDatum.incidentEdges vertex →
      two ∈ GluingDatum.incidentEdges vertex → one ≠ two →
      ∀ edge ∈ (Finset.univ : Finset data.SourceEdge).filter
        (fun edge ↦ (∃ hSurvives : ¬ IsDangling data edge,
            labelling.row (NonDanglingEdge.stablePath
              (⟨edge, hSurvives⟩ : NonDanglingEdge data)) = row) ∧
          edge.1.1 = one),
      data.sourceEdge two edge.1.2 ∈
        (Finset.univ : Finset data.SourceEdge).filter
          (fun edge ↦ (∃ hSurvives : ¬ IsDangling data edge,
              labelling.row (NonDanglingEdge.stablePath
                (⟨edge, hSurvives⟩ : NonDanglingEdge data)) = row) ∧
            edge.1.1 = two) := by
    intro one two hOne hTwo hOneTwo edge hEdge
    obtain ⟨⟨hSurvives, hRow⟩, hTarget⟩ := (Finset.mem_filter.mp hEdge).2
    have hSelf : data.sourceEdge one edge.1.2 = edge := by
      rw [← hTarget]
      exact GluingDatum.sourceEdge_self data edge
    have hOneSurvives : ¬ IsDangling data (data.sourceEdge one edge.1.2) := by
      rw [hSelf]
      exact hSurvives
    have hTwoSurvives : ¬ IsDangling data (data.sourceEdge two edge.1.2) :=
      fun hDangling ↦ hOneSurvives
        ((isDangling_sourceEdge_iff_of_divalent_targetChange_zero data hValid
          vertex hDivalent hZero hOneTwo hOne hTwo edge.1.2).2 hDangling)
    have hPathEq := stablePath_sourceEdge_eq_of_divalent_targetChange_zero data
      hValid vertex hDivalent hZero hOneTwo hOne hTwo edge.1.2 hOneSurvives
      hTwoSurvives
    refine Finset.mem_filter.mpr ⟨Finset.mem_univ _, ⟨hTwoSurvives, ?_⟩, rfl⟩
    rw [← hPathEq,
      show (⟨data.sourceEdge one edge.1.2, hOneSurvives⟩ :
        NonDanglingEdge data) = ⟨edge, hSurvives⟩ from Subtype.ext hSelf]
    exact hRow
  rw [hConvert first, hConvert second]
  refine Finset.sum_nbij' (fun edge ↦ data.sourceEdge second edge.1.2)
    (fun edge ↦ data.sourceEdge first edge.1.2)
    (hTransfer first second hFirst hSecond hNe)
    (hTransfer second first hSecond hFirst (Ne.symm hNe)) ?_ ?_ ?_
  · intro edge hEdge
    exact sourceEdge_transport_left_inverse data hValid vertex hDivalent hZero
      first second hFirst hSecond edge (Finset.mem_filter.mp hEdge).2.2
  · intro edge hEdge
    exact sourceEdge_transport_left_inverse data hValid vertex hDivalent hZero
      second first hSecond hFirst edge (Finset.mem_filter.mp hEdge).2.2
  · intro edge hEdge
    have hTarget := (Finset.mem_filter.mp hEdge).2.2
    have hSelf : data.sourceEdge first edge.1.2 = edge := by
      rw [← hTarget]
      exact GluingDatum.sourceEdge_self data edge
    have hFirstIndex := sourceEdgeIndex_eq_of_divalent_targetChange_zero data
      hValid vertex hDivalent hZero first hFirst edge.1.2
    rw [hSelf] at hFirstIndex
    have hSecondIndex :
        data.sourceEdgeIndex (data.sourceEdge second edge.1.2) =
          (data.vertexPartition vertex).blockCard edge.1.2 :=
      sourceEdgeIndex_eq_of_divalent_targetChange_zero data hValid vertex
        hDivalent hZero second hSecond edge.1.2
    rw [hFirstIndex, hSecondIndex]

/-! ## A full-rank discrete tropical morphism is a combinatorial type -/

/-- Nonsingularity of the honest stable-source length matrix forces positive
change at every divalent target vertex.  This is the second half of the
source's theorem that a full-rank discrete tropical morphism is a
combinatorial type. -/
theorem StableLengthMatrixLabelling.divalentChangePositive_of_det_ne_zero
    {coordinate : Type*} [Fintype coordinate] [DecidableEq coordinate]
    {data : GluingDatum target degree}
    (labelling : StableLengthMatrixLabelling data coordinate)
    (hValid : data.Valid)
    (hDet :
      (GluingDatum.LengthMatrixPresentation.matrix
        labelling.presentation).det ≠ 0)
    (vertex : target.V)
    (hDivalent : (GluingDatum.incidentEdges vertex).card = 2) :
    1 ≤ data.targetChange vertex := by
  classical
  by_contra hNotPositive
  have hNonneg := data.targetChange_nonneg hValid vertex
  have hZero : data.targetChange vertex = 0 := by omega
  obtain ⟨first, second, hNe, hPair⟩ := Finset.card_eq_two.mp hDivalent
  have hFirst : first ∈ GluingDatum.incidentEdges vertex := by
    rw [hPair]; simp
  have hSecond : second ∈ GluingDatum.incidentEdges vertex := by
    rw [hPair]; simp
  apply hDet
  refine Matrix.det_zero_of_column_eq
    (i := labelling.targetEdge.symm first)
    (j := labelling.targetEdge.symm second)
    (fun hEqual ↦ hNe (labelling.targetEdge.symm.injective hEqual)) ?_
  intro row
  exact labelling.matrix_column_eq_of_divalent_targetChange_zero hValid vertex
    hDivalent hZero hNe hFirst hSecond row

/-- Nonsingularity of the honest stable-source length matrix makes the gluing
datum a combinatorial type: no target fibre is entirely dangling, and the
change at every divalent target vertex is positive. -/
theorem StableLengthMatrixLabelling.combinatorialType_of_det_ne_zero
    {coordinate : Type*} [Fintype coordinate] [DecidableEq coordinate]
    {data : GluingDatum target degree}
    (labelling : StableLengthMatrixLabelling data coordinate)
    (hValid : data.Valid)
    (hDet :
      (GluingDatum.LengthMatrixPresentation.matrix
        labelling.presentation).det ≠ 0) :
    CombinatorialType data where
  noDanglingTargetFibres :=
    labelling.noDanglingTargetFibres_of_det_ne_zero hDet
  divalentChangePositive := fun vertex hDivalent ↦
    labelling.divalentChangePositive_of_det_ne_zero hValid hDet vertex hDivalent

/-! ## Traversing a stable path

The rows of `StableLengthMatrixLabelling.presentation` are produced by
filtering a global enumeration of `data.SourceEdge`, so for a row of length
three or more their order is the arbitrary enumeration order rather than an
order along the path.  What follows replaces that by an actual traversal:
starting from an end of a stable-path class, walk from occurrence to
occurrence through surviving valency-two vertices, and prove the resulting
list is a reordering of the filtered row.  Being a reordering, it carries the
same weighted sums, so the length matrix is untouched; being a traversal, its
consecutive entries genuinely meet.
-/

/-! ### Surviving occurrences at a vertex -/

/-- The surviving edge occurrences incident to a quotient-source vertex. -/
noncomputable def nonDanglingIncident (data : GluingDatum target degree)
    (vertex : data.SourceVertex) : Finset data.SourceEdge := by
  classical
  exact (Finset.univ : Finset data.SourceEdge).filter fun edge ↦
    ¬ IsDangling data edge ∧ Incident data edge vertex

@[simp] theorem mem_nonDanglingIncident (data : GluingDatum target degree)
    (vertex : data.SourceVertex) (edge : data.SourceEdge) :
    edge ∈ nonDanglingIncident data vertex ↔
      ¬ IsDangling data edge ∧ Incident data edge vertex := by
  classical
  simp [nonDanglingIncident]

theorem card_nonDanglingIncident (data : GluingDatum target degree)
    (vertex : data.SourceVertex) :
    (nonDanglingIncident data vertex).card = nonDanglingValency data vertex := rfl

/-- At a surviving valency-two vertex the incident surviving occurrences are
an unordered pair, one of which is any prescribed incident occurrence. -/
theorem nonDanglingIncident_eq_pair (data : GluingDatum target degree)
    {vertex : data.SourceVertex}
    (hValency : nonDanglingValency data vertex = 2)
    {edge : data.SourceEdge} (hEdge : ¬ IsDangling data edge)
    (hIncident : Incident data edge vertex) :
    ∃ other : data.SourceEdge, other ≠ edge ∧
      nonDanglingIncident data vertex = {edge, other} := by
  classical
  have hCard : (nonDanglingIncident data vertex).card = 2 := by
    rw [card_nonDanglingIncident]
    exact hValency
  obtain ⟨a, b, hab, hSet⟩ := Finset.card_eq_two.mp hCard
  have hMem : edge ∈ nonDanglingIncident data vertex :=
    (mem_nonDanglingIncident data vertex edge).mpr ⟨hEdge, hIncident⟩
  rw [hSet] at hMem
  rcases Finset.mem_insert.mp hMem with h | h
  · subst h
    exact ⟨b, Ne.symm hab, hSet⟩
  · have hb : edge = b := Finset.mem_singleton.mp h
    subst hb
    exact ⟨a, hab, hSet.trans (Finset.pair_comm a edge)⟩

/-- A surviving occurrence at a surviving valency-two vertex has exactly one
surviving companion there. -/
theorem exists_unique_other_of_nonDanglingValency_eq_two
    (data : GluingDatum target degree) {vertex : data.SourceVertex}
    (hValency : nonDanglingValency data vertex = 2)
    {edge : data.SourceEdge} (hEdge : ¬ IsDangling data edge)
    (hIncident : Incident data edge vertex) :
    ∃! other : data.SourceEdge, other ≠ edge ∧ ¬ IsDangling data other ∧
      Incident data other vertex := by
  obtain ⟨other, hNe, hSet⟩ :=
    nonDanglingIncident_eq_pair data hValency hEdge hIncident
  have hOther : other ∈ nonDanglingIncident data vertex := by
    rw [hSet]
    simp
  rw [mem_nonDanglingIncident] at hOther
  refine ⟨other, ⟨hNe, hOther.1, hOther.2⟩, ?_⟩
  rintro candidate ⟨hCandidateNe, hCandidateSurvives, hCandidateIncident⟩
  have hCandidate : candidate ∈ nonDanglingIncident data vertex :=
    (mem_nonDanglingIncident data vertex candidate).mpr
      ⟨hCandidateSurvives, hCandidateIncident⟩
  rw [hSet] at hCandidate
  rcases Finset.mem_insert.mp hCandidate with h | h
  · exact absurd h hCandidateNe
  · exact Finset.mem_singleton.mp h

/-! ### One step along a stable path -/

/-- The surviving occurrences at `vertex` other than `edge`. -/
noncomputable def stepSet (data : GluingDatum target degree)
    (edge : data.SourceEdge) (vertex : data.SourceVertex) :
    Finset data.SourceEdge :=
  (nonDanglingIncident data vertex).erase edge

@[simp] theorem mem_stepSet (data : GluingDatum target degree)
    (edge : data.SourceEdge) (vertex : data.SourceVertex)
    (other : data.SourceEdge) :
    other ∈ stepSet data edge vertex ↔
      other ≠ edge ∧ ¬ IsDangling data other ∧ Incident data other vertex := by
  simp [stepSet]

/-- A surviving valency-two vertex always continues. -/
theorem stepSet_nonempty (data : GluingDatum target degree)
    {vertex : data.SourceVertex}
    (hValency : nonDanglingValency data vertex = 2)
    (edge : data.SourceEdge) : (stepSet data edge vertex).Nonempty := by
  rw [← Finset.card_pos]
  have hLe : (nonDanglingIncident data vertex).card - 1 ≤
      (stepSet data edge vertex).card :=
    Finset.pred_card_le_card_erase
  rw [card_nonDanglingIncident, hValency] at hLe
  omega

/-- The occurrence chosen by one step away from `edge` through `vertex`. -/
noncomputable def stepEdge (data : GluingDatum target degree)
    {vertex : data.SourceVertex}
    (hValency : nonDanglingValency data vertex = 2)
    (edge : data.SourceEdge) : data.SourceEdge :=
  (stepSet_nonempty data hValency edge).choose

theorem stepEdge_mem (data : GluingDatum target degree)
    {vertex : data.SourceVertex}
    (hValency : nonDanglingValency data vertex = 2)
    (edge : data.SourceEdge) :
    stepEdge data hValency edge ∈ stepSet data edge vertex :=
  (stepSet_nonempty data hValency edge).choose_spec

theorem stepEdge_ne (data : GluingDatum target degree)
    {vertex : data.SourceVertex}
    (hValency : nonDanglingValency data vertex = 2)
    (edge : data.SourceEdge) : stepEdge data hValency edge ≠ edge :=
  ((mem_stepSet data edge vertex _).mp (stepEdge_mem data hValency edge)).1

theorem stepEdge_not_dangling (data : GluingDatum target degree)
    {vertex : data.SourceVertex}
    (hValency : nonDanglingValency data vertex = 2)
    (edge : data.SourceEdge) :
    ¬ IsDangling data (stepEdge data hValency edge) :=
  ((mem_stepSet data edge vertex _).mp (stepEdge_mem data hValency edge)).2.1

theorem stepEdge_incident (data : GluingDatum target degree)
    {vertex : data.SourceVertex}
    (hValency : nonDanglingValency data vertex = 2)
    (edge : data.SourceEdge) :
    Incident data (stepEdge data hValency edge) vertex :=
  ((mem_stepSet data edge vertex _).mp (stepEdge_mem data hValency edge)).2.2

/-- At a surviving valency-two vertex every surviving occurrence is either the
given one or the one step takes. -/
theorem eq_or_eq_stepEdge (data : GluingDatum target degree)
    {vertex : data.SourceVertex}
    (hValency : nonDanglingValency data vertex = 2)
    {edge : data.SourceEdge} (hEdge : ¬ IsDangling data edge)
    (hIncident : Incident data edge vertex)
    {other : data.SourceEdge} (hOther : ¬ IsDangling data other)
    (hOtherIncident : Incident data other vertex) :
    other = edge ∨ other = stepEdge data hValency edge := by
  classical
  obtain ⟨companion, hNe, hSet⟩ :=
    nonDanglingIncident_eq_pair data hValency hEdge hIncident
  have hStepSet : stepSet data edge vertex = {companion} := by
    rw [stepSet, hSet]
    exact Finset.erase_insert (by simp [Ne.symm hNe])
  have hStep : stepEdge data hValency edge = companion := by
    have := stepEdge_mem data hValency edge
    rw [hStepSet] at this
    exact Finset.mem_singleton.mp this
  have hMem : other ∈ nonDanglingIncident data vertex :=
    (mem_nonDanglingIncident data vertex other).mpr ⟨hOther, hOtherIncident⟩
  rw [hSet] at hMem
  rcases Finset.mem_insert.mp hMem with h | h
  · exact Or.inl h
  · exact Or.inr ((Finset.mem_singleton.mp h).trans hStep.symm)

/-! ### The far end of an occurrence -/

/-- The end of `edge` other than `vertex`. -/
def otherEnd (data : GluingDatum target degree) (edge : data.SourceEdge)
    (vertex : data.SourceVertex) : data.SourceVertex :=
  if (data.sourceEnds edge).1 = vertex then (data.sourceEnds edge).2
  else (data.sourceEnds edge).1

@[simp] theorem incident_otherEnd (data : GluingDatum target degree)
    (edge : data.SourceEdge) (vertex : data.SourceVertex) :
    Incident data edge (otherEnd data edge vertex) := by
  unfold otherEnd Incident
  split
  · exact Or.inr rfl
  · exact Or.inl rfl

/-- An occurrence entered at `vertex` meets no vertex besides `vertex` and its
far end. -/
theorem eq_or_eq_otherEnd (data : GluingDatum target degree)
    {edge : data.SourceEdge} {vertex other : data.SourceVertex}
    (hVertex : Incident data edge vertex) (hOther : Incident data edge other) :
    other = vertex ∨ other = otherEnd data edge vertex := by
  unfold otherEnd
  unfold Incident at hVertex hOther
  split_ifs with hSplit
  · rcases hOther with h | h
    · exact Or.inl (h.symm.trans hSplit)
    · exact Or.inr h.symm
  · rcases hOther with h | h
    · exact Or.inr h.symm
    · rcases hVertex with h' | h'
      · exact absurd h' hSplit
      · exact Or.inl (h.symm.trans h')

/-! ### The traversal -/

private theorem card_sdiff_insert_lt (data : GluingDatum target degree)
    {visited : Finset data.SourceEdge} {edge : data.SourceEdge}
    (hEdge : edge ∉ visited) :
    ((Finset.univ : Finset data.SourceEdge) \ insert edge visited).card <
      ((Finset.univ : Finset data.SourceEdge) \ visited).card := by
  classical
  refine Finset.card_lt_card ((Finset.ssubset_iff_of_subset ?_).mpr ⟨edge, ?_, ?_⟩)
  · intro candidate hCandidate
    simp only [Finset.mem_sdiff, Finset.mem_insert] at hCandidate ⊢
    exact ⟨hCandidate.1, fun hMem ↦ hCandidate.2 (Or.inr hMem)⟩
  · simp [hEdge]
  · simp

/-- Walk along a stable path.  `edge` is the current surviving occurrence,
`vertex` the end through which it was entered and `visited` the set of
occurrences already emitted.  The walk stops when the far end of `edge` is not
a surviving valency-two vertex, or when the occurrence continuing there has
already been emitted. -/
noncomputable def traverse (data : GluingDatum target degree)
    (visited : Finset data.SourceEdge) (edge : data.SourceEdge)
    (vertex : data.SourceVertex) : List data.SourceEdge :=
  if _hVisited : edge ∈ visited then []
  else if hValency : nonDanglingValency data (otherEnd data edge vertex) = 2 then
    edge :: traverse data (insert edge visited) (stepEdge data hValency edge)
      (otherEnd data edge vertex)
  else [edge]
termination_by ((Finset.univ : Finset data.SourceEdge) \ visited).card
decreasing_by exact card_sdiff_insert_lt data (by assumption)

theorem traverse_of_mem (data : GluingDatum target degree)
    {visited : Finset data.SourceEdge} {edge : data.SourceEdge}
    (vertex : data.SourceVertex) (hVisited : edge ∈ visited) :
    traverse data visited edge vertex = [] := by
  rw [traverse.eq_def, dif_pos hVisited]

theorem traverse_of_valency_ne (data : GluingDatum target degree)
    {visited : Finset data.SourceEdge} {edge : data.SourceEdge}
    {vertex : data.SourceVertex} (hVisited : edge ∉ visited)
    (hValency : nonDanglingValency data (otherEnd data edge vertex) ≠ 2) :
    traverse data visited edge vertex = [edge] := by
  rw [traverse.eq_def, dif_neg hVisited, dif_neg hValency]

theorem traverse_of_valency_eq (data : GluingDatum target degree)
    {visited : Finset data.SourceEdge} {edge : data.SourceEdge}
    {vertex : data.SourceVertex} (hVisited : edge ∉ visited)
    (hValency : nonDanglingValency data (otherEnd data edge vertex) = 2) :
    traverse data visited edge vertex =
      edge :: traverse data (insert edge visited) (stepEdge data hValency edge)
        (otherEnd data edge vertex) := by
  rw [traverse.eq_def, dif_neg hVisited, dif_pos hValency]

/-- The recursion principle matching `traverse`. -/
theorem traverse_rec {data : GluingDatum target degree}
    {motive : Finset data.SourceEdge → data.SourceEdge → data.SourceVertex → Prop}
    (visitedCase : ∀ visited edge vertex, edge ∈ visited → motive visited edge vertex)
    (stopCase : ∀ visited edge vertex, edge ∉ visited →
      nonDanglingValency data (otherEnd data edge vertex) ≠ 2 →
      motive visited edge vertex)
    (stepCase : ∀ visited edge vertex, edge ∉ visited →
      ∀ hValency : nonDanglingValency data (otherEnd data edge vertex) = 2,
      motive (insert edge visited) (stepEdge data hValency edge)
        (otherEnd data edge vertex) → motive visited edge vertex)
    (visited : Finset data.SourceEdge) (edge : data.SourceEdge)
    (vertex : data.SourceVertex) : motive visited edge vertex := by
  classical
  suffices hAll : ∀ bound (visited : Finset data.SourceEdge) (edge : data.SourceEdge)
      (vertex : data.SourceVertex),
      ((Finset.univ : Finset data.SourceEdge) \ visited).card ≤ bound →
      motive visited edge vertex from
    hAll _ visited edge vertex le_rfl
  intro bound
  induction bound with
  | zero =>
    intro visited edge vertex hBound
    by_cases hVisited : edge ∈ visited
    · exact visitedCase visited edge vertex hVisited
    · exfalso
      have hMem : edge ∈ (Finset.univ : Finset data.SourceEdge) \ visited :=
        Finset.mem_sdiff.mpr ⟨Finset.mem_univ _, hVisited⟩
      have hPos := Finset.card_pos.mpr ⟨edge, hMem⟩
      omega
  | succ bound ih =>
    intro visited edge vertex hBound
    by_cases hVisited : edge ∈ visited
    · exact visitedCase visited edge vertex hVisited
    · by_cases hValency : nonDanglingValency data (otherEnd data edge vertex) = 2
      · refine stepCase visited edge vertex hVisited hValency (ih _ _ _ ?_)
        have hLt := card_sdiff_insert_lt data hVisited
        omega
      · exact stopCase visited edge vertex hVisited hValency

theorem mem_traverse_self (data : GluingDatum target degree)
    (visited : Finset data.SourceEdge) (edge : data.SourceEdge)
    (vertex : data.SourceVertex) (hVisited : edge ∉ visited) :
    edge ∈ traverse data visited edge vertex := by
  by_cases hValency : nonDanglingValency data (otherEnd data edge vertex) = 2
  · rw [traverse_of_valency_eq data hVisited hValency]
    simp
  · rw [traverse_of_valency_ne data hVisited hValency]
    simp

theorem traverse_head? (data : GluingDatum target degree)
    (visited : Finset data.SourceEdge) (edge : data.SourceEdge)
    (vertex : data.SourceVertex) :
    ∀ first ∈ (traverse data visited edge vertex).head?, first = edge := by
  by_cases hVisited : edge ∈ visited
  · rw [traverse_of_mem data vertex hVisited]
    simp
  · by_cases hValency : nonDanglingValency data (otherEnd data edge vertex) = 2
    · rw [traverse_of_valency_eq data hVisited hValency]
      simp
    · rw [traverse_of_valency_ne data hVisited hValency]
      simp

theorem traverse_head?_eq_some (data : GluingDatum target degree)
    (visited : Finset data.SourceEdge) (edge : data.SourceEdge)
    (vertex : data.SourceVertex) (hVisited : edge ∉ visited) :
    (traverse data visited edge vertex).head? = some edge := by
  by_cases hValency : nonDanglingValency data (otherEnd data edge vertex) = 2
  · rw [traverse_of_valency_eq data hVisited hValency]
    simp
  · rw [traverse_of_valency_ne data hVisited hValency]
    simp

/-- The traversal never repeats an occurrence, and emits nothing already
visited. -/
theorem traverse_nodup_notMem (data : GluingDatum target degree)
    (visited : Finset data.SourceEdge) (edge : data.SourceEdge)
    (vertex : data.SourceVertex) :
    (traverse data visited edge vertex).Nodup ∧
      ∀ emitted ∈ traverse data visited edge vertex, emitted ∉ visited := by
  refine traverse_rec (motive := fun visited edge vertex ↦
    (traverse data visited edge vertex).Nodup ∧
      ∀ emitted ∈ traverse data visited edge vertex, emitted ∉ visited)
    ?_ ?_ ?_ visited edge vertex
  · intro visited edge vertex hVisited
    rw [traverse_of_mem data vertex hVisited]
    exact ⟨List.nodup_nil, by simp⟩
  · intro visited edge vertex hVisited hValency
    rw [traverse_of_valency_ne data hVisited hValency]
    refine ⟨List.nodup_singleton _, ?_⟩
    intro emitted hEmitted
    rw [List.mem_singleton] at hEmitted
    subst hEmitted
    exact hVisited
  · intro visited edge vertex hVisited hValency ih
    obtain ⟨ihNodup, ihNotMem⟩ := ih
    rw [traverse_of_valency_eq data hVisited hValency]
    refine ⟨List.nodup_cons.mpr ⟨fun hMem ↦ ?_, ihNodup⟩, ?_⟩
    · exact ihNotMem edge hMem (Finset.mem_insert_self _ _)
    · intro emitted hEmitted
      rcases List.mem_cons.mp hEmitted with hEq | hTail
      · subst hEq
        exact hVisited
      · exact fun hMem ↦ ihNotMem emitted hTail (Finset.mem_insert_of_mem hMem)

private theorem isChain_cons_of_head? {α : Type*} {R : α → α → Prop} {head : α}
    {tail : List α} (hHead : ∀ second ∈ tail.head?, R head second)
    (hChain : tail.IsChain R) : (head :: tail).IsChain R := by
  cases tail with
  | nil => exact List.IsChain.singleton head
  | cons second rest =>
    exact List.isChain_cons_cons.mpr ⟨hHead second (by simp), hChain⟩

/-- Consecutive entries of a traversal meet at a surviving valency-two
vertex. -/
theorem traverse_chain (data : GluingDatum target degree)
    (visited : Finset data.SourceEdge) (edge : data.SourceEdge)
    (vertex : data.SourceVertex) :
    (traverse data visited edge vertex).IsChain fun first second ↦
      ∃ meeting : data.SourceVertex, Incident data first meeting ∧
        Incident data second meeting ∧ nonDanglingValency data meeting = 2 := by
  refine traverse_rec (motive := fun visited edge vertex ↦
    (traverse data visited edge vertex).IsChain fun first second ↦
      ∃ meeting : data.SourceVertex, Incident data first meeting ∧
        Incident data second meeting ∧ nonDanglingValency data meeting = 2)
    ?_ ?_ ?_ visited edge vertex
  · intro visited edge vertex hVisited
    rw [traverse_of_mem data vertex hVisited]
    exact List.IsChain.nil
  · intro visited edge vertex hVisited hValency
    rw [traverse_of_valency_ne data hVisited hValency]
    exact List.IsChain.singleton _
  · intro visited edge vertex hVisited hValency ih
    rw [traverse_of_valency_eq data hVisited hValency]
    refine isChain_cons_of_head? ?_ ih
    intro second hSecond
    have hEq := traverse_head? data (insert edge visited)
      (stepEdge data hValency edge) (otherEnd data edge vertex) second hSecond
    subst hEq
    exact ⟨otherEnd data edge vertex, incident_otherEnd data edge vertex,
      stepEdge_incident data hValency edge, hValency⟩

/-- Every occurrence the traversal emits survives and lies on the stable path
of the occurrence it started from. -/
theorem traverse_stablePath (data : GluingDatum target degree)
    (visited : Finset data.SourceEdge) (edge : data.SourceEdge)
    (vertex : data.SourceVertex) (hEdge : ¬ IsDangling data edge)
    (emitted : data.SourceEdge)
    (hEmitted : emitted ∈ traverse data visited edge vertex) :
    ∃ hSurvives : ¬ IsDangling data emitted,
      NonDanglingEdge.stablePath (⟨emitted, hSurvives⟩ : NonDanglingEdge data) =
        NonDanglingEdge.stablePath (⟨edge, hEdge⟩ : NonDanglingEdge data) := by
  refine traverse_rec (motive := fun visited edge vertex ↦
    ∀ hEdge : ¬ IsDangling data edge, ∀ emitted : data.SourceEdge,
      emitted ∈ traverse data visited edge vertex →
      ∃ hSurvives : ¬ IsDangling data emitted,
        NonDanglingEdge.stablePath (⟨emitted, hSurvives⟩ : NonDanglingEdge data) =
          NonDanglingEdge.stablePath (⟨edge, hEdge⟩ : NonDanglingEdge data))
    ?_ ?_ ?_ visited edge vertex hEdge emitted hEmitted
  · intro visited edge vertex hVisited _ emitted hEmitted
    rw [traverse_of_mem data vertex hVisited] at hEmitted
    simp at hEmitted
  · intro visited edge vertex hVisited hValency hEdge emitted hEmitted
    rw [traverse_of_valency_ne data hVisited hValency, List.mem_singleton] at hEmitted
    subst hEmitted
    exact ⟨hEdge, rfl⟩
  · intro visited edge vertex hVisited hValency ih hEdge emitted hEmitted
    rw [traverse_of_valency_eq data hVisited hValency] at hEmitted
    have hStepSurvives : ¬ IsDangling data (stepEdge data hValency edge) :=
      stepEdge_not_dangling data hValency edge
    have hConsecutive : Consecutive data ⟨edge, hEdge⟩
        ⟨stepEdge data hValency edge, hStepSurvives⟩ := by
      refine ⟨fun hEq ↦ ?_, otherEnd data edge vertex,
        incident_otherEnd data edge vertex,
        stepEdge_incident data hValency edge, hValency⟩
      exact stepEdge_ne data hValency edge (congrArg Subtype.val hEq).symm
    rcases List.mem_cons.mp hEmitted with hEq | hTail
    · subst hEq
      exact ⟨hEdge, rfl⟩
    · obtain ⟨hSurvives, hPath⟩ := ih hStepSurvives emitted hTail
      exact ⟨hSurvives, hPath.trans (stablePath_eq_of_consecutive hConsecutive).symm⟩

/-- The traversal is closed under passage through surviving valency-two
vertices, except possibly at the end through which it was started. -/
theorem traverse_closed (data : GluingDatum target degree)
    (visited : Finset data.SourceEdge) (edge : data.SourceEdge)
    (vertex : data.SourceVertex) (hEdge : ¬ IsDangling data edge)
    (hIncident : Incident data edge vertex)
    {meeting : data.SourceVertex}
    (hValency : nonDanglingValency data meeting = 2)
    (emitted neighbour : data.SourceEdge)
    (hEmitted : emitted ∈ traverse data visited edge vertex)
    (hNeighbour : ¬ IsDangling data neighbour) (hNe : neighbour ≠ emitted)
    (hEmittedMeets : Incident data emitted meeting)
    (hNeighbourMeets : Incident data neighbour meeting) :
    neighbour ∈ traverse data visited edge vertex ∨ neighbour ∈ visited ∨
      (Incident data neighbour vertex ∧ nonDanglingValency data vertex = 2) := by
  refine traverse_rec (motive := fun visited edge vertex ↦
    ¬ IsDangling data edge → Incident data edge vertex →
    ∀ emitted neighbour : data.SourceEdge,
      emitted ∈ traverse data visited edge vertex →
      ¬ IsDangling data neighbour → neighbour ≠ emitted →
      Incident data emitted meeting → Incident data neighbour meeting →
      neighbour ∈ traverse data visited edge vertex ∨ neighbour ∈ visited ∨
        (Incident data neighbour vertex ∧ nonDanglingValency data vertex = 2))
    ?_ ?_ ?_ visited edge vertex hEdge hIncident emitted neighbour hEmitted
    hNeighbour hNe hEmittedMeets hNeighbourMeets
  · intro visited edge vertex hVisited _ _ emitted _ hEmitted
    rw [traverse_of_mem data vertex hVisited] at hEmitted
    simp at hEmitted
  · intro visited edge vertex hVisited hStop hEdge hIncident emitted neighbour
      hEmitted hNeighbour hNe hEmittedMeets hNeighbourMeets
    rw [traverse_of_valency_ne data hVisited hStop, List.mem_singleton] at hEmitted
    rw [hEmitted] at hEmittedMeets
    rcases eq_or_eq_otherEnd data hIncident hEmittedMeets with hMeeting | hMeeting
    · rw [hMeeting] at hNeighbourMeets hValency
      exact Or.inr (Or.inr ⟨hNeighbourMeets, hValency⟩)
    · exfalso
      apply hStop
      rw [← hMeeting]
      exact hValency
  · intro visited edge vertex hVisited hStep ih hEdge hIncident emitted neighbour
      hEmitted hNeighbour hNe hEmittedMeets hNeighbourMeets
    have hStepSurvives : ¬ IsDangling data (stepEdge data hStep edge) :=
      stepEdge_not_dangling data hStep edge
    have hStepIncident : Incident data (stepEdge data hStep edge)
        (otherEnd data edge vertex) := stepEdge_incident data hStep edge
    have hStepMem : stepEdge data hStep edge ∈
        edge :: traverse data (insert edge visited) (stepEdge data hStep edge)
          (otherEnd data edge vertex) ∨ stepEdge data hStep edge ∈ visited := by
      by_cases hMem : stepEdge data hStep edge ∈ insert edge visited
      · rcases Finset.mem_insert.mp hMem with hEq | hMemVisited
        · exact absurd hEq (stepEdge_ne data hStep edge)
        · exact Or.inr hMemVisited
      · exact Or.inl (List.mem_cons_of_mem _
          (mem_traverse_self data _ _ (otherEnd data edge vertex) hMem))
    rw [traverse_of_valency_eq data hVisited hStep] at hEmitted ⊢
    rcases List.mem_cons.mp hEmitted with hEq | hTail
    · rw [hEq] at hEmittedMeets hNe
      rcases eq_or_eq_otherEnd data hIncident hEmittedMeets with hMeeting | hMeeting
      · rw [hMeeting] at hNeighbourMeets hValency
        exact Or.inr (Or.inr ⟨hNeighbourMeets, hValency⟩)
      · rw [hMeeting] at hNeighbourMeets
        rcases eq_or_eq_stepEdge data hStep hEdge
          (incident_otherEnd data edge vertex) hNeighbour hNeighbourMeets with
          hCase | hCase
        · exact absurd hCase hNe
        · rw [hCase]
          rcases hStepMem with hMem | hMem
          · exact Or.inl hMem
          · exact Or.inr (Or.inl hMem)
    · rcases ih hStepSurvives hStepIncident emitted neighbour hTail hNeighbour hNe
        hEmittedMeets hNeighbourMeets with hCase | hCase | hCase
      · exact Or.inl (List.mem_cons_of_mem _ hCase)
      · rcases Finset.mem_insert.mp hCase with hMemEq | hMemVisited
        · rw [hMemEq]
          exact Or.inl (by simp)
        · exact Or.inr (Or.inl hMemVisited)
      · rcases eq_or_eq_stepEdge data hStep hEdge
          (incident_otherEnd data edge vertex) hNeighbour hCase.1 with hEq | hEq
        · rw [hEq]
          exact Or.inl (by simp)
        · rw [hEq]
          rcases hStepMem with hMem | hMem
          · exact Or.inl hMem
          · exact Or.inr (Or.inl hMem)

/-! ### Stable-path classes are traversed exactly -/

/-- Consecutiveness is symmetric. -/
theorem consecutive_symm {data : GluingDatum target degree}
    {first second : NonDanglingEdge data} (h : Consecutive data first second) :
    Consecutive data second first := by
  obtain ⟨hNe, meeting, hFirst, hSecond, hValency⟩ := h
  exact ⟨hNe.symm, meeting, hSecond, hFirst, hValency⟩

/-- A property closed under consecutiveness is constant on a stable path. -/
theorem eqvGen_iff_of_closed {data : GluingDatum target degree}
    {property : NonDanglingEdge data → Prop}
    (hClosed : ∀ first second : NonDanglingEdge data,
      Consecutive data first second → property first → property second)
    {first second : NonDanglingEdge data}
    (hEqv : Relation.EqvGen (Consecutive data) first second) :
    property first ↔ property second := by
  induction hEqv with
  | rel x y hxy => exact ⟨hClosed x y hxy, hClosed y x (consecutive_symm hxy)⟩
  | refl x => exact Iff.rfl
  | symm x y _ ih => exact ih.symm
  | trans x y z _ _ ihFirst ihSecond => exact ihFirst.trans ihSecond

/-- An end of a stable path: an incidence at a vertex through which the path
does not continue. -/
def IsPathEnd (data : GluingDatum target degree) (edge : data.SourceEdge)
    (vertex : data.SourceVertex) : Prop :=
  Incident data edge vertex ∧ nonDanglingValency data vertex ≠ 2

/-- No stable path is a cycle: every class contains a surviving occurrence with
an end through which the path does not continue.  This is exactly what minimal
valency three in the stable graph supplies; it is carried here as a hypothesis
rather than derived from the datum. -/
def HasPathEnds (data : GluingDatum target degree) : Prop :=
  ∀ edge : NonDanglingEdge data, ∃ first : NonDanglingEdge data,
    ∃ vertex : data.SourceVertex,
      first.stablePath = edge.stablePath ∧ IsPathEnd data first.1 vertex

/-- The traversal started at a path end emits every surviving occurrence of
that stable-path class. -/
theorem mem_traverse_of_stablePath_eq (data : GluingDatum target degree)
    {first : NonDanglingEdge data} {vertex : data.SourceVertex}
    (hEnd : IsPathEnd data first.1 vertex) (edge : NonDanglingEdge data)
    (hPath : edge.stablePath = first.stablePath) :
    edge.1 ∈ traverse data ∅ first.1 vertex := by
  have hClosed : ∀ a b : NonDanglingEdge data, Consecutive data a b →
      a.1 ∈ traverse data ∅ first.1 vertex →
      b.1 ∈ traverse data ∅ first.1 vertex := by
    intro a b hConsecutive hMem
    obtain ⟨hNe, meeting, hA, hB, hValency⟩ := hConsecutive
    rcases traverse_closed data ∅ first.1 vertex first.2 hEnd.1 hValency a.1 b.1
      hMem b.2 (fun hEq ↦ hNe (Subtype.ext hEq.symm)) hA hB with
      hCase | hCase | hCase
    · exact hCase
    · simp at hCase
    · exact absurd hCase.2 hEnd.2
  exact (eqvGen_iff_of_closed
    (property := fun candidate ↦ candidate.1 ∈ traverse data ∅ first.1 vertex)
    hClosed ((stablePath_eq_iff first edge).mp hPath.symm)).mp
    (mem_traverse_self data ∅ first.1 vertex (by simp))

/-! ### Traversal-ordered rows of the honest stable presentation -/

namespace StableLengthMatrixLabelling

variable {coordinate : Type*} [DecidableEq coordinate]
  {data : GluingDatum target degree}

/-- A surviving occurrence representing the stable-path class labelled by
`row`. -/
noncomputable def rowRepresentative
    (labelling : StableLengthMatrixLabelling data coordinate)
    (row : coordinate) : NonDanglingEdge data :=
  (Quot.exists_rep (labelling.row.symm row)).choose

omit [DecidableEq coordinate] in
theorem rowRepresentative_stablePath
    (labelling : StableLengthMatrixLabelling data coordinate)
    (row : coordinate) :
    (labelling.rowRepresentative row).stablePath = labelling.row.symm row :=
  (Quot.exists_rep (labelling.row.symm row)).choose_spec

/-- A chosen path end of the class labelled by `row`. -/
noncomputable def startEdge (hEnds : HasPathEnds data)
    (labelling : StableLengthMatrixLabelling data coordinate)
    (row : coordinate) : NonDanglingEdge data :=
  (hEnds (labelling.rowRepresentative row)).choose

/-- The vertex at which the traversal of `row` starts. -/
noncomputable def startVertex (hEnds : HasPathEnds data)
    (labelling : StableLengthMatrixLabelling data coordinate)
    (row : coordinate) : data.SourceVertex :=
  (hEnds (labelling.rowRepresentative row)).choose_spec.choose

omit [DecidableEq coordinate] in
theorem startEdge_stablePath (hEnds : HasPathEnds data)
    (labelling : StableLengthMatrixLabelling data coordinate)
    (row : coordinate) :
    (labelling.startEdge hEnds row).stablePath = labelling.row.symm row :=
  ((hEnds (labelling.rowRepresentative row)).choose_spec.choose_spec).1.trans
    (labelling.rowRepresentative_stablePath row)

omit [DecidableEq coordinate] in
theorem startEdge_isPathEnd (hEnds : HasPathEnds data)
    (labelling : StableLengthMatrixLabelling data coordinate)
    (row : coordinate) :
    IsPathEnd data (labelling.startEdge hEnds row).1
      (labelling.startVertex hEnds row) :=
  ((hEnds (labelling.rowRepresentative row)).choose_spec.choose_spec).2

/-- The row labelled `row`, listed in traversal order along its stable path
from a chosen end. -/
noncomputable def orderedPath (hEnds : HasPathEnds data)
    (labelling : StableLengthMatrixLabelling data coordinate)
    (row : coordinate) : List data.SourceEdge :=
  traverse data ∅ (labelling.startEdge hEnds row).1
    (labelling.startVertex hEnds row)

omit [DecidableEq coordinate] in
theorem mem_orderedPath_iff (hEnds : HasPathEnds data)
    (labelling : StableLengthMatrixLabelling data coordinate)
    (row : coordinate) (edge : data.SourceEdge) :
    edge ∈ labelling.orderedPath hEnds row ↔
      ∃ hSurvives : ¬ IsDangling data edge,
        labelling.row (NonDanglingEdge.stablePath
          (⟨edge, hSurvives⟩ : NonDanglingEdge data)) = row := by
  constructor
  · intro hMem
    obtain ⟨hSurvives, hPath⟩ := traverse_stablePath data ∅
      (labelling.startEdge hEnds row).1 (labelling.startVertex hEnds row)
      (labelling.startEdge hEnds row).2 edge hMem
    refine ⟨hSurvives, ?_⟩
    have hClass : NonDanglingEdge.stablePath (⟨edge, hSurvives⟩ : NonDanglingEdge data) =
        labelling.row.symm row :=
      hPath.trans (labelling.startEdge_stablePath hEnds row)
    rw [hClass]
    simp
  · rintro ⟨hSurvives, hRow⟩
    have hPath : NonDanglingEdge.stablePath (⟨edge, hSurvives⟩ : NonDanglingEdge data) =
        (labelling.startEdge hEnds row).stablePath := by
      rw [labelling.startEdge_stablePath hEnds row]
      exact (Equiv.eq_symm_apply labelling.row).mpr hRow
    exact mem_traverse_of_stablePath_eq data
      (labelling.startEdge_isPathEnd hEnds row) ⟨edge, hSurvives⟩ hPath

omit [DecidableEq coordinate] in
theorem orderedPath_nodup (hEnds : HasPathEnds data)
    (labelling : StableLengthMatrixLabelling data coordinate)
    (row : coordinate) : (labelling.orderedPath hEnds row).Nodup :=
  (traverse_nodup_notMem data ∅ (labelling.startEdge hEnds row).1
    (labelling.startVertex hEnds row)).1

theorem path_nodup (labelling : StableLengthMatrixLabelling data coordinate)
    (row : coordinate) : (labelling.path row).Nodup := by
  unfold StableLengthMatrixLabelling.path
  exact List.Nodup.filter _ (Finset.nodup_toList _)

/-- The traversal-ordered row is a reordering of the row of the honest stable
presentation: both list every surviving occurrence of the class once. -/
theorem orderedPath_perm_path (hEnds : HasPathEnds data)
    (labelling : StableLengthMatrixLabelling data coordinate)
    (row : coordinate) :
    (labelling.orderedPath hEnds row).Perm (labelling.path row) := by
  refine (List.perm_ext_iff_of_nodup (labelling.orderedPath_nodup hEnds row)
    (labelling.path_nodup row)).mpr ?_
  intro edge
  rw [labelling.mem_orderedPath_iff hEnds row edge, labelling.mem_path_iff row edge]

omit [DecidableEq coordinate] in
/-- Consecutive entries of a traversal-ordered row meet at a surviving
valency-two vertex.  This is the ordering field the refinement receipt needs
and which the filtered rows cannot provide. -/
theorem orderedPath_chain (hEnds : HasPathEnds data)
    (labelling : StableLengthMatrixLabelling data coordinate)
    (row : coordinate) :
    (labelling.orderedPath hEnds row).IsChain fun first second ↦
      ∃ vertex : data.SourceVertex, Incident data first vertex ∧
        Incident data second vertex ∧ nonDanglingValency data vertex = 2 :=
  traverse_chain data ∅ (labelling.startEdge hEnds row).1
    (labelling.startVertex hEnds row)

omit [DecidableEq coordinate] in
/-- A traversal-ordered row starts at the chosen path end. -/
theorem orderedPath_head? (hEnds : HasPathEnds data)
    (labelling : StableLengthMatrixLabelling data coordinate)
    (row : coordinate) :
    (labelling.orderedPath hEnds row).head? =
      some (labelling.startEdge hEnds row).1 :=
  traverse_head?_eq_some data ∅ (labelling.startEdge hEnds row).1
    (labelling.startVertex hEnds row) (by simp)

/-- Every weighted sum over a row is unchanged by the reordering; in
particular the length matrix is. -/
theorem sum_orderedPath_eq (hEnds : HasPathEnds data)
    (labelling : StableLengthMatrixLabelling data coordinate)
    (row : coordinate) (weight : data.SourceEdge → ℚ) :
    ((labelling.orderedPath hEnds row).map weight).sum =
      ((labelling.path row).map weight).sum :=
  ((labelling.orderedPath_perm_path hEnds row).map weight).sum_eq

/-- The honest stable-source presentation rebuilt on traversal-ordered rows. -/
noncomputable def orderedPresentation (hEnds : HasPathEnds data)
    (labelling : StableLengthMatrixLabelling data coordinate) :
    data.LengthMatrixPresentation coordinate where
  targetEdge := labelling.targetEdge
  path := labelling.orderedPath hEnds

omit [DecidableEq coordinate] in
theorem orderedPresentation_path (hEnds : HasPathEnds data)
    (labelling : StableLengthMatrixLabelling data coordinate)
    (row : coordinate) :
    (labelling.orderedPresentation hEnds).path row =
      labelling.orderedPath hEnds row := rfl

omit [DecidableEq coordinate] in
/-- Every row of the rebuilt presentation is a genuine walk through surviving
valency-two vertices. -/
theorem orderedPresentation_path_chain (hEnds : HasPathEnds data)
    (labelling : StableLengthMatrixLabelling data coordinate)
    (row : coordinate) :
    ((labelling.orderedPresentation hEnds).path row).IsChain fun first second ↦
      ∃ vertex : data.SourceVertex, Incident data first vertex ∧
        Incident data second vertex ∧ nonDanglingValency data vertex = 2 :=
  labelling.orderedPath_chain hEnds row

/-- Rebuilding the presentation on the ordered rows leaves the length matrix
untouched, so every consequence already drawn from it survives. -/
theorem matrix_orderedPresentation (hEnds : HasPathEnds data)
    (labelling : StableLengthMatrixLabelling data coordinate) :
    GluingDatum.LengthMatrixPresentation.matrix
        (labelling.orderedPresentation hEnds) =
      GluingDatum.LengthMatrixPresentation.matrix labelling.presentation := by
  funext sourceRow column
  exact ((labelling.orderedPath_perm_path hEnds sourceRow).map
    (fun edge ↦ GluingDatum.LengthMatrixPresentation.coefficient
      labelling.presentation edge column)).sum_eq

theorem det_matrix_orderedPresentation [Fintype coordinate]
    (hEnds : HasPathEnds data)
    (labelling : StableLengthMatrixLabelling data coordinate) :
    (GluingDatum.LengthMatrixPresentation.matrix
        (labelling.orderedPresentation hEnds)).det =
      (GluingDatum.LengthMatrixPresentation.matrix labelling.presentation).det := by
  rw [matrix_orderedPresentation]

end StableLengthMatrixLabelling

/-!
## What the traversal supplies, and what it assumes

`StableLengthMatrixLabelling.orderedPath_perm_path` and
`StableLengthMatrixLabelling.orderedPath_chain` together supply the first of
the three properties that `Decomposes` is silent about (listed at the end of
`DraismaVargas.LocalCases.PresentationDecomposition`): the rebuilt presentation
`StableLengthMatrixLabelling.orderedPresentation` has rows that are genuine
walks, `StableLengthMatrixLabelling.orderedPath_head?` names the end each row
starts from, and `StableLengthMatrixLabelling.matrix_orderedPresentation`
shows nothing already proved about the length matrix is lost by rebuilding.

Two things are deliberately not done here.

* `HasPathEnds` is carried as a **hypothesis**, not derived.  It says that no
  stable path is a cycle, i.e. that every class contains an occurrence with an
  end of surviving valency different from two.  That is what minimal valency
  three in the stable graph gives, and deriving it from the gluing datum
  belongs with the stable-graph local properties, not here.  Without it the
  traversal is still defined and still nodup, still a chain and still confined
  to its class, but it need not exhaust a class that is a cycle.
* Nothing here builds a `Utilities.RefinementPresentation`.  Matching an
  ordered row against a `Utilities.OrderedPathSplit` also needs the third of
  those properties — compatibility of the target occurrences under a row with
  the coordinate labelling the row — and the split chain itself.
-/

end DraismaVargas.LocalCases.W4StableSource
