import DraismaVargas.Infrastructure.SheetPartition

/-!
# The join of two sheet partitions

`SheetPartition.IsJoin left right wall` says that `wall`'s relation is the
equivalence relation generated by the two endpoint relations.  It is the exact
relation used in the limit gluing datum of Draisma--Vargas Part I
(`def-limit-gluing`), where the partition above the merged vertex is the finest
common coarsening of the two endpoint partitions.  But it is only a `Prop`: the file
`Infrastructure/SheetPartition.lean` deliberately chooses no algorithm for the
transitive closure and therefore constructs only five special cases
(`isJoin_left_of_refines`, `isJoin_right_of_refines`,
`isJoin_pairBlock_detachSheet`, `isJoin_discrete_discrete`,
`isJoin_indiscrete_left`/`isJoin_indiscrete_right`).

This file supplies the general construction, so that the wall operation can be
*applied* to an arbitrary pair of endpoint partitions.  The representative of a
sheet is the least element of its generated class, which is a canonical choice
and makes idempotence immediate:

* `join left right` is a `SheetPartition`, and `isJoin_join` says it is a join;
* `join_rel_iff` is the characterisation of its relation;
* `IsJoin.unique` records that a join is determined up to the choice of
  representatives — two sheet partitions with the same `Rel` need not be equal
  as structures, so uniqueness is stated at the level of `Rel`;
* `IsJoin.least` and `join_refines_iff` are the lattice properties: the join is
  the least common coarsening of the two endpoint partitions.

The last section adds the block arithmetic the wall operation is used through:
a refinement has smaller blocks (`blockCard_le_of_refines`), so every endpoint
block sits inside the join block on the same sheet.
-/

namespace DraismaVargas.Infrastructure

namespace SheetPartition

open Finset

variable {d : ℕ}

/-! ## The generated relation -/

/-- The relation generated by the two endpoint relations: this is the relation
`IsJoin` asks a wall partition to carry. -/
def JoinRel (left right : SheetPartition d) (i j : Fin d) : Prop :=
  Relation.EqvGen (fun a b ↦ left.Rel a b ∨ right.Rel a b) i j

theorem joinRel_equivalence (left right : SheetPartition d) :
    Equivalence (JoinRel left right) :=
  Relation.EqvGen.is_equivalence _

theorem joinRel_refl (left right : SheetPartition d) (i : Fin d) :
    JoinRel left right i i :=
  Relation.EqvGen.refl i

theorem JoinRel.symm {left right : SheetPartition d} {i j : Fin d}
    (h : JoinRel left right i j) : JoinRel left right j i :=
  Relation.EqvGen.symm i j h

theorem JoinRel.trans {left right : SheetPartition d} {i j k : Fin d}
    (hij : JoinRel left right i j) (hjk : JoinRel left right j k) :
    JoinRel left right i k :=
  Relation.EqvGen.trans i j k hij hjk

theorem joinRel_of_left {left right : SheetPartition d} {i j : Fin d}
    (h : left.Rel i j) : JoinRel left right i j :=
  Relation.EqvGen.rel i j (Or.inl h)

theorem joinRel_of_right {left right : SheetPartition d} {i j : Fin d}
    (h : right.Rel i j) : JoinRel left right i j :=
  Relation.EqvGen.rel i j (Or.inr h)

/-- A wall partition is a join exactly when its relation is `JoinRel`.  This is
`IsJoin` restated through the abbreviation; it holds by definition. -/
theorem isJoin_iff_joinRel (left right wall : SheetPartition d) :
    IsJoin left right wall ↔ ∀ i j, wall.Rel i j ↔ JoinRel left right i j :=
  Iff.rfl

/-- Any equivalence relation coarser than both endpoint relations is coarser
than the generated relation.  This is the induction that gives the join its
least-upper-bound property. -/
theorem rel_of_joinRel {left right coarse : SheetPartition d}
    (hLeft : left.Refines coarse) (hRight : right.Refines coarse)
    {i j : Fin d} (h : JoinRel left right i j) : coarse.Rel i j := by
  induction h with
  | rel x y hxy => exact hxy.elim hLeft.rel hRight.rel
  | refl => rfl
  | symm => apply Eq.symm; assumption
  | trans _ _ _ _ _ ihFirst ihSecond => exact ihFirst.trans ihSecond

/-! ## The construction -/

/-- The class of a sheet under the generated relation.  Decidability of the
generated relation is not constructive, so the filter is taken classically. -/
noncomputable def joinClass (left right : SheetPartition d) (i : Fin d) :
    Finset (Fin d) :=
  @Finset.filter _ (fun j ↦ JoinRel left right i j) (Classical.decPred _)
    Finset.univ

@[simp] theorem mem_joinClass (left right : SheetPartition d) (i j : Fin d) :
    j ∈ joinClass left right i ↔ JoinRel left right i j := by
  simp [joinClass]

theorem joinClass_nonempty (left right : SheetPartition d) (i : Fin d) :
    (joinClass left right i).Nonempty :=
  ⟨i, (mem_joinClass left right i i).mpr (joinRel_refl left right i)⟩

/-- Related sheets have the same class. -/
theorem joinClass_eq_of_joinRel {left right : SheetPartition d} {i j : Fin d}
    (h : JoinRel left right i j) :
    joinClass left right i = joinClass left right j := by
  ext k
  rw [mem_joinClass, mem_joinClass]
  exact ⟨fun hik ↦ h.symm.trans hik, fun hjk ↦ h.trans hjk⟩

private theorem min'_eq_of_finset_eq {first second : Finset (Fin d)}
    (hFirst : first.Nonempty) (hSecond : second.Nonempty)
    (h : first = second) : first.min' hFirst = second.min' hSecond := by
  cases h
  rfl

/-- The canonical representative of the join: the least sheet in the generated
class. -/
noncomputable def joinRepr (left right : SheetPartition d) (i : Fin d) : Fin d :=
  (joinClass left right i).min' (joinClass_nonempty left right i)

/-- The chosen representative is related to the sheet it represents. -/
theorem joinRel_joinRepr (left right : SheetPartition d) (i : Fin d) :
    JoinRel left right i (joinRepr left right i) :=
  (mem_joinClass left right i _).mp
    (Finset.min'_mem _ (joinClass_nonempty left right i))

theorem joinRepr_eq_of_joinRel {left right : SheetPartition d} {i j : Fin d}
    (h : JoinRel left right i j) :
    joinRepr left right i = joinRepr left right j :=
  min'_eq_of_finset_eq _ _ (joinClass_eq_of_joinRel h)

theorem joinRepr_idem (left right : SheetPartition d) (i : Fin d) :
    joinRepr left right (joinRepr left right i) = joinRepr left right i :=
  (joinRepr_eq_of_joinRel (joinRel_joinRepr left right i)).symm

/-- The join of two sheet partitions: the partition whose blocks are the
classes of the relation generated by the two endpoint relations. -/
noncomputable def join (left right : SheetPartition d) : SheetPartition d where
  repr := joinRepr left right
  repr_idem := joinRepr_idem left right

@[simp] theorem join_repr (left right : SheetPartition d) (i : Fin d) :
    (join left right).repr i = joinRepr left right i := rfl

/-- The characterisation of the join relation. -/
theorem join_rel_iff (left right : SheetPartition d) (i j : Fin d) :
    (join left right).Rel i j ↔ JoinRel left right i j := by
  constructor
  · intro hij
    have hi : JoinRel left right i (joinRepr left right i) :=
      joinRel_joinRepr left right i
    have hj : JoinRel left right j (joinRepr left right j) :=
      joinRel_joinRepr left right j
    rw [rel_iff, join_repr, join_repr] at hij
    rw [← hij] at hj
    exact hi.trans hj.symm
  · intro hij
    rw [rel_iff, join_repr, join_repr]
    exact joinRepr_eq_of_joinRel hij

/-- The general wall operation: `join` really is a join. -/
theorem isJoin_join (left right : SheetPartition d) :
    IsJoin left right (join left right) :=
  join_rel_iff left right

/-! ## Uniqueness and the lattice properties -/

/-- A join is unique as a relation.  Two sheet partitions with the same `Rel`
need not be equal as structures — they may choose different representatives —
so uniqueness is stated at the level of `Rel`. -/
theorem IsJoin.unique {left right wall wall' : SheetPartition d}
    (h : IsJoin left right wall) (h' : IsJoin left right wall') :
    ∀ i j, wall.Rel i j ↔ wall'.Rel i j :=
  fun i j ↦ (h i j).trans (h' i j).symm

/-- Every join has the same relation as the constructed one. -/
theorem IsJoin.rel_iff_join_rel {left right wall : SheetPartition d}
    (h : IsJoin left right wall) (i j : Fin d) :
    wall.Rel i j ↔ (join left right).Rel i j :=
  h.unique (isJoin_join left right) i j

/-- Being a join is equivalent to having the relation of the constructed
join. -/
theorem isJoin_iff_rel_iff_join_rel (left right wall : SheetPartition d) :
    IsJoin left right wall ↔ ∀ i j, wall.Rel i j ↔ (join left right).Rel i j :=
  ⟨fun h ↦ h.rel_iff_join_rel,
    fun h i j ↦ (h i j).trans (join_rel_iff left right i j)⟩

/-- A join sends every sheet into the same block as the canonical join
representative. -/
theorem IsJoin.rel_join_repr {left right wall : SheetPartition d}
    (h : IsJoin left right wall) (i : Fin d) :
    wall.Rel i ((join left right).repr i) :=
  (h.rel_iff_join_rel i ((join left right).repr i)).mpr
    ((join left right).rel_repr_right i)

/-- The representative form of `IsJoin.rel_join_repr`. -/
theorem eq_of_isJoin {left right wall : SheetPartition d}
    (h : IsJoin left right wall) (i : Fin d) :
    wall.repr i = wall.repr ((join left right).repr i) :=
  h.rel_join_repr i

/-- The join is the *least* common coarsening: any partition coarsening both
endpoints coarsens the join. -/
theorem IsJoin.least {left right wall coarse : SheetPartition d}
    (h : IsJoin left right wall) (hLeft : left.Refines coarse)
    (hRight : right.Refines coarse) : wall.Refines coarse := by
  intro i j hij
  exact rel_of_joinRel hLeft hRight ((h i j).mp hij)

/-- The universal property of the join. -/
theorem join_refines_iff (left right coarse : SheetPartition d) :
    (join left right).Refines coarse ↔
      left.Refines coarse ∧ right.Refines coarse := by
  constructor
  · intro h
    exact ⟨(isJoin_join left right).left_refines.trans h,
      (isJoin_join left right).right_refines.trans h⟩
  · rintro ⟨hLeft, hRight⟩
    exact (isJoin_join left right).least hLeft hRight

/-! ## Block arithmetic -/

theorem left_refines_join (left right : SheetPartition d) :
    left.Refines (join left right) :=
  (isJoin_join left right).left_refines

theorem right_refines_join (left right : SheetPartition d) :
    right.Refines (join left right) :=
  (isJoin_join left right).right_refines

/-- The join is symmetric as a relation. -/
theorem join_rel_comm (left right : SheetPartition d) (i j : Fin d) :
    (join left right).Rel i j ↔ (join right left).Rel i j :=
  ((isJoin_comm (isJoin_join right left)).rel_iff_join_rel i j).symm

/-- A refining partition has smaller blocks. -/
theorem block_subset_of_refines {fine coarse : SheetPartition d}
    (h : fine.Refines coarse) (i : Fin d) :
    fine.block i ⊆ coarse.block i := by
  intro j hj
  exact (coarse.mem_block_iff i j).mpr (h.rel ((fine.mem_block_iff i j).mp hj))

/-- Cardinality form of `block_subset_of_refines`. -/
theorem blockCard_le_of_refines {fine coarse : SheetPartition d}
    (h : fine.Refines coarse) (i : Fin d) :
    fine.blockCard i ≤ coarse.blockCard i :=
  Finset.card_le_card (block_subset_of_refines h i)

theorem blockCard_le_blockCard_join (left right : SheetPartition d)
    (i : Fin d) : left.blockCard i ≤ (join left right).blockCard i :=
  blockCard_le_of_refines (left_refines_join left right) i

theorem blockCard_le_blockCard_join_right (left right : SheetPartition d)
    (i : Fin d) : right.blockCard i ≤ (join left right).blockCard i :=
  blockCard_le_of_refines (right_refines_join left right) i

/-- Block cardinalities under an arbitrary join, not only the constructed
one. -/
theorem IsJoin.blockCard_le {left right wall : SheetPartition d}
    (h : IsJoin left right wall) (i : Fin d) :
    left.blockCard i ≤ wall.blockCard i ∧ right.blockCard i ≤ wall.blockCard i :=
  ⟨blockCard_le_of_refines h.left_refines i,
    blockCard_le_of_refines h.right_refines i⟩

end SheetPartition

end DraismaVargas.Infrastructure
